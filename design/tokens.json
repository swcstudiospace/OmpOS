{
  "$meta": {
    "version": "1.4.0",
    "source": "src/Autonogrammer.UI/wwwroot/styles/tokens.css",
    "mirror": "src/Autonogrammer.Native.Views/Themes/AutonogrammerTokens.axaml",
    "themes": ["light", "dark", "system"],
    "notes": "Light is default on :root. Dark on data-theme=dark. System follows prefers-color-scheme. Colour ramp colour.surface.* is background-role; text-role colours are colour.text.*, colour.accent.*, colour.status.* and colour.focus.*. Dark theme values are documented under colour.dark.* as reference; light-theme ratios are the contract surface for ux_tokens.py. Dark-theme ratios are verified by AccessibilityTests and CssContractTests."
  },
  "color": {
    "$type": "color",
    "surface": {
      "default": { "$type": "color", "$value": "#fafaf9", "$description": "Light page surface. CSS var --autonogrammer-surface." },
      "raised": { "$type": "color", "$value": "#ffffff", "$description": "Light raised surface. CSS var --autonogrammer-surface-raised." },
      "sunken": { "$type": "color", "$value": "#f0f0ee", "$description": "Light sunken surface. CSS var --autonogrammer-surface-sunken." },
      "hover": { "$type": "color", "$value": "#ebebe8", "$description": "Light hover background. CSS var --autonogrammer-hover." },
      "selected": { "$type": "color", "$value": "#e4e4e0", "$description": "Light selected background. CSS var --autonogrammer-selected." },
      "active": { "$type": "color", "$value": "#dcdcd7", "$description": "Light active background. CSS var --autonogrammer-surface-active." },
      "tint": { "$type": "color", "$value": "#f5f1ff", "$description": "Light purple tint background. CSS var --autonogrammer-tint." },
      "tint-strong": { "$type": "color", "$value": "#ebe4ff", "$description": "Light purple tint-strong background. CSS var --autonogrammer-tint-strong." },
      "tint-border": { "$type": "color", "$value": "#d6c9fb", "$description": "Light decorative tint edge. CSS var --autonogrammer-tint-border." },
      "diff-added": { "$type": "color", "$value": "#e2f4e7", "$description": "Light diff-added background. CSS var --autonogrammer-diff-added." },
      "diff-removed": { "$type": "color", "$value": "#fbe6e6", "$description": "Light diff-removed background. CSS var --autonogrammer-diff-removed." }
    },
    "text": {
      "default": { "$type": "color", "$value": "#1c1c1a", "$description": "Light primary text. CSS var --autonogrammer-text." },
      "secondary": { "$type": "color", "$value": "#55555a", "$description": "Light secondary text. CSS var --autonogrammer-text-secondary." }
    },
    "accent": {
      "default": { "$type": "color", "$value": "#6d28d9", "$description": "Light accent. CSS var --autonogrammer-accent." },
      "hover": { "$type": "color", "$value": "#5b21b6", "$description": "Light accent hover. CSS var --autonogrammer-accent-hover." },
      "on-primary": { "$type": "fill", "$value": "#ffffff", "$description": "Text on accent fill. CSS var --autonogrammer-accent-on. Fill text, not surface text; do not measure against surface." }
    },
    "status": {
      "success": { "$type": "color", "$value": "#166534", "$description": "Light success text. CSS var --autonogrammer-success." },
      "warning": { "$type": "color", "$value": "#92400e", "$description": "Light warning text. CSS var --autonogrammer-warning." },
      "error": { "$type": "color", "$value": "#b3261e", "$description": "Light error text. CSS var --autonogrammer-error." }
    },
    "focus": {
      "ring": { "$type": "color", "$value": "#5b21b6", "$description": "Light focus ring colour. CSS var --autonogrammer-focus. Non-text 3:1 requirement." }
    },
    "border": {
      "default": { "$type": "other", "$value": "#e0e0dc", "$description": "Light decorative hairline. CSS var --autonogrammer-border." },
      "strong": { "$type": "color", "$value": "#6f6f6b", "$description": "Light strong border. CSS var --autonogrammer-border-strong." }
    },
    "dark": {
      "surface": { "$type": "other", "$value": "#181818", "$description": "Dark page surface reference. CSS var --autonogrammer-surface in dark theme." },
      "raised": { "$type": "other", "$value": "#1f1f1f", "$description": "Dark raised surface reference." },
      "text": { "$type": "other", "$value": "#ececec", "$description": "Dark primary text reference." },
      "text-secondary": { "$type": "other", "$value": "#a3a3a3", "$description": "Dark secondary text reference." },
      "accent": { "$type": "other", "$value": "#a78bfa", "$description": "Dark accent reference." },
      "accent-hover": { "$type": "other", "$value": "#c4b5fd", "$description": "Dark accent hover reference." },
      "focus": { "$type": "other", "$value": "#c4b5fd", "$description": "Dark focus reference." },
      "success": { "$type": "other", "$value": "#4ade80", "$description": "Dark success reference." },
      "warning": { "$type": "other", "$value": "#fbbf24", "$description": "Dark warning reference." },
      "error": { "$type": "other", "$value": "#ff9a9a", "$description": "Dark error reference." },
      "border-strong": { "$type": "other", "$value": "#808080", "$description": "Dark strong border reference." }
    }
  },
  "space": {
    "$type": "dimension",
    "scale-2": { "$type": "dimension", "$value": "2px" },
    "scale-4": { "$type": "dimension", "$value": "4px" },
    "scale-6": { "$type": "dimension", "$value": "6px" },
    "scale-8": { "$type": "dimension", "$value": "8px" },
    "scale-12": { "$type": "dimension", "$value": "12px" },
    "scale-16": { "$type": "dimension", "$value": "16px" },
    "scale-24": { "$type": "dimension", "$value": "24px" }
  },
  "size": {
    "control": {
      "default": { "$type": "dimension", "$value": "32px", "$description": "Control height. CSS var --autonogrammer-control-height." },
      "small": { "$type": "dimension", "$value": "28px", "$description": "Small control height. CSS var --autonogrammer-control-height-small." }
    },
    "target": {
      "minimum": { "$type": "dimension", "$value": "24px", "$description": "WCAG 2.2 SC 2.5.8 minimum. CSS var --autonogrammer-target-min." }
    },
    "icon-button": {
      "default": { "$type": "dimension", "$value": "28px" },
      "small": { "$type": "dimension", "$value": "24px" }
    },
    "chip": {
      "height": { "$type": "dimension", "$value": "20px" }
    },
    "rail": {
      "width": { "$type": "dimension", "$value": "240px" },
      "width-wide": { "$type": "dimension", "$value": "280px" }
    },
    "thread": {
      "max": { "$type": "dimension", "$value": "760px" },
      "min": { "$type": "dimension", "$value": "400px" }
    },
    "composer": {
      "min": { "$type": "dimension", "$value": "72px" },
      "max": { "$type": "dimension", "$value": "220px" }
    },
    "content": {
      "max": { "$type": "dimension", "$value": "720px" }
    },
    "kanban": {
      "column": { "$type": "dimension", "$value": "280px" }
    },
    "titlebar": {
      "height": { "$type": "dimension", "$value": "40px" }
    },
    "footer": {
      "height": { "$type": "dimension", "$value": "28px" }
    }
  },
  "typography": {
    "size": {
      "small": { "$type": "dimension", "$value": "12px" },
      "label": { "$type": "dimension", "$value": "13px" },
      "body": { "$type": "dimension", "$value": "14px" },
      "heading": { "$type": "dimension", "$value": "16px" },
      "display-sm": { "$type": "dimension", "$value": "20px" },
      "display": { "$type": "dimension", "$value": "24px" }
    },
    "weight": {
      "regular": { "$type": "other", "$value": "400" },
      "medium": { "$type": "other", "$value": "500" },
      "semibold": { "$type": "other", "$value": "600" }
    }
  },
  "motion": {
    "duration-fast": { "$type": "other", "$value": "120ms", "$description": "CSS var --autonogrammer-duration-fast. Reduced to 0 under prefers-reduced-motion and data-motion=reduce." },
    "duration": { "$type": "other", "$value": "200ms", "$description": "CSS var --autonogrammer-duration. Drawer, transitions." }
  },
  "radius": {
    "small": { "$type": "dimension", "$value": "4px" },
    "medium": { "$type": "dimension", "$value": "6px" },
    "large": { "$type": "dimension", "$value": "8px" },
    "extra-large": { "$type": "dimension", "$value": "12px" },
    "pill": { "$type": "other", "$value": "999px" }
  },
  "breakpoint": {
    "base": { "$type": "dimension", "$value": "0px" },
    "sm": { "$type": "dimension", "$value": "560px" },
    "md": { "$type": "dimension", "$value": "840px" },
    "lg": { "$type": "dimension", "$value": "1200px" },
    "xl": { "$type": "dimension", "$value": "1440px" }
  }
}
