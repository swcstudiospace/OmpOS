        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PromptRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Run"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "413": {
            "description": "Payload Too Large",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "415": {
            "description": "Unsupported Media Type",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/sessions/{id}/runs/{runId}": {
      "get": {
        "tags": [
          "RunEndpoints"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "runId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Run"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/sessions/{id}/runs/{runId}/output": {
      "get": {
        "tags": [
          "RunEndpoints"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "runId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunOutput"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/sessions/{id}/runs/{runId}/cancel": {
      "post": {
        "tags": [
          "RunEndpoints"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "runId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Run"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateSessionRequest": {
        "type": "object",
        "properties": {
          "ownerId": {
            "type": [
              "null",
              "string"
            ],
            "description": "Gets a body owner identifier, which is refused with 400 when non-null."
          }
        },
        "description": "Request body for `POST /sessions`. The owner is never taken from the body; it is the caller's subject."
      },
      "Message": {
        "required": [
          "role",
          "content",
          "timestamp"
        ],
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "description": "Gets the message role (for example \"user\" or \"assistant\")."
          },
          "content": {
            "type": "string",
            "description": "Gets the message content."
          },
          "timestamp": {
            "type": "string",
            "description": "Gets the timestamp the message was recorded.",
            "format": "date-time"
          }
        },
        "description": "A single chat message inside a session."
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "PromptAcceptedResponse": {
        "required": [
          "sessionId",
          "status",
          "intentKind",
          "diagnosticCodes"
        ],
        "type": "object",
        "properties": {
          "sessionId": {
            "type": "string",
            "description": "Gets the session the prompt was accepted on."
          },
          "status": {
            "type": "string",
            "description": "Gets the acceptance status."
          },
          "intentKind": {
            "type": "string",
            "description": "Gets the parser intent-kind name assigned to the prompt (for example `Steer` or `Fallback`)."
          },
          "diagnosticCodes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Gets the parser diagnostic codes recorded with the prompt."
          }
        },
        "description": "Response body for an accepted `POST /sessions/{id}/prompts` (HTTP 202)."
      },
      "PromptRequest": {
        "type": "object",
        "properties": {
          "prompt": {
            "type": [
              "null",
              "string"
            ],
            "description": "Gets the prompt text. Required, non-empty, within the configured length limit."
          }
        },
        "description": "Request body for `POST /sessions/{id}/prompts`."
      },
      "Run": {
        "required": [
          "id",
          "sessionId",
          "status",
          "createdAt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Gets the run identifier."
          },
          "sessionId": {
            "type": "string",
            "description": "Gets the identifier of the session the run executes in."
          },
          "status": {
            "description": "Gets the run lifecycle state.",
            "$ref": "#/components/schemas/RunStatus"
          },
          "createdAt": {
            "type": "string",
            "description": "Gets the time the run was accepted.",
            "format": "date-time"
          },
          "completedAt": {
            "type": [
              "null",
              "string"
            ],
            "description": "Gets the time the run settled, or null while the run is queued or running.",
            "format": "date-time"
          }
        },
        "description": "One hosted run: a single prompt executed by the hosted harness inside a session. The run carries its status and no output; the output of a settled run is read as a RunOutput."
      },
      "RunFileChange": {
        "required": [
          "path",
          "newText"
        ],
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "Gets the path of the edited file, as the harness reported it."
          },
          "oldText": {
            "type": [
              "null",
              "string"
            ],
            "description": "Gets the file text before the edit, or null when the edit created the file."
          },
          "newText": {
            "type": "string",
            "description": "Gets the file text after the edit."
          }
        },
        "description": "One file edit a run's harness reported: the path with the text before and after the edit. This is the harness's own before and after text, not a unified diff or a git patch."
      },
      "RunOutput": {
        "required": [
          "runId",
          "status"
        ],
        "type": "object",
        "properties": {
          "runId": {
            "type": "string",
            "description": "Gets the run identifier."
          },
          "status": {
            "description": "Gets the run lifecycle state at the time of the read.",
            "$ref": "#/components/schemas/RunStatus"
          },
          "transcript": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "description": "Gets the run's transcript, or null while the run is queued or running.",
                "$ref": "#/components/schemas/RunTranscript"
              }
            ]
          },
          "changes": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "$ref": "#/components/schemas/RunFileChange"
            },
            "description": "Gets the file changes the harness reported, in the order it reported them, or null while the run is queued or running. Empty when the harness reported none."
          }
        },
        "description": "The output of a run. A queued or running run reports its status with no transcript and no changes. A settled run (completed, failed or cancelled) returns its transcript, and the file changes the harness reported while it ran. A harness that reports no file edit yields an empty change list, so the output is the transcript only."
      },
      "RunStatus": {
        "enum": [
          "Queued",
          "Running",
          "Completed",
          "Failed",
          "Cancelled"
        ],
        "description": "Lifecycle states of a hosted run. A run moves from Queued to Running and ends in exactly one of Completed, Failed or Cancelled."
      },
      "RunTranscript": {
        "required": [
          "messages",
          "events"
        ],
        "type": "object",
        "properties": {
          "messages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Message"
            },
            "description": "Gets the run's chat messages, starting with the user prompt."
          },
          "events": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StreamEvent"
            },
            "description": "Gets the run's stream events, starting with the prompt acceptance event."
          }
        },
        "description": "The part of a session's record that belongs to one run: the messages and the stream events of that run's turn, in the order they were recorded."
      },
      "Session": {
        "required": [
          "id",
          "ownerId",
          "createdAt",
          "updatedAt",
          "status",
          "messages",
          "events"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Gets the session identifier."
          },
          "ownerId": {
            "type": "string",
            "description": "Gets the owner identifier: the subject of the bearer token that created the session."
          },
          "createdAt": {
            "type": "string",
            "description": "Gets the creation timestamp.",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "description": "Gets the last-update timestamp.",
            "format": "date-time"
          },
          "status": {
            "description": "Gets the session lifecycle state.",
            "$ref": "#/components/schemas/SessionStatus"
          },
          "sandboxId": {
            "type": [
              "null",
              "string"
            ],
            "description": "Gets the sandbox identifier, or null when the session runs without a sandbox."
          },
          "messages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Message"
            },
            "description": "Gets the ordered chat messages."
          },
          "events": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StreamEvent"
            },
            "description": "Gets the append-only stream-event log."
          }
        },
        "description": "An agent session: ordered messages plus the append-only stream-event log."
      },
      "SessionStatus": {
        "enum": [
          "Idle",
          "Running",
          "AwaitingToolApproval",
          "Completed",
          "Failed",
          "Cancelled"
        ],
        "description": "Lifecycle states of an agent session."
      },
      "StreamEvent": {
        "required": [
          "seq",
          "sessionId",
          "correlationId",
          "timestamp",
          "payload"
        ],
        "type": "object",
        "properties": {
          "seq": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "Gets the monotonic sequence number.",
            "format": "int64"
          },
          "sessionId": {
            "type": "string",
            "description": "Gets the owning session identifier."
          },
          "correlationId": {
            "type": "string",
            "description": "Gets the end-to-end correlation identifier."
          },
          "timestamp": {
            "type": "string",
            "description": "Gets the event timestamp.",
            "format": "date-time"
          },
          "payload": {
            "description": "Gets the event payload.",
            "$ref": "#/components/schemas/StreamEventPayload"
          }
        },
        "description": "A single sequence-numbered event in a session's append-only log.\nThe SSE transport maps long StreamEvent.Seq to the `id:` field."
      },
      "StreamEventPayload": {
        "description": "Base record for every stream-event payload. Deserialization never throws on\nunknown or missing `kind` discriminators: they degrade to\nUnknownPayload with the raw payload preserved."
      }
    }
  },
  "tags": [
    {
      "name": "SessionEndpoints"
    },
    {
      "name": "ToolApprovalEndpoints"
    },
    {
      "name": "EventStreamEndpoints"
    },
    {
      "name": "RunEndpoints"
    }
  ]
}