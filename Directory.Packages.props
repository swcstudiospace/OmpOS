    <PackageVersion Include="Avalonia.Browser" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Headless" Version="12.1.4" />
  </ItemGroup>
  <ItemGroup Label="Libraries (consumed in later phases)">
    <PackageVersion Include="Markdig" Version="1.4.2" />
    <PackageVersion Include="DiffPlex" Version="1.9.0" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.13" />
    <PackageVersion Include="StackExchange.Redis" Version="3.4.5" />
    <PackageVersion Include="OpenTelemetry" Version="1.20.0" />
