@namespace Autonogrammer.UI.Components.Account
@using Autonogrammer.Contracts.Accounts
@using Autonogrammer.Presentation.Accounts
@using Autonogrammer.UI.Components.Shell
@implements IDisposable

<ViewTitle Text="@ViewTitles.Compose(AccountCopy.PanelName)" />
<main id="main" class="autonogrammer-connect">
    <div class="autonogrammer-connect-card">
        <h1 class="autonogrammer-connect-heading" tabindex="-1">@AccountCopy.PanelName</h1>
        @if (CallbackSentence is not null)
        {
            <p class="autonogrammer-auth-text" role="status">@CallbackSentence</p>
        }
        <form class="autonogrammer-connect-form" @onsubmit="SubmitAsync" @onkeyup="OnKey">
            <AccountState @ref="_state" Model="_model" />
        </form>
        @if (_model.ShowSignedOut && (_providers.Count > 0 || _walletAvailable))
        {
            <div class="autonogrammer-connect-alternatives" role="group" aria-label="@AccountCopy.OtherWaysHeading">
                <p class="autonogrammer-auth-text">@AccountCopy.OtherWaysHeading</p>
                @foreach (string provider in _providers)
                {
                    <button type="button" class="autonogrammer-btn" @onclick="() => StartProviderAsync(provider)">@AccountCopy.ProviderButtonLabel(provider)</button>
                }
                @if (_walletAvailable)
                {
                    <button type="button" class="autonogrammer-btn" @onclick="SignInWithWalletAsync">@AccountCopy.WalletButtonLabel</button>
                }
            </div>
        }
        @if (_notice is not null && _model.ShowSignedOut)
        {
            <p class="autonogrammer-auth-text" role="status">@_notice</p>
        }
    </div>
</main>

@code {
    private readonly CancellationTokenSource _lifetime = new();
    private AccountViewModel _model = null!;
    private AccountState? _state;
    private PeriodicTimer? _clock;
    private AuthPhase _drawn;
    private IReadOnlyList<string> _providers = [];
    private bool _walletAvailable;
    private string? _notice;
    private IProviderSignInHost? _providerHost;
    private IWalletSignInHost? _walletHost;

    /// <summary>Gets or sets the head that performs sign-in. The panel never sees a token.</summary>
    [Parameter]
    [EditorRequired]
    public IAccountHost Host { get; set; } = null!;

    /// <summary>Gets or sets the clock of the countdowns.</summary>
    [Parameter]
    public TimeProvider? Time { get; set; }

    /// <summary>Gets or sets the sentence the returning tab already decided, or null.</summary>
    [Parameter]
    public string? CallbackSentence { get; set; }

    /// <inheritdoc />
    protected override void OnInitialized()
    {
        _model = new AccountViewModel(Host, Time);
        _drawn = _model.Phase;
        _clock = new PeriodicTimer(TimeSpan.FromSeconds(1), Time ?? TimeProvider.System);
        _ = TickAsync();
        _providerHost = Host as IProviderSignInHost;
        _walletHost = Host as IWalletSignInHost;
        _ = LoadOptionsAsync();
    }

    /// <inheritdoc />
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_model.ShowAwaitingLink && _drawn != AuthPhase.AwaitingLink && _state is not null)
        {
            _drawn = _model.Phase;
            await _state.CodeField.FocusAsync().ConfigureAwait(true);
        }
        else if (_model.ShowError && _drawn != AuthPhase.Error)
        {
            _drawn = _model.Phase;
        }
        else
        {
            _drawn = _model.Phase;
        }
    }

    private async Task TickAsync()
    {
        if (_clock is null)
        {
            return;
        }

        try
        {
            while (await _clock.WaitForNextTickAsync(_lifetime.Token).ConfigureAwait(false))
            {
                _model.RefreshClock();
                await InvokeAsync(StateHasChanged).ConfigureAwait(false);
            }
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested)
        {
        }
    }

    private Task SubmitAsync() => _model.SubmitFromEnterAsync(_lifetime.Token);

    private async Task OnKey(KeyboardEventArgs args)
    {
        if (string.Equals(args.Key, "Escape", StringComparison.Ordinal))
        {
            await _model.CancelFromEscapeAsync(_lifetime.Token).ConfigureAwait(true);
        }
    }

    private async Task LoadOptionsAsync()
    {
        try
        {
            if (_providerHost is not null)
            {
                _providers = await _providerHost.GetEnabledProvidersAsync(_lifetime.Token).ConfigureAwait(false);
            }

            if (_walletHost is not null)
            {
                _walletAvailable = await _walletHost.WalletAvailableAsync(_lifetime.Token).ConfigureAwait(false);
            }

            await InvokeAsync(StateHasChanged).ConfigureAwait(false);
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested)
        {
        }
    }

    private async Task StartProviderAsync(string provider)
    {
        if (_providerHost is null)
        {
            return;
        }

        bool started = await _providerHost.StartProviderSignInAsync(provider, _lifetime.Token).ConfigureAwait(true);
        _notice = started ? AccountCopy.ProviderStartedSentence : AccountCopy.ProviderUnavailableSentence;
    }

    private async Task SignInWithWalletAsync()
    {
        if (_walletHost is null)
        {
            return;
        }

        WalletSignInOutcome outcome = await _walletHost.SignInWithWalletAsync(_lifetime.Token).ConfigureAwait(true);
        _notice = outcome switch
        {
            WalletSignInOutcome.SignedIn => null,
            WalletSignInOutcome.Declined => AccountCopy.WalletDeclinedSentence,
            WalletSignInOutcome.Unavailable => AccountCopy.WalletUnavailableSentence,
            _ => AccountCopy.WalletFailedSentence,
        };
    }

    /// <inheritdoc />
    public void Dispose()
    {
        _lifetime.Cancel();
        _lifetime.Dispose();
        _clock?.Dispose();
    }
}
