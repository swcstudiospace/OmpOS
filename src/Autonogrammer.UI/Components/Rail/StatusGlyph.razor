@namespace Autonogrammer.UI.Components.Rail
<svg class="autonogrammer-glyph" data-tone="@StatusGlyphs.ToneOf(IconKey)" data-icon="@IconKey" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="@StatusGlyphs.PathOf(IconKey)" /></svg>

@code {
    /// <summary>Gets the glyph key of <c>StatusIcon</c>. The glyph is decorative: the status words beside it carry the meaning.</summary>
    [Parameter]
    public string? IconKey { get; set; }
}
