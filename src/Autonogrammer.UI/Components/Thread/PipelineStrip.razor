@namespace Autonogrammer.UI.Components.Thread
@using Autonogrammer.Presentation.AgentPanel
@using Autonogrammer.UI.Components.Rail
@inherits ObservableComponent
<div class="autonogrammer-pipeline" data-open="@(_open ? "true" : "false")" @onkeydown="OnKeyDownAsync">
    <div class="autonogrammer-pipeline-bar">
        <button type="button"
                class="autonogrammer-pipeline-strip"
                aria-label="@Timeline.PipelineAccessibleName"
                aria-expanded="@(_open ? "true" : "false")"
                aria-controls="@_detailsId"
                @ref="_toggle"
                @onclick="ToggleAsync">
            <PluginConnectionRow Pills="Timeline.Pills" />
        </button>
        <p class="autonogrammer-pipeline-latest" role="status" aria-live="polite" aria-atomic="true">@LatestText</p>
    </div>
    @if (_open)
    {
        <div class="autonogrammer-pipeline-details" id="@_detailsId" role="region" aria-label="@AgentPanelViewText.PipelineDetailsName" tabindex="-1">
            @if (Session.RunSummaryText is { } summary)
            {
                <section class="autonogrammer-pipeline-summary">
                    <h3 class="autonogrammer-pipeline-heading">@AgentPanelViewText.RunSummaryHeading</h3>
                    <p>@summary</p>
                </section>
            }

            @foreach (var block in Timeline.Blocks)
            {
                <section class="autonogrammer-stage-block" data-source="@block.Source.ToString().ToLowerInvariant()">
                    <div class="autonogrammer-stage-block-head">
                        <h3 class="autonogrammer-pipeline-heading">@block.Name</h3>
                        @if (!string.IsNullOrEmpty(block.RollUpText))
                        {
                            <span class="autonogrammer-stage-rollup" data-tone="@StatusGlyphs.ToneOf(block.RollUpIconKey)"><StatusGlyph IconKey="@block.RollUpIconKey" />@block.RollUpText</span>
                        }
                    </div>
                    @if (!string.IsNullOrEmpty(block.EmptyText))
                    {
                        <p class="autonogrammer-stage-empty">@block.EmptyText</p>
                    }

                    @if (block.Rows.Count > 0)
                    {
                        <ul class="autonogrammer-stage-rows" aria-label="@block.Name stages">
                            @foreach (var row in block.Rows)
                            {
                                <li class="autonogrammer-stage-row" data-depth="@row.Depth" data-status="@row.Status.ToString().ToLowerInvariant()">
                                    <StatusGlyph IconKey="@row.IconKey" />
                                    <div class="autonogrammer-stage-main">
                                        <span class="autonogrammer-stage-title">@row.Title</span>
                                        @if (!string.IsNullOrEmpty(row.Detail))
                                        {
                                            @if (IsFix(row))
                                            {
                                                <code class="autonogrammer-stage-fix">@row.Detail</code>
                                            }
                                            else
                                            {
                                                <span class="autonogrammer-stage-detail">@row.Detail</span>
                                            }
                                        }

                                        @if (!string.IsNullOrEmpty(row.GraphId))
                                        {
                                            <code class="autonogrammer-stage-graph">@row.GraphId</code>
                                        }

                                        @if (!string.IsNullOrEmpty(row.EffectText))
                                        {
                                            <span class="autonogrammer-stage-effect">@row.EffectText</span>
                                        }

                                        @if (row.CanRetry)
                                        {
                                            <button type="button" class="autonogrammer-btn autonogrammer-btn--small" aria-label="@row.RetryName" @onclick="() => Timeline.RetryStageCommand(row.Source).Execute(null)">@AgentPanelCopy.RetryStage</button>
                                        }
                                    </div>
                                    <span class="autonogrammer-stage-status" data-tone="@StatusGlyphs.ToneOf(row.Status)">@row.StatusText</span>
                                </li>
                            }
                        </ul>
                    }
                </section>
            }

            <TaskContextPanel Context="Session.Context" />
        </div>
    }
</div>

@code {
    private const string FixMarker = "git submodule update";
    private static int s_nextId;

    private readonly string _detailsId = "autonogrammer-pipeline-details-" + System.Threading.Interlocked.Increment(ref s_nextId).ToString(System.Globalization.CultureInfo.InvariantCulture);
    private ElementReference _toggle;
    private bool _open;

    /// <summary>Gets the agent session whose pipeline the strip shows.</summary>
    [Parameter, EditorRequired]
    public AgentSessionViewModel Session { get; set; } = null!;

    /// <summary>Gets whether the details panel is open.</summary>
    public bool IsOpen => _open;

    private StageTimelineModel Timeline => Session.Timeline;

    private string LatestText => Timeline.StatusAnnouncement is { Length: > 0 } latest ? AgentPanelViewText.LatestLine(latest) : string.Empty;

    private static bool IsFix(StageRow row) => row.Detail?.Contains(FixMarker, StringComparison.Ordinal) == true;

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        Observe(Session);
        Observe(Session.Timeline);
        Observe(Session.Context);
    }

    private Task ToggleAsync()
    {
        _open = !_open;
        return Task.CompletedTask;
    }

    private async Task OnKeyDownAsync(KeyboardEventArgs args)
    {
        if (_open && string.Equals(args.Key, "Escape", StringComparison.Ordinal))
        {
            _open = false;
            await _toggle.FocusAsync().ConfigureAwait(true);
        }
    }
}
