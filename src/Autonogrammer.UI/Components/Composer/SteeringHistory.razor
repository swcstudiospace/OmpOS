@namespace Autonogrammer.UI.Components.Composing
@using Autonogrammer.Presentation.AgentPanel
@inherits ObservableComponent
<section class="autonogrammer-steering" aria-label="@AgentPanelViewText.SteeringEntriesName">
    @if (Steering.HeldText is { } held)
    {
        <p class="autonogrammer-steering-held" role="status">@held</p>
    }

    @if (Steering.History.Count == 0)
    {
        <p class="autonogrammer-steering-empty"><strong>@AgentPanelCopy.SteeringEmptyHeading</strong> @AgentPanelCopy.SteeringEmptyBody</p>
    }
    else
    {
        <ul class="autonogrammer-steering-list">
            @foreach (var entry in Steering.History)
            {
                <li class="autonogrammer-steering-entry" data-delivery="@entry.DeliveryStatus.ToString().ToLowerInvariant()" data-kind="@entry.Mode.ToString().ToLowerInvariant()">
                    <span class="autonogrammer-steering-header">@entry.HeaderText</span>
                    <span class="autonogrammer-steering-text">@entry.Text</span>
                    <span class="autonogrammer-steering-status" data-failed="@(entry.DeliveryStatus == SteeringDeliveryStatus.Failed ? "true" : null)">@entry.StatusLine</span>
                    @if (entry.DeliveryStatus == SteeringDeliveryStatus.Failed && entry.FailureReason is { Length: > 0 } reason)
                    {
                        <span class="autonogrammer-steering-reason">@reason</span>
                    }
                </li>
            }
        </ul>
    }
</section>

@code {
    /// <summary>Gets the steering model whose history is listed, newest first, with what each message's delivery reached.</summary>
    [Parameter, EditorRequired]
    public SteeringInputModel Steering { get; set; } = null!;

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        Observe(Steering);
        Observe(Steering.History);
        foreach (var entry in Steering.History)
        {
            Observe(entry);
        }
    }

    /// <inheritdoc />
    protected override bool ShouldRender()
    {
        // An entry's record status changes after it was added, so each entry is watched as soon as it is listed.
        foreach (var entry in Steering.History)
        {
            Observe(entry);
        }

        return true;
    }
}
