@namespace Autonogrammer.UI.Components.Settings
@inherits SettingsPageView<RuntimeValuesPage>
@using Autonogrammer.Presentation.Settings
<SettingsPageFrame Page="Page" Title="@SettingsCopy.RuntimeHeading" Description="@SettingsWebCopy.RuntimeDescription" Editable="false">
    @if (Page.State != SettingsPageState.Ready)
    {
        <SettingsStateView Loading="@(Page.State == SettingsPageState.Loading)" Error="@(Page.State == SettingsPageState.Error ? Page.LoadError : null)" OnRetry="Retry" />
    }
    else
    {
        <p class="autonogrammer-settings-banner" data-tone="info">@SettingsWebCopy.RuntimeReadOnly</p>
        @foreach (var group in Page.Groups)
        {
            <div class="autonogrammer-settings-fact" role="group" aria-label="@group.Heading">
                <h4 class="autonogrammer-settings-section-title">@group.Heading</h4>
                <ul class="autonogrammer-settings-list">
                    @foreach (var row in group.Rows)
                    {
                        <li class="autonogrammer-settings-list-row" @key="row.Label">
                            <div class="autonogrammer-settings-list-main">
                                <span class="autonogrammer-settings-label">@row.Label</span>
                                @if (!string.IsNullOrEmpty(row.Help))
                                {
                                    <span class="autonogrammer-settings-help">@row.Help</span>
                                }
                            </div>
                            <span class="autonogrammer-settings-mono autonogrammer-settings-value">@row.Value</span>
                        </li>
                    }
                </ul>
            </div>
        }
    }
</SettingsPageFrame>

@code {
    private Task Retry() => Page.LoadAsync(CancellationToken.None);
}
