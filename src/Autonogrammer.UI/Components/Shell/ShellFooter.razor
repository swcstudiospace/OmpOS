@namespace Autonogrammer.UI.Components.Shell
<footer class="autonogrammer-footer">
    <span class="autonogrammer-footer-version">Autonogrammer @Version</span>
    <a class="autonogrammer-footer-source" href="@ShellInfo.SourceRepositoryUrl">Source code</a>
    <a class="autonogrammer-footer-about" href="about">About</a>
    <span class="autonogrammer-footer-licence">Licensed under <a href="@ShellInfo.LicenceUrl">@ShellInfo.LicenceId</a></span>
</footer>

@code {
    /// <summary>Gets the version text; it defaults to the informational version of the running assembly.</summary>
    [Parameter]
    public string Version { get; set; } = ShellInfo.CurrentVersion;
}
