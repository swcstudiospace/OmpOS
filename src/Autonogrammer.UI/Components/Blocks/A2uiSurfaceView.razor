@namespace Autonogrammer.UI.Components.Blocks
@using Autonogrammer.Contracts.Ui
@using Autonogrammer.GenUi
@using Autonogrammer.Presentation.Blocks
<div class="autonogrammer-block autonogrammer-a2ui" data-surface="@Block.SurfaceId">
    @foreach (var item in A2uiBlockMapping.Map(Block))
    {
        @switch (item)
        {
            case A2uiHeadingItem heading:
                <h3 class="autonogrammer-a2ui-heading">@heading.Text</h3>
                break;
            case A2uiParagraphItem paragraph:
                <p class="autonogrammer-a2ui-text">@paragraph.Text</p>
                break;
            case A2uiImageItem image:
                <img class="autonogrammer-a2ui-image" src="@image.Url" alt="@A2uiSurfaceCatalog.ResolveImageAlt(image.Alt)" />
                break;
            case A2uiImageFallbackItem fallback:
                @if (fallback.Href is not null)
                {
                    <a class="autonogrammer-a2ui-image-link" href="@fallback.Href" rel="noopener noreferrer nofollow" target="_blank">@fallback.Text</a>
                }
                else
                {
                    <span class="autonogrammer-a2ui-image-link">@fallback.Text</span>
                }
                break;
            case A2uiButtonItem button:
                <button type="button" class="autonogrammer-btn">@button.Label</button>
                break;
            case A2uiListItem list:
                <ul class="autonogrammer-a2ui-list">
                    @foreach (var listItem in list.Items)
                    {
                        <li>@listItem</li>
                    }
                </ul>
                break;
            case A2uiUnsupportedItem unsupported:
                <details class="autonogrammer-unknown">
                    <summary>Unsupported content (@unsupported.Type)</summary>
                    <pre>@unsupported.Raw</pre>
                </details>
                break;
        }
    }
</div>

@code {
    /// <summary>Gets the A2UI surface block to render.</summary>
    [Parameter, EditorRequired]
    public A2uiSurfaceBlock Block { get; set; } = null!;
}
