@namespace OmpOS.UI.Components.Thread
@using OmpOS.Presentation.AgentPanel
@using OmpOS.UI.Components.Rail
<span class="ompos-pills">
    @foreach (var pill in Pills)
    {
        <span class="ompos-pill" data-source="@pill.Source.ToString().ToLowerInvariant()" data-tone="@StatusGlyphs.ToneOf(pill.IconKey)"><StatusGlyph IconKey="@pill.IconKey" /><span class="ompos-pill-text">@pill.Text</span>@(" ")</span>
    }
</span>

@code {
    /// <summary>Gets the pills of the pipeline, one per plugin source in pipeline order. Each pill is a glyph and the plugin's status in words.</summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<PipelinePill> Pills { get; set; } = [];
}
