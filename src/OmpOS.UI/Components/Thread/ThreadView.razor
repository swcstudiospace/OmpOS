@namespace OmpOS.UI.Components.Thread
@using OmpOS.Contracts.Ui
@using OmpOS.Presentation.AgentPanel
@using OmpOS.Presentation.Changes
@using OmpOS.Presentation.State
@using OmpOS.UI.Components.Approvals
@using OmpOS.UI.Components.Changes
@inherits ObservableComponent
<div class="ompos-thread" data-session="@Session.Id" data-state="@Transcript.State.ToString().ToLowerInvariant()">
    <ThreadHeader Session="Session" WorkspaceLabel="@WorkspaceLabel" Branch="@Branch" />
    <PipelineStrip Session="Session" />
    @if (_confirmStop)
    {
        <ConfirmBar Kind="stop"
                    AccessibleName="@AgentPanelViewText.ConfirmStopName"
                    Message="@AgentPanelCopy.StopConfirmation"
                    ConfirmLabel="@AgentPanelCopy.StopAgent"
                    CancelLabel="@AgentPanelCopy.KeepRunning"
                    OnConfirm="ConfirmStopAsync"
                    OnCancel="CancelStop" />
    }

    @if (_notice is { } notice)
    {
        <p class="ompos-thread-notice" role="status">@notice</p>
    }

    <SessionView Tree="Transcript.Tree"
                 ShowStop="false"
                 ViewState="Transcript.State"
                 AutoScrollPaused="Transcript.AutoScrollPaused"
                 Announcement="@Transcript.Announcement"
                 OnStop="RequestStopAsync"
                 OnRetry="RetryAsync"
                 OnJumpToLatest="JumpToLatest"
                 AutoScrollPausedChanged="OnAutoScrollPausedChanged" />
    @if (Session.RunSummaryText is { } summary)
    {
        <p class="ompos-run-summary" role="status"><strong>@AgentPanelCopy.AgentFinished</strong> @summary</p>
    }

    <ToolApprovalList Session="Session" Time="Time" />
    @if (Changes is not null)
    {
        <ChangesBar Model="Changes" />
    }

    @if (Session.IsClosed)
    {
        <div class="ompos-closed-note" role="status">
            <p><strong>@AgentPanelCopy.ClosedHeading</strong> @AgentPanelCopy.ClosedBody</p>
        </div>
    }
    else
    {
        <div class="ompos-composer-dock">
            <Composer @key="Session.Id" Model="Session.Composer" Steering="Session.Steering" IsStreaming="Transcript.CanStop" OnStop="RequestStopAsync" />
        </div>
    }
</div>

@code {
    private bool _confirmStop;
    private string? _notice;

    /// <summary>Gets the agent session the thread shows: its transcript, pipeline, approvals and composer.</summary>
    [Parameter, EditorRequired]
    public AgentSessionViewModel Session { get; set; } = null!;

    /// <summary>Gets the changes of the session, or null when the head cannot read the workspace. The Changes bar shows while it lists a file.</summary>
    [Parameter]
    public ChangeSetModel? Changes { get; set; }

    /// <summary>Gets the workspace label the header shows, or null.</summary>
    [Parameter]
    public string? WorkspaceLabel { get; set; }

    /// <summary>Gets the branch the header shows, or null when it is not known.</summary>
    [Parameter]
    public string? Branch { get; set; }

    /// <summary>Gets the clock the tool-approval timeout runs on.</summary>
    [Parameter]
    public TimeProvider Time { get; set; } = TimeProvider.System;

    /// <summary>Gets the callback that retries the failed operation. When it has no handler the thread sends the last user message again.</summary>
    [Parameter]
    public EventCallback OnRetry { get; set; }

    private SessionViewModel Transcript => Session.Session;

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        Observe(Session);
        Observe(Session.Session);
        Observe(Session.Steering);
        if (Changes is not null)
        {
            Observe(Changes);
        }
    }

    private Task RequestStopAsync()
    {
        _notice = null;
        if (Session.Steering.IsRunActive || Transcript.CanStop || Session.Composer.IsStreaming)
        {
            _confirmStop = true;
        }
        else
        {
            _notice = AgentPanelCopy.NothingToStop;
        }

        return Task.CompletedTask;
    }

    private void CancelStop() => _confirmStop = false;

    private async Task ConfirmStopAsync()
    {
        _confirmStop = false;
        await Session.Composer.StopAsync().ConfigureAwait(true);
    }

    private async Task RetryAsync()
    {
        if (OnRetry.HasDelegate)
        {
            await OnRetry.InvokeAsync().ConfigureAwait(true);
            return;
        }

        var last = Transcript.Tree.Blocks.OfType<UserMessageBlock>().LastOrDefault();
        if (last is null)
        {
            return;
        }

        // Resend the last user message through the composer; the draft the user is typing is put back afterwards.
        var kept = Session.Composer.Draft;
        Session.Composer.Draft = last.Text;
        try
        {
            await Session.Composer.SendAsync().ConfigureAwait(true);
        }
        finally
        {
            Session.Composer.Draft = kept;
        }
    }

    private void JumpToLatest() => Transcript.ResumeAutoScroll();

    private void OnAutoScrollPausedChanged(bool scrolledUp)
    {
        if (scrolledUp)
        {
            Transcript.PauseAutoScroll();
        }
        else
        {
            Transcript.ResumeAutoScroll();
        }
    }
}
