@namespace OmpOS.UI.Components.Approvals
@using OmpOS.Presentation.AgentPanel
@inherits ObservableComponent
@if (Session.PendingApprovals.Count > 0)
{
    <section class="ompos-approvals" aria-label="Pending tool approvals">
        @foreach (var approval in Session.PendingApprovals)
        {
            <ToolApprovalRow @key="approval.RequestId" Approval="approval" Coordinator="Session.ApprovalCoordinator" Time="Time" DecisionTimeout="DecisionTimeout" />
        }
    </section>
}

@code {
    /// <summary>Gets the agent session whose pending tool approvals are listed.</summary>
    [Parameter, EditorRequired]
    public AgentSessionViewModel Session { get; set; } = null!;

    /// <summary>Gets how long a decision may wait for the server before a row shows the timeout state.</summary>
    [Parameter]
    public TimeSpan DecisionTimeout { get; set; } = TimeSpan.FromSeconds(15);

    /// <summary>Gets the clock the decision timeout runs on.</summary>
    [Parameter]
    public TimeProvider Time { get; set; } = TimeProvider.System;

    /// <inheritdoc />
    protected override void OnParametersSet() => Observe(Session.PendingApprovals);
}
