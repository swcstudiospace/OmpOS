@namespace OmpOS.UI.Components.Approvals
@using OmpOS.Presentation.Approvals
@inherits ObservableComponent
<div class="ompos-approval" role="group" aria-label="@("Tool approval: " + Approval.ToolName)" data-status="@Approval.Status.ToString().ToLowerInvariant()">
    <p class="ompos-approval-tool"><span class="ompos-approval-label">Tool:</span> <code>@Approval.ToolName</code></p>
    @if (Approval.ArgumentsSummary.Length > 0)
    {
        <p class="ompos-approval-arguments"><span class="ompos-approval-label">Arguments:</span> <code>@Approval.ArgumentsSummary</code></p>
    }

    @if (Message.Length > 0)
    {
        <p class="ompos-approval-message" role="@(IsFault ? "alert" : "status")" data-fault="@(IsFault ? "true" : null)">@Message</p>
    }

    @if (CanDecide)
    {
        <div class="ompos-approval-actions">
            <button type="button" class="ompos-btn ompos-btn--small ompos-btn--primary" disabled="@_inFlight" aria-label="@("Allow once: " + Approval.ToolName)" @onclick="() => DecideAsync(ToolApprovalDecision.Allow)">Allow once</button>
            <button type="button" class="ompos-btn ompos-btn--small" disabled="@_inFlight" aria-label="@("Deny: " + Approval.ToolName)" @onclick="() => DecideAsync(ToolApprovalDecision.Deny)">Deny</button>
        </div>
        <p class="ompos-approval-hint">@PolicyHint</p>
    }
</div>

@code {
    /// <summary>The policy hint under the buttons: the choice goes to the server, and the server applies policy.</summary>
    public const string PolicyHint = "Your choice goes to the server, which applies policy. A tool that policy does not grant stays pending.";

    /// <summary>The message of a decision that got no answer in time.</summary>
    public const string TimedOutMessage = "The server did not answer in time. The request is still pending. Try again.";

    private bool _inFlight;
    private bool _timedOut;
    private string? _fault;

    /// <summary>Gets the pending request.</summary>
    [Parameter, EditorRequired]
    public PendingToolApproval Approval { get; set; } = null!;

    /// <summary>Gets the coordinator that sends the decision, or null when the session cannot decide approvals: the row is then a read-only notice.</summary>
    [Parameter]
    public ToolApprovalCoordinator? Coordinator { get; set; }

    /// <summary>Gets how long a decision may wait for the server before the row shows the timeout state and offers the buttons again.</summary>
    [Parameter]
    public TimeSpan DecisionTimeout { get; set; } = TimeSpan.FromSeconds(15);

    /// <summary>Gets the clock the decision timeout runs on.</summary>
    [Parameter]
    public TimeProvider Time { get; set; } = TimeProvider.System;

    private bool IsPendingLike => Approval.Status is ToolApprovalStatus.Pending or ToolApprovalStatus.Refused or ToolApprovalStatus.Failed;

    private bool CanDecide => Coordinator is not null && IsPendingLike;

    private bool IsFault => _fault is not null || _timedOut || Approval.Status is ToolApprovalStatus.Failed or ToolApprovalStatus.NotFound or ToolApprovalStatus.Refused;

    private string Message
    {
        get
        {
            if (_fault is not null)
            {
                return _fault;
            }

            if (_timedOut)
            {
                return TimedOutMessage;
            }

            if (_inFlight)
            {
                return "Sending the decision…";
            }

            if (Coordinator is null && IsPendingLike)
            {
                return "Approval needed. The decision is made by policy.";
            }

            return Approval.StatusMessage;
        }
    }

    /// <inheritdoc />
    protected override void OnParametersSet() => Observe(Approval);

    private async Task DecideAsync(ToolApprovalDecision decision)
    {
        if (Coordinator is null || _inFlight)
        {
            return;
        }

        _inFlight = true;
        _timedOut = false;
        _fault = null;
        using var timeout = new CancellationTokenSource(DecisionTimeout, Time);
        try
        {
            await Coordinator.DecideAsync(Approval, decision, timeout.Token).ConfigureAwait(true);
        }
        catch (OperationCanceledException) when (timeout.IsCancellationRequested)
        {
            _timedOut = true;
        }
        catch (Exception fault) when (fault is not OutOfMemoryException)
        {
            _fault = "The decision was not recorded. " + fault.Message;
        }
        finally
        {
            _inFlight = false;
        }
    }
}
