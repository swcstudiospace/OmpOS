@namespace OmpOS.UI.Components.Shell
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS
<CascadingValue Value="this" IsFixed="true">
    <div class="ompos-shell" data-drawer="@(_drawerOpen ? "open" : "closed")" @onkeydown="KeyHandler">
        <a class="ompos-skip-link" href="@SkipLinkHref">@SkipLinkText</a>
        <TopBar @ref="_topBar"
                WorkspaceLabel="@WorkspaceLabel"
                Tabs="TopBarTabs"
                DrawerOpen="_drawerOpen"
                OnDrawerToggle="ToggleDrawerAsync" />
        <div class="ompos-shell-body">
            <nav id="ompos-rail" class="ompos-rail" aria-label="Agents" tabindex="-1" @ref="_rail">
                <div class="ompos-rail-bar">
                    <span class="ompos-text-heading">Agents</span>
                    <button type="button" class="ompos-icon-btn" aria-label="Close agents panel" @onclick="CloseDrawerAsync"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6L6 18" /></svg></button>
                </div>
                @Rail
            </nav>
            @if (_drawerOpen)
            {
                <div class="ompos-scrim" aria-hidden="true" @onclick="CloseDrawerAsync"></div>
            }
            <main id="main" class="ompos-main" tabindex="-1" inert="@_drawerOpen">
                @ChildContent
            </main>
        </div>
        <ShellFooter Version="@(Version ?? ShellInfo.CurrentVersion)" />
    </div>
</CascadingValue>

@code {
    private const string ModulePath = "./_content/OmpOS.UI/scripts/ompos-shell.js";

    private TopBar? _topBar;
    private ElementReference _rail;
    private IJSObjectReference? _module;
    private DotNetObjectReference<AppShell>? _self;
    private bool _drawerOpen;
    private bool _trapPending;
    private bool _trapActive;
    private int _trapToken;

    /// <summary>Gets the content of the agent rail (the <c>nav</c> landmark named "Agents").</summary>
    [Parameter]
    public RenderFragment? Rail { get; set; }

    /// <summary>Gets the content of the <c>main</c> landmark.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>Gets the content the top bar shows between the workspace name and the controls, such as the view tabs. Nothing is shown when it is null.</summary>
    [Parameter]
    public RenderFragment? TopBarTabs { get; set; }

    /// <summary>Gets the version text of the footer; it defaults to the informational version of the running assembly.</summary>
    [Parameter]
    public string? Version { get; set; }

    /// <summary>Gets the workspace name the top bar shows.</summary>
    [Parameter]
    public string? WorkspaceLabel { get; set; }

    /// <summary>Gets the target of the skip link, which is the first control in the tab order.</summary>
    [Parameter]
    public string SkipLinkHref { get; set; } = "#main";

    /// <summary>Gets the text of the skip link.</summary>
    [Parameter]
    public string SkipLinkText { get; set; } = "Skip to main content";

    /// <summary>Gets whether the agent drawer (the rail below 840 px) is open.</summary>
    public bool IsDrawerOpen => _drawerOpen;

    // Only an open drawer listens for keys: a handler on the root would otherwise re-render the shell on every keystroke.
    private EventCallback<KeyboardEventArgs> KeyHandler => _drawerOpen ? EventCallback.Factory.Create<KeyboardEventArgs>(this, OnShellKeyDownAsync) : default;

    /// <summary>Closes the drawer and returns keyboard focus to the button that opened it; nothing happens when it is closed.</summary>
    /// <returns>A task that completes when the drawer is closed.</returns>
    public Task CloseDrawerAsync() => CloseCoreAsync(returnFocus: true);

    /// <summary>Called by ompos-shell.js when the window grows past the drawer breakpoint, where the rail is a fixed column again.</summary>
    /// <returns>A task that completes when the drawer is closed.</returns>
    [JSInvokable("CloseFromViewport")]
    public Task CloseFromViewportAsync() => InvokeAsync(() => CloseCoreAsync(returnFocus: false));

    /// <inheritdoc />
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_trapPending)
        {
            return;
        }

        _trapPending = false;
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", ModulePath).ConfigureAwait(true);
        _self ??= DotNetObjectReference.Create(this);
        _trapToken = await _module.InvokeAsync<int>("trapFocus", _rail, _self).ConfigureAwait(true);
        _trapActive = true;
    }

    private async Task ToggleDrawerAsync()
    {
        if (_drawerOpen)
        {
            await CloseCoreAsync(returnFocus: true).ConfigureAwait(true);
            return;
        }

        _drawerOpen = true;
        _trapPending = true;
    }

    private Task OnShellKeyDownAsync(KeyboardEventArgs args) =>
        string.Equals(args.Key, "Escape", StringComparison.Ordinal) ? CloseCoreAsync(returnFocus: true) : Task.CompletedTask;

    private async Task CloseCoreAsync(bool returnFocus)
    {
        if (!_drawerOpen)
        {
            return;
        }

        _drawerOpen = false;
        _trapPending = false;
        await ReleaseTrapAsync().ConfigureAwait(true);
        StateHasChanged();
        if (returnFocus && _topBar is not null)
        {
            await _topBar.FocusDrawerButtonAsync().ConfigureAwait(true);
        }
    }

    private async Task ReleaseTrapAsync()
    {
        if (!_trapActive || _module is null)
        {
            return;
        }

        _trapActive = false;
        try
        {
            await _module.InvokeVoidAsync("releaseFocus", _trapToken).ConfigureAwait(true);
        }
        catch (JSDisconnectedException)
        {
            // The circuit is gone, and the listeners went with it.
        }
    }

    /// <inheritdoc />
    public async ValueTask DisposeAsync()
    {
        try
        {
            await ReleaseTrapAsync().ConfigureAwait(true);
            if (_module is not null)
            {
                await _module.DisposeAsync().ConfigureAwait(true);
            }
        }
        catch (JSDisconnectedException)
        {
            // The circuit is gone, and the module went with it.
        }
        finally
        {
            _self?.Dispose();
        }
    }
}
