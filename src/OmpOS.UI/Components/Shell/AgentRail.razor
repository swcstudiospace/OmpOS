@namespace OmpOS.UI.Components.Shell
<div class="ompos-agent-rail">
    <div class="ompos-rail-header">
        <h2 class="ompos-rail-title">Agents</h2>
        <button type="button" class="ompos-btn ompos-btn--primary ompos-new-agent" aria-label="New conversation" @onclick="NewAsync"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M12 5v14M5 12h14" /></svg>New conversation</button>
    </div>
    <ConversationList Conversations="Conversations" SelectedId="@SelectedId" OnSelected="SelectAsync" />
</div>

@code {
    /// <summary>Gets the conversations to list, in display order.</summary>
    [Parameter]
    public IReadOnlyList<ConversationSummary> Conversations { get; set; } = [];

    /// <summary>Gets the selected conversation identifier, if any.</summary>
    [Parameter]
    public string? SelectedId { get; set; }

    /// <summary>Gets the callback invoked with the identifier of the conversation the user picked.</summary>
    [Parameter]
    public EventCallback<string> OnSelected { get; set; }

    /// <summary>Gets the callback invoked when the user asks for a new conversation.</summary>
    [Parameter]
    public EventCallback OnNew { get; set; }

    /// <summary>Gets the shell that hosts the rail, so a pick closes the drawer on a narrow screen.</summary>
    [CascadingParameter]
    public AppShell? Shell { get; set; }

    private async Task SelectAsync(string id)
    {
        await OnSelected.InvokeAsync(id).ConfigureAwait(true);
        await CloseDrawerAsync().ConfigureAwait(true);
    }

    private async Task NewAsync()
    {
        await OnNew.InvokeAsync().ConfigureAwait(true);
        await CloseDrawerAsync().ConfigureAwait(true);
    }

    private Task CloseDrawerAsync() => Shell is null ? Task.CompletedTask : Shell.CloseDrawerAsync();
}
