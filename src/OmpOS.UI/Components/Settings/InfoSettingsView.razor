@namespace OmpOS.UI.Components.Settings
@inherits SettingsPageView<InfoSettingsPage>
<SettingsPageFrame Page="Page" Title="@Page.Title" Description="@Page.Description" Editable="false">
    @if (Page.DesktopNotice is { } notice)
    {
        <p class="ompos-settings-banner" data-tone="info" data-desktop-only="true">
            <strong>@SettingsWebCopy.DesktopOnlyLabel</strong> @notice
        </p>
    }
    @for (var index = 0; index < Page.Facts.Count; index++)
    {
        var fact = Page.Facts[index];
        var headingId = "ompos-fact-" + Page.Section.ToString().ToLowerInvariant() + "-" + index;
        <div class="ompos-settings-fact" role="group" aria-labelledby="@headingId">
            <h4 class="ompos-settings-section-title" id="@headingId">@fact.Heading</h4>
            <p class="ompos-settings-help">@fact.Text</p>
        </div>
    }
</SettingsPageFrame>
