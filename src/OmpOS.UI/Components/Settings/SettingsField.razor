@namespace OmpOS.UI.Components.Settings
<div class="ompos-settings-row" data-invalid="@(!string.IsNullOrEmpty(Error) ? "true" : "false")">
    <div class="ompos-settings-row-text">
        @if (IsGroup)
        {
            <span class="ompos-settings-label" id="@LabelIdOf(For)">@Label</span>
        }
        else
        {
            <label class="ompos-settings-label" id="@LabelIdOf(For)" for="@For">@Label</label>
        }
        @if (!string.IsNullOrEmpty(Help))
        {
            <p class="ompos-settings-help" id="@HelpIdOf(For)">@Help</p>
        }
        <p class="ompos-settings-error" id="@ErrorIdOf(For)" aria-live="polite">@Error</p>
    </div>
    <div class="ompos-settings-row-control">@ChildContent</div>
</div>

@code {
    /// <summary>Gets the id of the control (or of the group of controls) the row labels.</summary>
    [Parameter, EditorRequired]
    public string For { get; set; } = string.Empty;

    /// <summary>Gets the visible label.</summary>
    [Parameter, EditorRequired]
    public string Label { get; set; } = string.Empty;

    /// <summary>Gets the help text under the label, or null.</summary>
    [Parameter]
    public string? Help { get; set; }

    /// <summary>Gets the inline error of the control, or null. The error line is always in the page, so a screen reader hears a new error.</summary>
    [Parameter]
    public string? Error { get; set; }

    /// <summary>Gets whether the row labels a group of controls (a span named by this row) instead of one control (a label bound to it).</summary>
    [Parameter]
    public bool IsGroup { get; set; }

    /// <summary>Gets the control or controls of the row.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>Returns the id of the label of a row.</summary>
    /// <param name="id">The id of the control the row labels.</param>
    /// <returns>The label id.</returns>
    public static string LabelIdOf(string id) => id + "-label";

    /// <summary>Returns the id of the help text of a row.</summary>
    /// <param name="id">The id of the control the row labels.</param>
    /// <returns>The help id.</returns>
    public static string HelpIdOf(string id) => id + "-help";

    /// <summary>Returns the id of the error line of a row.</summary>
    /// <param name="id">The id of the control the row labels.</param>
    /// <returns>The error id.</returns>
    public static string ErrorIdOf(string id) => id + "-error";

    /// <summary>Builds the <c>aria-describedby</c> value of the control of a row: its help text when it has one, then its error line.</summary>
    /// <param name="id">The id of the control the row labels.</param>
    /// <param name="hasHelp">Whether the row shows help text.</param>
    /// <returns>The space-separated ids.</returns>
    public static string DescribedBy(string id, bool hasHelp) => hasHelp ? HelpIdOf(id) + " " + ErrorIdOf(id) : ErrorIdOf(id);
}
