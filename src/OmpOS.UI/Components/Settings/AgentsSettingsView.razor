@namespace OmpOS.UI.Components.Settings
@inherits SettingsPageView<AgentsPage>
@using OmpOS.Presentation.Settings
<SettingsPageFrame Page="Page" Title="@SettingsCopy.AgentsHeading" Description="@SettingsCopy.AgentsDescription" Editable="@(Page.State == SettingsPageState.Ready)">
    @if (Page.State == SettingsPageState.Ready)
    {
        <SettingsField For="@AutoRunId" Label="@SettingsCopy.AutoRunLabel" Help="@SettingsCopy.AutoRunHelp">
            <button type="button" id="@AutoRunId" role="switch" class="ompos-toggle ompos-settings-toggle"
                    aria-checked="@(Page.TerminalAutoRun ? "true" : "false")"
                    aria-describedby="@SettingsField.DescribedBy(AutoRunId, true)"
                    @onclick="Toggle"></button>
        </SettingsField>
        if (Page.IsAutoRunWarningVisible)
        {
            <p class="ompos-settings-warning" role="status">@SettingsCopy.AutoRunWarning</p>
        }

        <p class="ompos-settings-help">@SettingsCopy.ApprovalPolicyNote</p>
    }
    else
    {
        <SettingsStateView Loading="@(Page.State == SettingsPageState.Loading)" Error="@(Page.State == SettingsPageState.Error ? Page.LoadError : null)" OnRetry="Retry" />
    }
</SettingsPageFrame>

@code {
    private const string AutoRunId = "ompos-setting-auto-run";

    private void Toggle() => Page.SetTerminalAutoRun(!Page.TerminalAutoRun);

    private Task Retry() => Page.LoadAsync(CancellationToken.None);
}
