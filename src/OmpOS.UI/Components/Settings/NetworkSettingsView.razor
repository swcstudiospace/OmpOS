@namespace OmpOS.UI.Components.Settings
@inherits SettingsPageView<NetworkSettingsPage>
@using OmpOS.Presentation.Settings
<SettingsPageFrame Page="Page" Title="@NetworkCopy.Heading" Description="@NetworkCopy.Description" Editable="false">
    @if (Page.State != SettingsPageState.Ready)
    {
        <SettingsStateView Loading="@(Page.State == SettingsPageState.Loading)" Error="@(Page.State == SettingsPageState.Error ? Page.LoadError : null)" OnRetry="Retry" />
    }
    else
    {
        <p class="ompos-settings-help">@NetworkCopy.Explanation</p>
        <div class="ompos-settings-actions">
            <button type="button" class="ompos-btn ompos-btn--primary" disabled="@(!Page.CanRun)" @onclick="RunAsync">@NetworkCopy.RunLabel</button>
            @if (Page.IsRunning)
            {
                <button type="button" class="ompos-btn" @onclick="Cancel">@NetworkCopy.CancelLabel</button>
            }
        </div>
        <p class="ompos-settings-help" role="status" aria-live="polite">@Page.Announcement</p>
        if (Page.IsNotRun)
        {
            <p class="ompos-settings-state">@NetworkCopy.NotRun</p>
        }

        if (Page.IsEmpty)
        {
            <p class="ompos-settings-state">@NetworkCopy.NoEndpoints</p>
        }

        if (Page.HasReport)
        {
            <p class="ompos-settings-help">@Page.CheckedAtText</p>
            <ul class="ompos-settings-list" aria-label="@NetworkCopy.Heading">
                @foreach (var row in Page.Rows)
                {
                    <li class="ompos-settings-list-row" @key="row.Name" aria-label="@row.Summary">
                        <div class="ompos-settings-list-main">
                            <span class="ompos-settings-label">@row.Name</span>
                            <span class="ompos-settings-mono">@row.Host</span>
                            <span class="ompos-settings-help">@row.Detail</span>
                        </div>
                        <span class="ompos-chip @ChipOf(row.Status)" data-status="@row.Status">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                                @if (row.Status == EndpointStatus.Reachable)
                                {
                                    <path d="m5 12 5 5 9-10" />
                                }
                                else
                                {
                                    <path d="M6 6l12 12M18 6 6 18" />
                                }
                            </svg>@row.StatusLabel
                        </span>
                    </li>
                }
            </ul>
        }
    }
</SettingsPageFrame>

@code {
    private static string ChipOf(EndpointStatus status) => status switch
    {
        EndpointStatus.Reachable => "ompos-chip--success",
        EndpointStatus.NotChecked => string.Empty,
        _ => "ompos-chip--error",
    };

    private Task Retry() => Page.LoadAsync(CancellationToken.None);

    private Task RunAsync() => Page.RunDiagnosticsAsync(CancellationToken.None);

    private void Cancel() => Page.CancelRun();
}
