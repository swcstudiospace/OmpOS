@namespace OmpOS.UI.Components.Settings
@inherits SettingsPageView<ISettingsPage>
@using OmpOS.Presentation.Settings
<SettingsPageFrame Page="Page" Title="@Page.Title" Description="@SettingsWebCopy.GenericUnavailable" Editable="false">
    <p class="ompos-settings-state" role="status" data-state="@StateText"><span class="ompos-settings-label">@SettingsWebCopy.GenericState</span> @StateText</p>
</SettingsPageFrame>

@code {
    private string StateText => Page switch
    {
        SettingsPageBase { State: SettingsPageState.Loading } => "Loading",
        SettingsPageBase { State: SettingsPageState.Error } failed => "Error: " + failed.LoadError,
        SettingsPageBase => "Ready",
        _ => Page.IsDirty ? "Unsaved changes" : "Ready",
    };
}
