@namespace OmpOS.UI.Components.Settings
@inherits SettingsPageView<CustomizeCatalogPage>
@using OmpOS.Presentation.Settings
@using OmpOS.Presentation.Settings.Customize
<SettingsPageFrame Page="Page" Title="@Page.Title" Description="@Page.IntroText" Editable="false">
    @switch (Page.State)
    {
        case CustomizePageState.Loading:
            <p class="ompos-settings-state" role="status" aria-busy="true">@CustomizeCopy.LoadingText</p>
            break;
        case CustomizePageState.Error:
            <div class="ompos-settings-state ompos-settings-state--error">
                <h4 class="ompos-settings-section-title">@CustomizeCopy.ErrorTitle</h4>
                <p role="alert">@(Page.LoadFailure ?? CustomizeCopy.LoadFailed)</p>
                <button type="button" class="ompos-btn" @onclick="Retry">@SettingsCopy.RetryLabel</button>
            </div>
            break;
        case CustomizePageState.Empty:
            <p class="ompos-settings-state">@Page.EmptyText</p>
            break;
        default:
            <p class="ompos-settings-help">@CustomizeCopy.ReadOnlyNotice @Page.CountText</p>
            <div class="ompos-settings-table-wrap" role="region" tabindex="0" aria-label="@Page.Title">
                <table class="ompos-settings-table">
                    <thead>
                        <tr>
                            <th scope="col">@CustomizeCopy.ColumnTitle</th>
                            <th scope="col">@CustomizeCopy.ColumnScope</th>
                            <th scope="col">@CustomizeCopy.ColumnOrigin</th>
                            <th scope="col">@CustomizeCopy.ColumnDescription</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var entry in Page.Entries)
                        {
                            <tr>
                                <th scope="row" class="ompos-settings-mono">@entry.Title</th>
                                <td><span class="ompos-chip">@entry.ScopeLabel</span></td>
                                <td class="ompos-settings-mono">@entry.Origin</td>
                                <td>@entry.Description</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            break;
    }
    @if (Page.Problems.Count > 0)
    {
        <h4 class="ompos-settings-section-title">@CustomizeCopy.ProblemsHeading</h4>
        <ul class="ompos-settings-problems">
            @foreach (var problem in Page.Problems)
            {
                <li class="ompos-settings-mono">@problem</li>
            }
        </ul>
    }
</SettingsPageFrame>

@code {
    private Task Retry() => Page.LoadAsync(CancellationToken.None);
}
