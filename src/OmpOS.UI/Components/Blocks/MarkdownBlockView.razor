@namespace OmpOS.UI.Components.Blocks
@using OmpOS.Contracts.Ui
@using OmpOS.Presentation.Services
<div class="ompos-block ompos-markdown">@((MarkupString)MarkdownRenderer.ToHtml(Block.Markdown))</div>

@code {
    /// <summary>Gets the markdown block to render as sanitized HTML.</summary>
    [Parameter, EditorRequired]
    public MarkdownBlock Block { get; set; } = null!;
}
