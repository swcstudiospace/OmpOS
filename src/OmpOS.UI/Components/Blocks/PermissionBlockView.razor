@namespace OmpOS.UI.Components.Blocks
@using OmpOS.Contracts.Ui
<div class="ompos-block ompos-permission">
    <p class="ompos-permission-prompt">@Block.Prompt</p>
    <ul class="ompos-permission-options">
        @foreach (var option in Block.Options)
        {
            <li class="ompos-permission-option">@option</li>
        }
    </ul>
    <p class="ompos-permission-note">The decision is made by policy.</p>
</div>

@code {
    /// <summary>Gets the permission block to render. Options render verbatim, in order, read-only: the decision is made by policy, not by the viewer.</summary>
    [Parameter, EditorRequired]
    public PermissionBlock Block { get; set; } = null!;
}
