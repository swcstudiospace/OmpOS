@namespace OmpOS.UI.Components.Blocks
@using OmpOS.Contracts.Ui
<div class="ompos-block ompos-permission" data-decision="@Block.Decision">
    <p class="ompos-permission-prompt">@Block.Prompt</p>
    <ul class="ompos-permission-options">
        @foreach (var option in Block.Options)
        {
            <li class="ompos-permission-option">@option</li>
        }
    </ul>
    @if (Block.Decision is not null)
    {
        <p class="ompos-permission-decision">Decision: @DecisionText</p>
    }
    <p class="ompos-permission-note">The decision is made by policy.</p>
</div>

@code {
    /// <summary>Gets the permission block to render. Options render verbatim, in order, read-only: the decision is made by policy, not by the viewer. A recorded decision shows as text.</summary>
    [Parameter, EditorRequired]
    public PermissionBlock Block { get; set; } = null!;

    /// <summary>The decision as shown: the two known values read as words, any other value is shown as it came.</summary>
    private string DecisionText => Block.Decision switch
    {
        ApprovalDecisions.Approved => "Approved",
        ApprovalDecisions.Denied => "Denied",
        var other => other ?? string.Empty,
    };
}
