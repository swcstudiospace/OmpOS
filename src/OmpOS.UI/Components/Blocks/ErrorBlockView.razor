@namespace OmpOS.UI.Components.Blocks
@using OmpOS.Contracts.Ui
<div class="ompos-block ompos-error" role="alert">
    <span class="ompos-error-message">@Block.Message</span>
    @if (Block.Retryable)
    {
        <button type="button" class="ompos-btn" aria-label="Retry failed operation" @onclick="() => OnRetry.InvokeAsync()">Retry</button>
    }
</div>

@code {
    /// <summary>Gets the error block to render.</summary>
    [Parameter, EditorRequired]
    public ErrorBlock Block { get; set; } = null!;

    /// <summary>Gets the callback invoked when the retry affordance is activated.</summary>
    [Parameter]
    public EventCallback OnRetry { get; set; }
}
