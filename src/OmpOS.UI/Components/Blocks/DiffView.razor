@namespace OmpOS.UI.Components.Blocks
@using OmpOS.Presentation.Editor
<div class="ompos-diff-view" data-mode="@Mode.ToString().ToLowerInvariant()">
    <div class="ompos-diff-toolbar">
        <span class="ompos-diff-summary">@SummaryText</span>
        @if (ShowModeSwitch)
        {
            <div class="ompos-segmented" role="group" aria-label="Diff layout">
                <button type="button" class="ompos-segment" aria-pressed="@(Mode == DiffViewMode.Unified ? "true" : "false")" @onclick="() => SetMode(DiffViewMode.Unified)">Unified</button>
                <button type="button" class="ompos-segment" aria-pressed="@(Mode == DiffViewMode.SideBySide ? "true" : "false")" @onclick="() => SetMode(DiffViewMode.SideBySide)">Side by side</button>
            </div>
        }
    </div>
    @if (Diff.Hunks.Count == 0)
    {
        <p class="ompos-diff-empty">No differences.</p>
    }
    else
    {
        <div class="ompos-diff-scroll" tabindex="0" role="group" aria-label="@("Diff of " + (Path ?? "the file"))">
            @foreach (var hunk in Hunks)
            {
                <table class="ompos-diff-table" data-mode="@Mode.ToString().ToLowerInvariant()">
                    <caption class="ompos-diff-hunk-header">@HunkHeader(hunk.Hunk)</caption>
                    <thead class="ompos-sr-only">
                        @if (Mode == DiffViewMode.Unified)
                        {
                            <tr><th scope="col">Old line</th><th scope="col">New line</th><th scope="col">Change</th><th scope="col">Text</th></tr>
                        }
                        else
                        {
                            <tr><th scope="col">Old line</th><th scope="col">Old text</th><th scope="col">New line</th><th scope="col">New text</th></tr>
                        }
                    </thead>
                    <tbody>
                        @if (Mode == DiffViewMode.Unified)
                        {
                            @foreach (var line in hunk.Lines)
                            {
                                <tr class="ompos-diff-line" data-kind="@KindName(line.Kind)">
                                    <td class="ompos-diff-num" aria-hidden="true">@Number(line.OldNumber)</td>
                                    <td class="ompos-diff-num" aria-hidden="true">@Number(line.NewNumber)</td>
                                    <td class="ompos-diff-sign" aria-hidden="true">@Sign(line.Kind)</td>
                                    <td class="ompos-diff-text"><span class="ompos-sr-only">@Word(line.Kind)</span><code>@line.Text</code></td>
                                </tr>
                            }
                        }
                        else
                        {
                            @foreach (var pair in hunk.Pairs)
                            {
                                <tr class="ompos-diff-line">
                                    <td class="ompos-diff-num" aria-hidden="true">@Number(pair.Left?.OldNumber)</td>
                                    <td class="ompos-diff-text" data-kind="@(pair.Left is null ? "empty" : KindName(pair.Left.Kind))"><span class="ompos-sr-only">@(pair.Left is null ? null : Word(pair.Left.Kind))</span><code>@pair.Left?.Text</code></td>
                                    <td class="ompos-diff-num" aria-hidden="true">@Number(pair.Right?.NewNumber)</td>
                                    <td class="ompos-diff-text" data-kind="@(pair.Right is null ? "empty" : KindName(pair.Right.Kind))"><span class="ompos-sr-only">@(pair.Right is null ? null : Word(pair.Right.Kind))</span><code>@pair.Right?.Text</code></td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            }
        </div>
        @if (_truncated)
        {
            <p class="ompos-diff-truncated" role="status">Large diff: only the first @MaxLines lines are shown.</p>
        }
    }
</div>

@code {
    /// <summary>The most diff lines the view draws; a larger diff is cut here and says so.</summary>
    public const int MaxLines = 2000;

    private IReadOnlyList<HunkView> _hunks = [];
    private bool _truncated;
    private UnifiedDiff? _built;

    /// <summary>Gets the diff to draw.</summary>
    [Parameter, EditorRequired]
    public UnifiedDiff Diff { get; set; } = null!;

    /// <summary>Gets the path of the file, for the accessible name of the diff.</summary>
    [Parameter]
    public string? Path { get; set; }

    /// <summary>Gets the layout.</summary>
    [Parameter]
    public DiffViewMode Mode { get; set; }

    /// <summary>Gets whether the layout switch is shown. The switch changes the layout of this view only.</summary>
    [Parameter]
    public bool ShowModeSwitch { get; set; } = true;

    private IReadOnlyList<HunkView> Hunks => _hunks;

    private string SummaryText
    {
        get
        {
            var added = 0;
            var removed = 0;
            foreach (var hunk in Diff.Hunks)
            {
                foreach (var line in hunk.Lines)
                {
                    if (line.Kind == DiffLineKind.Added)
                    {
                        added++;
                    }
                    else if (line.Kind == DiffLineKind.Removed)
                    {
                        removed++;
                    }
                }
            }

            return string.Create(System.Globalization.CultureInfo.InvariantCulture, $"+{added} -{removed}");
        }
    }

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        if (ReferenceEquals(_built, Diff))
        {
            return;
        }

        _built = Diff;
        var budget = MaxLines;
        var views = new List<HunkView>();
        _truncated = false;
        foreach (var hunk in Diff.Hunks)
        {
            if (budget <= 0)
            {
                _truncated = true;
                break;
            }

            var lines = Build(hunk, ref budget, ref _truncated);
            views.Add(new HunkView(hunk, lines, Pair(lines)));
        }

        _hunks = views;
    }

    private void SetMode(DiffViewMode mode) => Mode = mode;

    private static List<NumberedLine> Build(DiffHunk hunk, ref int budget, ref bool truncated)
    {
        var lines = new List<NumberedLine>();
        var oldNumber = hunk.OldStart;
        var newNumber = hunk.NewStart;
        foreach (var line in hunk.Lines)
        {
            if (budget <= 0)
            {
                truncated = true;
                break;
            }

            budget--;
            switch (line.Kind)
            {
                case DiffLineKind.Removed:
                    lines.Add(new NumberedLine(line.Kind, line.Text, oldNumber++, null));
                    break;
                case DiffLineKind.Added:
                    lines.Add(new NumberedLine(line.Kind, line.Text, null, newNumber++));
                    break;
                default:
                    lines.Add(new NumberedLine(line.Kind, line.Text, oldNumber++, newNumber++));
                    break;
            }
        }

        return lines;
    }

    // Side by side: a run of removed lines is paired, line by line, with the run of added lines that follows it; context lines stand on both sides.
    private static List<LinePair> Pair(List<NumberedLine> lines)
    {
        var pairs = new List<LinePair>();
        var index = 0;
        while (index < lines.Count)
        {
            if (lines[index].Kind == DiffLineKind.Context)
            {
                pairs.Add(new LinePair(lines[index], lines[index]));
                index++;
                continue;
            }

            var removed = new List<NumberedLine>();
            var added = new List<NumberedLine>();
            while (index < lines.Count && lines[index].Kind == DiffLineKind.Removed)
            {
                removed.Add(lines[index++]);
            }

            while (index < lines.Count && lines[index].Kind == DiffLineKind.Added)
            {
                added.Add(lines[index++]);
            }

            for (var row = 0; row < Math.Max(removed.Count, added.Count); row++)
            {
                pairs.Add(new LinePair(row < removed.Count ? removed[row] : null, row < added.Count ? added[row] : null));
            }
        }

        return pairs;
    }

    private static string HunkHeader(DiffHunk hunk) =>
        string.Create(System.Globalization.CultureInfo.InvariantCulture, $"@@ -{hunk.OldStart},{hunk.OldCount} +{hunk.NewStart},{hunk.NewCount} @@");

    private static string KindName(DiffLineKind kind) => kind switch
    {
        DiffLineKind.Added => "added",
        DiffLineKind.Removed => "removed",
        _ => "context",
    };

    private static string Sign(DiffLineKind kind) => kind switch
    {
        DiffLineKind.Added => "+",
        DiffLineKind.Removed => "-",
        _ => " ",
    };

    private static string Word(DiffLineKind kind) => kind switch
    {
        DiffLineKind.Added => "Added: ",
        DiffLineKind.Removed => "Removed: ",
        _ => string.Empty,
    };

    private static string? Number(int? number) => number?.ToString(System.Globalization.CultureInfo.InvariantCulture);

    private sealed record NumberedLine(DiffLineKind Kind, string Text, int? OldNumber, int? NewNumber);

    private sealed record LinePair(NumberedLine? Left, NumberedLine? Right);

    private sealed record HunkView(DiffHunk Hunk, IReadOnlyList<NumberedLine> Lines, IReadOnlyList<LinePair> Pairs);
}
