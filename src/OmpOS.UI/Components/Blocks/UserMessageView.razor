@namespace OmpOS.UI.Components.Blocks
@using OmpOS.GenUi
<div class="ompos-block ompos-user" data-role="user">
    <span class="ompos-user-text">@Block.Text</span>
</div>

@code {
    /// <summary>Gets the user turn to render verbatim as plain text, ahead of the assistant output.</summary>
    [Parameter, EditorRequired]
    public UserMessageBlock Block { get; set; } = null!;
}
