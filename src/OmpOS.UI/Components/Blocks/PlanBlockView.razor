@namespace OmpOS.UI.Components.Blocks
@using OmpOS.Contracts.Ui
<div class="ompos-block ompos-plan">
    <ol>
        @foreach (var step in Block.Steps)
        {
            <li>@step</li>
        }
    </ol>
</div>

@code {
    /// <summary>Gets the plan block to render.</summary>
    [Parameter, EditorRequired]
    public PlanBlock Block { get; set; } = null!;
}
