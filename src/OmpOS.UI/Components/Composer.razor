@namespace OmpOS.UI.Components
@using Microsoft.AspNetCore.Components.Web
<div class="ompos-composer">
    <textarea class="ompos-composer-input"
              aria-label="Message"
              placeholder="Type a message…"
              @bind="_viewModel.Draft"
              @bind:event="oninput"
              @onkeydown="HandleKeyDown"></textarea>
    @if (IsStreaming)
    {
        <button type="button" class="ompos-btn ompos-icon-btn" aria-label="Stop response" @onclick="() => OnStop.InvokeAsync()">■</button>
    }
    else
    {
        <button type="button" class="ompos-btn ompos-icon-btn" aria-label="Send message" @onclick="_viewModel.SendAsync"><svg width="1em" height="1em" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M3 3.5 21 12 3 20.5 7 12Z" /></svg></button>
    }
</div>

@code {
    private ComposerViewModel _viewModel = null!;

    /// <summary>Gets whether the assistant is currently streaming; Escape stops, and the stop control replaces send.</summary>
    [Parameter]
    public bool IsStreaming { get; set; }

    /// <summary>
    /// Gets the callback that submits the draft text. It resolves to true when the host accepted the send and
    /// to false when the host refused it; the draft is cleared only on true.
    /// </summary>
    [Parameter, EditorRequired]
    public Func<string, Task<bool>> OnSend { get; set; } = null!;

    /// <summary>Gets the callback invoked when the user stops the stream.</summary>
    [Parameter]
    public EventCallback OnStop { get; set; }

    /// <inheritdoc />
    protected override void OnInitialized()
    {
        _viewModel = new ComposerViewModel(text => OnSend(text), () => OnStop.InvokeAsync());
    }

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        _viewModel.IsStreaming = IsStreaming;
    }

    private Task HandleKeyDown(KeyboardEventArgs args) => _viewModel.HandleKeyAsync(args.Key, args.ShiftKey);
}
