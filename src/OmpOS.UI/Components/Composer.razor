@namespace OmpOS.UI.Components
@using Microsoft.AspNetCore.Components.Web
<div class="ompos-composer">
    <textarea class="ompos-composer-input"
              aria-label="Message"
              placeholder="Type a message…"
              @bind="_draft"
              @bind:event="oninput"
              @onkeydown="HandleKeyDown"></textarea>
    @if (IsStreaming)
    {
        <button type="button" class="ompos-btn ompos-icon-btn" aria-label="Stop response" @onclick="() => OnStop.InvokeAsync()">■</button>
    }
    else
    {
        <button type="button" class="ompos-btn ompos-icon-btn" aria-label="Send message" @onclick="Send">➤</button>
    }
</div>

@code {
    private string _draft = string.Empty;
    private bool _sending;

    /// <summary>Gets whether the assistant is currently streaming; Escape stops, and the stop control replaces send.</summary>
    [Parameter]
    public bool IsStreaming { get; set; }

    /// <summary>
    /// Gets the callback that submits the draft text. It resolves to true when the host accepted the send and
    /// to false when the host refused it; the draft is cleared only on true.
    /// </summary>
    [Parameter, EditorRequired]
    public Func<string, Task<bool>> OnSend { get; set; } = null!;

    /// <summary>Gets the callback invoked when the user stops the stream.</summary>
    [Parameter]
    public EventCallback OnStop { get; set; }

    private async Task Send()
    {
        // A send still in flight, or one made while a response streams, leaves the draft in place.
        if (_sending || IsStreaming || string.IsNullOrWhiteSpace(_draft))
        {
            return;
        }

        var text = _draft;
        _sending = true;
        try
        {
            var accepted = await OnSend(text);

            // Clear only the message the host accepted. Text typed while the send was pending is not the sent text, so it stays.
            if (accepted && string.Equals(_draft, text, StringComparison.Ordinal))
            {
                _draft = string.Empty;
            }
        }
        finally
        {
            _sending = false;
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs args)
    {
        if (string.Equals(args.Key, "Escape", StringComparison.Ordinal))
        {
            if (IsStreaming)
            {
                await OnStop.InvokeAsync();
            }
        }
        else if (string.Equals(args.Key, "Enter", StringComparison.Ordinal) && !args.ShiftKey)
        {
            await Send();
        }
    }
}
