<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Autonogrammer.Native.Views.Shell.SurfaceSwitchView"
             Focusable="False">
  <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Autonogrammer.Gap.Sm}">
    <Border Classes="segment-track">
      <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="{DynamicResource Autonogrammer.Gap.Xxs}">
        <ToggleButton x:Name="CodeToggle"
                      Grid.Column="0"
                      Classes="segment"
                      Content="Code"
                      IsChecked="True"
                      MinHeight="{DynamicResource Autonogrammer.Size.TargetMin}"
                      MinWidth="{DynamicResource Autonogrammer.Size.TargetMin}"
                      AutomationProperties.Name="Code, workspace"
                      Click="OnCodeClick" />
        <ToggleButton x:Name="CoworkToggle"
                      Grid.Column="1"
                      Classes="segment"
                      Content="Cowork"
                      MinHeight="{DynamicResource Autonogrammer.Size.TargetMin}"
                      MinWidth="{DynamicResource Autonogrammer.Size.TargetMin}"
                      AutomationProperties.Name="Cowork, workspace"
                      Click="OnCoworkClick" />
      </Grid>
    </Border>
    <TextBlock x:Name="HiddenSurfaceChip"
               Classes="settings-help"
               VerticalAlignment="Center"
               IsVisible="False"
               AutomationProperties.LiveSetting="Polite" />
  </StackPanel>
</UserControl>
