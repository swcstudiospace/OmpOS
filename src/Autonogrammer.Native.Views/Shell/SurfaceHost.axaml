<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Autonogrammer.Native.Views.Shell.SurfaceHost"
             x:Name="HostRoot"
             Focusable="False">
  <UserControl.Styles>
    <StyleInclude Source="avares://Autonogrammer.Native.Views/Views/Shell/SurfaceStyles.axaml" />
  </UserControl.Styles>
  <Grid>
    <ContentControl x:Name="CodeHost" />
    <ContentControl x:Name="CoworkHost" IsVisible="False" />
  </Grid>
</UserControl>
