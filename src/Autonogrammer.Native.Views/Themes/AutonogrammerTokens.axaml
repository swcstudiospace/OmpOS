      <BoxShadows x:Key="Autonogrammer.Shadow.Popup">0 8 24 0 #99000000</BoxShadows>
      <BoxShadows x:Key="Autonogrammer.Shadow.Card">0 0 0 0 #00000000</BoxShadows>

      <!-- Fluent resource aliases (spec 3.2). Avalonia's Fluent templates read these keys; pointing them at the Autonogrammer roles restyles
           every stock control through its own template states instead of fighting the template with presenter selectors.
           StaticResource aliases are not Autonogrammer.Color.* keys, so the contrast tests do not scan them. -->
      <!-- Button -->
      <StaticResource x:Key="ButtonBackground" ResourceKey="Autonogrammer.Color.SurfaceRaised" />
