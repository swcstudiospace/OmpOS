      <StaticResource x:Key="ComboBoxBorderBrushPointerOver" ResourceKey="Autonogrammer.Color.TextSecondary" />
      <StaticResource x:Key="ComboBoxBorderBrushPressed" ResourceKey="Autonogrammer.Color.TextSecondary" />
      <StaticResource x:Key="ComboBoxDropDownBackground" ResourceKey="Autonogrammer.Color.SurfaceRaised" />
      <StaticResource x:Key="ComboBoxDropDownBorderBrush" ResourceKey="Autonogrammer.Color.Border" />
      <StaticResource x:Key="ComboBoxDropDownGlyphForeground" ResourceKey="Autonogrammer.Color.TextSecondary" />
