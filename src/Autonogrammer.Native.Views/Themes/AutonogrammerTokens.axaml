      <StaticResource x:Key="TabItemHeaderBackgroundSelected" ResourceKey="Autonogrammer.Brush.Transparent" />
      <StaticResource x:Key="TabItemHeaderBackgroundSelectedPointerOver" ResourceKey="Autonogrammer.Brush.Transparent" />
      <StaticResource x:Key="TabItemHeaderBackgroundSelectedPressed" ResourceKey="Autonogrammer.Brush.Transparent" />
      <StaticResource x:Key="TabItemHeaderBackgroundUnselected" ResourceKey="Autonogrammer.Brush.Transparent" />
