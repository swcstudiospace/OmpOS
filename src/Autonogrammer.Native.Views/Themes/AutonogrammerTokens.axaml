      <StaticResource x:Key="TextControlButtonForeground" ResourceKey="Autonogrammer.Color.TextSecondary" />
      <StaticResource x:Key="TextControlButtonForegroundPointerOver" ResourceKey="Autonogrammer.Color.TextPrimary" />
