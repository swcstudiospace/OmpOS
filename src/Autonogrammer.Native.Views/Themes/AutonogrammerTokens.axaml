      <StaticResource x:Key="ComboBoxForeground" ResourceKey="Autonogrammer.Color.TextPrimary" />
      <StaticResource x:Key="ComboBoxForegroundDisabled" ResourceKey="Autonogrammer.Color.TextSecondary" />
      <StaticResource x:Key="ComboBoxForegroundFocused" ResourceKey="Autonogrammer.Color.TextPrimary" />
      <StaticResource x:Key="ComboBoxForegroundFocusedPressed" ResourceKey="Autonogrammer.Color.TextPrimary" />
      <StaticResource x:Key="ComboBoxPlaceHolderForeground" ResourceKey="Autonogrammer.Color.TextSecondary" />
      <StaticResource x:Key="ComboBoxPlaceHolderForegroundFocusedPressed" ResourceKey="Autonogrammer.Color.TextSecondary" />
      <!-- ComboBoxItem -->
      <StaticResource x:Key="ComboBoxItemBackground" ResourceKey="Autonogrammer.Brush.Transparent" />
      <StaticResource x:Key="ComboBoxItemBackgroundDisabled" ResourceKey="Autonogrammer.Brush.Transparent" />
      <StaticResource x:Key="ComboBoxItemBackgroundPointerOver" ResourceKey="Autonogrammer.Color.Hover" />
      <StaticResource x:Key="ComboBoxItemBackgroundPressed" ResourceKey="Autonogrammer.Color.SurfaceActive" />
      <StaticResource x:Key="ComboBoxItemBackgroundSelected" ResourceKey="Autonogrammer.Color.Selected" />
      <StaticResource x:Key="ComboBoxItemBackgroundSelectedDisabled" ResourceKey="Autonogrammer.Color.Selected" />
      <StaticResource x:Key="ComboBoxItemBackgroundSelectedPointerOver" ResourceKey="Autonogrammer.Color.Selected" />
      <StaticResource x:Key="ComboBoxItemBackgroundSelectedPressed" ResourceKey="Autonogrammer.Color.SurfaceActive" />
      <StaticResource x:Key="ComboBoxItemBorderBrushDisabled" ResourceKey="Autonogrammer.Brush.Transparent" />
      <StaticResource x:Key="ComboBoxItemBorderBrushPointerOver" ResourceKey="Autonogrammer.Brush.Transparent" />
      <StaticResource x:Key="ComboBoxItemBorderBrushPressed" ResourceKey="Autonogrammer.Brush.Transparent" />
      <StaticResource x:Key="ComboBoxItemBorderBrushSelected" ResourceKey="Autonogrammer.Brush.Transparent" />
      <StaticResource x:Key="ComboBoxItemBorderBrushSelectedDisabled" ResourceKey="Autonogrammer.Brush.Transparent" />
      <StaticResource x:Key="ComboBoxItemBorderBrushSelectedPointerOver" ResourceKey="Autonogrammer.Brush.Transparent" />
      <StaticResource x:Key="ComboBoxItemBorderBrushSelectedPressed" ResourceKey="Autonogrammer.Brush.Transparent" />
      <StaticResource x:Key="ComboBoxItemForeground" ResourceKey="Autonogrammer.Color.TextPrimary" />
      <StaticResource x:Key="ComboBoxItemForegroundDisabled" ResourceKey="Autonogrammer.Color.TextSecondary" />
