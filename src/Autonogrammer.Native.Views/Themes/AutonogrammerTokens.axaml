      <StaticResource x:Key="SystemControlHighlightListAccentHighBrush" ResourceKey="Autonogrammer.Color.SurfaceActive" />
      <StaticResource x:Key="SystemControlHighlightAltBaseHighBrush" ResourceKey="Autonogrammer.Color.TextPrimary" />
      <StaticResource x:Key="SystemControlDisabledBaseMediumLowBrush" ResourceKey="Autonogrammer.Color.TextSecondary" />
      <StaticResource x:Key="SystemControlErrorTextForegroundBrush" ResourceKey="Autonogrammer.Color.StatusError" />
      <!-- Metrics -->
      <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>
      <CornerRadius x:Key="OverlayCornerRadius">10</CornerRadius>
      <Thickness x:Key="ButtonPadding">11,0</Thickness>
      <x:Double x:Key="ControlContentThemeFontSize">13</x:Double>
      <x:Double x:Key="TextControlThemeMinHeight">32</x:Double>
      <Thickness x:Key="TextControlThemePadding">9,0</Thickness>
      <Thickness x:Key="TextControlBorderThemeThickness">1</Thickness>
      <Thickness x:Key="TextControlBorderThemeThicknessFocused">2</Thickness>
      <x:Double x:Key="ComboBoxMinHeight">32</x:Double>
      <Thickness x:Key="ComboBoxPadding">9,0,0,0</Thickness>
      <Thickness x:Key="ComboBoxItemThemePadding">8,0</Thickness>
      <x:Double x:Key="TabItemHeaderFontSize">13</x:Double>
      <FontWeight x:Key="TabItemHeaderThemeFontWeight">Medium</FontWeight>
      <Thickness x:Key="TabItemHeaderMargin">12,0</Thickness>
      <x:Double x:Key="TabStripItemMinHeight">28</x:Double>
      <x:Double x:Key="TabStripItemPipeThickness">2</x:Double>
      <x:Double x:Key="ScrollBarSize">10</x:Double>
      <x:Double x:Key="ToolTipContentThemeFontSize">12</x:Double>
      <x:Double x:Key="ToolTipContentMaxWidth">360</x:Double>
      <Thickness x:Key="ToolTipBorderThemePadding">8,4</Thickness>
      <Thickness x:Key="FlyoutBorderThemePadding">12</Thickness>
      <Thickness x:Key="FlyoutContentThemePadding">0</Thickness>
      <Thickness x:Key="MenuFlyoutItemThemePaddingNarrow">8,4</Thickness>
      <Thickness x:Key="ListBoxItemPadding">8,4</Thickness>
      <x:Double x:Key="CheckBoxMinHeight">32</x:Double>
      <x:Double x:Key="RadioButtonMinHeight">24</x:Double>
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <!-- Type tokens (20-UI-SPEC.md, Typography; spec 2.4). The bundled faces are static instances named by their avares folder URI,
       so Avalonia loads every weight of the family; the fallbacks follow the family name after the fragment.
       Anybody (Display) is used only at 20 px and above, weight SemiBold. -->
  <FontFamily x:Key="Autonogrammer.Font.Family">avares://Autonogrammer.Native.Views/Assets/Fonts/DMSans#DM Sans, Helvetica Neue, Helvetica, Arial, sans-serif</FontFamily>
  <FontFamily x:Key="Autonogrammer.Font.Display">avares://Autonogrammer.Native.Views/Assets/Fonts/Anybody#Anybody, Helvetica Neue, Helvetica, Arial, sans-serif</FontFamily>
  <FontFamily x:Key="Autonogrammer.Font.Mono">avares://Autonogrammer.Native.Views/Assets/Fonts/SpaceMono#Space Mono, Menlo, Consolas, Liberation Mono, monospace</FontFamily>
  <x:Double x:Key="Autonogrammer.Font.Size.Small">12</x:Double>
  <x:Double x:Key="Autonogrammer.Font.Size.Label">13</x:Double>
  <x:Double x:Key="Autonogrammer.Font.Size.Body">14</x:Double>
  <x:Double x:Key="Autonogrammer.Font.Size.Heading">16</x:Double>
  <x:Double x:Key="Autonogrammer.Font.Size.DisplaySm">20</x:Double>
  <x:Double x:Key="Autonogrammer.Font.Size.Display">24</x:Double>
  <x:Double x:Key="Autonogrammer.Font.Size.Mono">12</x:Double>
  <x:Double x:Key="Autonogrammer.Font.Size.MonoTerminal">13</x:Double>
  <FontWeight x:Key="Autonogrammer.Font.Weight.Regular">Normal</FontWeight>
  <FontWeight x:Key="Autonogrammer.Font.Weight.Medium">Medium</FontWeight>
  <FontWeight x:Key="Autonogrammer.Font.Weight.Semibold">SemiBold</FontWeight>
  <x:Double x:Key="Autonogrammer.Font.LineHeight.Small">16</x:Double>
  <x:Double x:Key="Autonogrammer.Font.LineHeight.Label">18</x:Double>
  <x:Double x:Key="Autonogrammer.Font.LineHeight.Body">21</x:Double>
  <x:Double x:Key="Autonogrammer.Font.LineHeight.Heading">22</x:Double>
  <x:Double x:Key="Autonogrammer.Font.LineHeight.DisplaySm">26</x:Double>
  <x:Double x:Key="Autonogrammer.Font.LineHeight.Display">30</x:Double>
  <x:Double x:Key="Autonogrammer.Font.LineHeight.Mono">18</x:Double>
  <x:Double x:Key="Autonogrammer.Font.LineHeight.MonoTerminal">17</x:Double>

  <!-- Spacing tokens. Uniform Thickness values: they are applied to Padding, Margin and BorderThickness, which take Thickness. -->
  <Thickness x:Key="Autonogrammer.Space.Xxs">2</Thickness>
  <Thickness x:Key="Autonogrammer.Space.Xs">4</Thickness>
  <Thickness x:Key="Autonogrammer.Space.Compact">6</Thickness>
  <Thickness x:Key="Autonogrammer.Space.Sm">8</Thickness>
  <Thickness x:Key="Autonogrammer.Space.Cozy">12</Thickness>
  <Thickness x:Key="Autonogrammer.Space.Md">16</Thickness>
  <Thickness x:Key="Autonogrammer.Space.Lg">24</Thickness>
  <Thickness x:Key="Autonogrammer.Space.Xl">32</Thickness>
  <Thickness x:Key="Autonogrammer.Space.Xxl">48</Thickness>
  <Thickness x:Key="Autonogrammer.Space.Xxxl">64</Thickness>

  <!-- Corner radius scale (2.5): Sm chips and skeletons, Control buttons and inputs, Md cards, Column Kanban columns, Lg composer and popups, Pill chips and round buttons. -->
  <CornerRadius x:Key="Autonogrammer.Radius.Sm">4</CornerRadius>
  <CornerRadius x:Key="Autonogrammer.Radius.Control">6</CornerRadius>
  <CornerRadius x:Key="Autonogrammer.Radius.Md">8</CornerRadius>
  <CornerRadius x:Key="Autonogrammer.Radius.Column">10</CornerRadius>
  <CornerRadius x:Key="Autonogrammer.Radius.Lg">12</CornerRadius>
  <CornerRadius x:Key="Autonogrammer.Radius.Pill">999</CornerRadius>

  <!-- A transparent fill for the Fluent aliases of the variants: Transparent cannot be an Autonogrammer.Color.* role (every such element is a hex role). -->
  <SolidColorBrush x:Key="Autonogrammer.Brush.Transparent">Transparent</SolidColorBrush>

  <!-- Hairline: the width of every divider and card outline. -->
  <Thickness x:Key="Autonogrammer.Border.Hairline">1</Thickness>

  <!-- Scalar gaps for StackPanel.Spacing and Grid.ColumnSpacing, which take double. Same values as the spacing tokens. -->
  <x:Double x:Key="Autonogrammer.Gap.Xxs">2</x:Double>
  <x:Double x:Key="Autonogrammer.Gap.Xs">4</x:Double>
  <x:Double x:Key="Autonogrammer.Gap.Compact">6</x:Double>
  <x:Double x:Key="Autonogrammer.Gap.Sm">8</x:Double>
  <x:Double x:Key="Autonogrammer.Gap.Cozy">12</x:Double>

  <!-- Fixed sizes (the 2 px focus stroke is a border width). TargetMin is the one place that sets the control height of every view that writes
       MinHeight="{DynamicResource Autonogrammer.Size.TargetMin}": 32 on the desktop (OQ-87; WCAG 2.2 AA asks 24). The Android head overrides it with 44 in
       its application resources, where a finger is the pointer. Control heights: ControlHeight buttons and inputs, ControlHeightSm toolbar buttons,
       tabs and chips that are buttons; IconButton and IconButtonSm square icon buttons (24 is the WCAG 2.2 AA minimum target, SC 2.5.8). -->
  <x:Double x:Key="Autonogrammer.Size.SessionListWidth">240</x:Double>
  <x:Double x:Key="Autonogrammer.Size.TargetMin">32</x:Double>
  <x:Double x:Key="Autonogrammer.Size.ControlHeight">32</x:Double>
  <x:Double x:Key="Autonogrammer.Size.ControlHeightSm">28</x:Double>
  <x:Double x:Key="Autonogrammer.Size.IconButton">28</x:Double>
  <x:Double x:Key="Autonogrammer.Size.IconButtonSm">24</x:Double>
  <Thickness x:Key="Autonogrammer.Size.FocusBorder">2</Thickness>

  <!-- Agent Panel sizes (46-UI-SPEC, Spacing Scale). Fixed sizes, not spacing and not colours, so they sit outside the theme variants. -->
  <x:Double x:Key="Autonogrammer.Size.AgentRailWidth">280</x:Double>
  <x:Double x:Key="Autonogrammer.Size.StageFlyoutWidth">360</x:Double>
  <x:Double x:Key="Autonogrammer.Size.StageFlyoutMaxHeight">360</x:Double>
  <x:Double x:Key="Autonogrammer.Size.ThreadMinWidth">400</x:Double>
  <x:Double x:Key="Autonogrammer.Size.ThreadContentMaxWidth">760</x:Double>
  <x:Double x:Key="Autonogrammer.Size.SessionRowMinHeight">48</x:Double>
  <x:Double x:Key="Autonogrammer.Size.StageRowMinHeight">28</x:Double>
  <x:Double x:Key="Autonogrammer.Size.ChipHeight">20</x:Double>
  <x:Double x:Key="Autonogrammer.Size.IconSize">16</x:Double>
  <x:Double x:Key="Autonogrammer.Size.IconSizeSm">14</x:Double>
  <x:Double x:Key="Autonogrammer.Size.TitleBarHeight">40</x:Double>
  <x:Double x:Key="Autonogrammer.Size.PipelineStripHeight">28</x:Double>
  <x:Double x:Key="Autonogrammer.Size.ComposerMinHeight">72</x:Double>
  <x:Double x:Key="Autonogrammer.Size.ComposerMaxHeight">220</x:Double>
  <x:Double x:Key="Autonogrammer.Size.ScrollBarThumb">6</x:Double>
  <x:Double x:Key="Autonogrammer.Size.SettingsNavWidth">220</x:Double>
  <x:Double x:Key="Autonogrammer.Size.SettingsContentMaxWidth">720</x:Double>
  <x:Double x:Key="Autonogrammer.Size.KanbanColumnWidth">280</x:Double>

</ResourceDictionary>
