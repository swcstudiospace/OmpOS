<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Colour roles (20-UI-SPEC.md, Color; docs/plans/ui-parity/cursor-agents-window-parity.md, 2.1). Each role has a Light and a
       Dark value; Avalonia selects the set for the active theme variant. ThemeContrastTests classifies each role by its use and
       checks every text and non-text pair the classification produces, in both variants.
       Surface order, Dark: SurfaceSunken < Surface < SurfaceRaised < Hover < Selected < SurfaceActive. Light mirrors it with
       SurfaceRaised as the brightest. Border is a decorative hairline (no contrast requirement beyond staying visible);
       BorderStrong draws the outline that identifies an input, a switch or a checkbox (3:1).
       FocusRing is reserved for focus indicators to bind in a later phase. No style consumes it yet: the focus
       indicators in App.axaml draw AccentPurple. -->
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="Autonogrammer.Color.SurfaceSunken">#f0f0ee</SolidColorBrush>
      <SolidColorBrush x:Key="Autonogrammer.Color.Surface">#fafaf9</SolidColorBrush>
      <SolidColorBrush x:Key="Autonogrammer.Color.SurfaceRaised">#ffffff</SolidColorBrush>
      <SolidColorBrush x:Key="Autonogrammer.Color.Hover">#ebebe8</SolidColorBrush>
      <SolidColorBrush x:Key="Autonogrammer.Color.Selected">#e4e4e0</SolidColorBrush>
      <SolidColorBrush x:Key="Autonogrammer.Color.SurfaceActive">#dcdcd7</SolidColorBrush>
      <SolidColorBrush x:Key="Autonogrammer.Color.DiffAdded">#e2f4e7</SolidColorBrush>
      <SolidColorBrush x:Key="Autonogrammer.Color.DiffRemoved">#fbe6e6</SolidColorBrush>
      <SolidColorBrush x:Key="Autonogrammer.Color.TextPrimary">#1c1c1a</SolidColorBrush>
      <SolidColorBrush x:Key="Autonogrammer.Color.TextSecondary">#55555a</SolidColorBrush>
      <SolidColorBrush x:Key="Autonogrammer.Color.AccentPurple">#6d28d9</SolidColorBrush>
      <SolidColorBrush x:Key="Autonogrammer.Color.AccentPurpleOn">#ffffff</SolidColorBrush>
      <SolidColorBrush x:Key="Autonogrammer.Color.FocusRing">#5b21b6</SolidColorBrush>
      <SolidColorBrush x:Key="Autonogrammer.Color.StatusSuccess">#166534</SolidColorBrush>
      <SolidColorBrush x:Key="Autonogrammer.Color.StatusWarning">#92400e</SolidColorBrush>
      <SolidColorBrush x:Key="Autonogrammer.Color.StatusError">#b3261e</SolidColorBrush>
      <SolidColorBrush x:Key="Autonogrammer.Color.Border">#e0e0dc</SolidColorBrush>
      <SolidColorBrush x:Key="Autonogrammer.Color.BorderStrong">#6f6f6b</SolidColorBrush>

      <!-- Elevation (2.5): surfaces are separated by tone and hairlines; two shadows are not colour roles, so the colour tests do not scan them. -->
      <BoxShadows x:Key="Autonogrammer.Shadow.Popup">0 8 24 0 #29000000</BoxShadows>
      <BoxShadows x:Key="Autonogrammer.Shadow.Card">0 1 2 0 #14000000</BoxShadows>

      <!-- Fluent resource aliases (spec 3.2). Avalonia's Fluent templates read these keys; pointing them at the Autonogrammer roles restyles
           every stock control through its own template states instead of fighting the template with presenter selectors.
           StaticResource aliases are not Autonogrammer.Color.* keys, so the contrast tests do not scan them. -->
      <!-- Button -->
      <StaticResource x:Key="ButtonBackground" ResourceKey="Autonogrammer.Color.SurfaceRaised" />
      <StaticResource x:Key="ButtonBackgroundDisabled" ResourceKey="Autonogrammer.Color.SurfaceRaised" />
      <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="Autonogrammer.Color.Hover" />
      <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="Autonogrammer.Color.SurfaceActive" />
      <StaticResource x:Key="ButtonBorderBrush" ResourceKey="Autonogrammer.Color.Border" />
      <StaticResource x:Key="ButtonBorderBrushDisabled" ResourceKey="Autonogrammer.Color.Border" />
      <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="Autonogrammer.Color.BorderStrong" />
      <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="Autonogrammer.Color.BorderStrong" />
      <StaticResource x:Key="ButtonForeground" ResourceKey="Autonogrammer.Color.TextPrimary" />
      <StaticResource x:Key="ButtonForegroundDisabled" ResourceKey="Autonogrammer.Color.TextSecondary" />
      <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="Autonogrammer.Color.TextPrimary" />
      <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="Autonogrammer.Color.TextPrimary" />
      <!-- AccentButton (a stray Classes="accent" stays on palette) -->
      <StaticResource x:Key="AccentButtonBackground" ResourceKey="Autonogrammer.Color.AccentPurple" />
      <StaticResource x:Key="AccentButtonBackgroundDisabled" ResourceKey="Autonogrammer.Color.AccentPurple" />
      <StaticResource x:Key="AccentButtonBackgroundPointerOver" ResourceKey="Autonogrammer.Color.AccentPurple" />
      <StaticResource x:Key="AccentButtonBackgroundPressed" ResourceKey="Autonogrammer.Color.AccentPurple" />
      <StaticResource x:Key="AccentButtonBorderBrush" ResourceKey="Autonogrammer.Brush.Transparent" />
      <StaticResource x:Key="AccentButtonBorderBrushDisabled" ResourceKey="Autonogrammer.Brush.Transparent" />
      <StaticResource x:Key="AccentButtonBorderBrushPointerOver" ResourceKey="Autonogrammer.Brush.Transparent" />
      <StaticResource x:Key="AccentButtonBorderBrushPressed" ResourceKey="Autonogrammer.Brush.Transparent" />
      <StaticResource x:Key="AccentButtonForeground" ResourceKey="Autonogrammer.Color.AccentPurpleOn" />
      <StaticResource x:Key="AccentButtonForegroundDisabled" ResourceKey="Autonogrammer.Color.AccentPurpleOn" />
      <StaticResource x:Key="AccentButtonForegroundPointerOver" ResourceKey="Autonogrammer.Color.AccentPurpleOn" />
      <StaticResource x:Key="AccentButtonForegroundPressed" ResourceKey="Autonogrammer.Color.AccentPurpleOn" />
      <!-- ToggleButton -->
      <StaticResource x:Key="ToggleButtonBackground" ResourceKey="Autonogrammer.Color.SurfaceRaised" />
      <StaticResource x:Key="ToggleButtonBackgroundChecked" ResourceKey="Autonogrammer.Color.Selected" />
      <StaticResource x:Key="ToggleButtonBackgroundCheckedDisabled" ResourceKey="Autonogrammer.Color.Selected" />
      <StaticResource x:Key="ToggleButtonBackgroundCheckedPointerOver" ResourceKey="Autonogrammer.Color.Selected" />
      <StaticResource x:Key="ToggleButtonBackgroundCheckedPressed" ResourceKey="Autonogrammer.Color.SurfaceActive" />
      <StaticResource x:Key="ToggleButtonBackgroundDisabled" ResourceKey="Autonogrammer.Color.SurfaceRaised" />
      <StaticResource x:Key="ToggleButtonBackgroundIndeterminate" ResourceKey="Autonogrammer.Color.Selected" />
      <StaticResource x:Key="ToggleButtonBackgroundIndeterminateDisabled" ResourceKey="Autonogrammer.Color.Selected" />
      <StaticResource x:Key="ToggleButtonBackgroundIndeterminatePointerOver" ResourceKey="Autonogrammer.Color.Selected" />
      <StaticResource x:Key="ToggleButtonBackgroundIndeterminatePressed" ResourceKey="Autonogrammer.Color.SurfaceActive" />
      <StaticResource x:Key="ToggleButtonBackgroundPointerOver" ResourceKey="Autonogrammer.Color.Hover" />
      <StaticResource x:Key="ToggleButtonBackgroundPressed" ResourceKey="Autonogrammer.Color.SurfaceActive" />
      <StaticResource x:Key="ToggleButtonBorderBrush" ResourceKey="Autonogrammer.Color.Border" />
      <StaticResource x:Key="ToggleButtonBorderBrushChecked" ResourceKey="Autonogrammer.Color.BorderStrong" />
      <StaticResource x:Key="ToggleButtonBorderBrushCheckedDisabled" ResourceKey="Autonogrammer.Color.Border" />
      <StaticResource x:Key="ToggleButtonBorderBrushCheckedPointerOver" ResourceKey="Autonogrammer.Color.BorderStrong" />
      <StaticResource x:Key="ToggleButtonBorderBrushCheckedPressed" ResourceKey="Autonogrammer.Color.BorderStrong" />
      <StaticResource x:Key="ToggleButtonBorderBrushDisabled" ResourceKey="Autonogrammer.Color.Border" />
      <StaticResource x:Key="ToggleButtonBorderBrushIndeterminate" ResourceKey="Autonogrammer.Color.BorderStrong" />
      <StaticResource x:Key="ToggleButtonBorderBrushIndeterminateDisabled" ResourceKey="Autonogrammer.Color.Border" />
      <StaticResource x:Key="ToggleButtonBorderBrushIndeterminatePointerOver" ResourceKey="Autonogrammer.Color.BorderStrong" />
      <StaticResource x:Key="ToggleButtonBorderBrushIndeterminatePressed" ResourceKey="Autonogrammer.Color.BorderStrong" />
      <StaticResource x:Key="ToggleButtonBorderBrushPointerOver" ResourceKey="Autonogrammer.Color.BorderStrong" />
      <StaticResource x:Key="ToggleButtonBorderBrushPressed" ResourceKey="Autonogrammer.Color.BorderStrong" />
      <StaticResource x:Key="ToggleButtonForeground" ResourceKey="Autonogrammer.Color.TextPrimary" />
      <StaticResource x:Key="ToggleButtonForegroundChecked" ResourceKey="Autonogrammer.Color.TextPrimary" />
      <StaticResource x:Key="ToggleButtonForegroundCheckedDisabled" ResourceKey="Autonogrammer.Color.TextSecondary" />
      <StaticResource x:Key="ToggleButtonForegroundCheckedPointerOver" ResourceKey="Autonogrammer.Color.TextPrimary" />
      <StaticResource x:Key="ToggleButtonForegroundCheckedPressed" ResourceKey="Autonogrammer.Color.TextPrimary" />
      <StaticResource x:Key="ToggleButtonForegroundDisabled" ResourceKey="Autonogrammer.Color.TextSecondary" />
      <StaticResource x:Key="ToggleButtonForegroundIndeterminate" ResourceKey="Autonogrammer.Color.TextPrimary" />
      <StaticResource x:Key="ToggleButtonForegroundIndeterminateDisabled" ResourceKey="Autonogrammer.Color.TextSecondary" />
      <StaticResource x:Key="ToggleButtonForegroundIndeterminatePointerOver" ResourceKey="Autonogrammer.Color.TextPrimary" />
      <StaticResource x:Key="ToggleButtonForegroundIndeterminatePressed" ResourceKey="Autonogrammer.Color.TextPrimary" />
      <StaticResource x:Key="ToggleButtonForegroundPointerOver" ResourceKey="Autonogrammer.Color.TextPrimary" />
      <StaticResource x:Key="ToggleButtonForegroundPressed" ResourceKey="Autonogrammer.Color.TextPrimary" />
      <!-- TextBox (TextControl*) -->
      <StaticResource x:Key="TextControlBackground" ResourceKey="Autonogrammer.Color.SurfaceRaised" />
      <StaticResource x:Key="TextControlBackgroundDisabled" ResourceKey="Autonogrammer.Color.Surface" />
      <StaticResource x:Key="TextControlBackgroundFocused" ResourceKey="Autonogrammer.Color.SurfaceRaised" />
      <StaticResource x:Key="TextControlBackgroundPointerOver" ResourceKey="Autonogrammer.Color.SurfaceRaised" />
      <StaticResource x:Key="TextControlBorderBrush" ResourceKey="Autonogrammer.Color.BorderStrong" />
      <StaticResource x:Key="TextControlBorderBrushDisabled" ResourceKey="Autonogrammer.Color.Border" />
      <StaticResource x:Key="TextControlBorderBrushFocused" ResourceKey="Autonogrammer.Color.AccentPurple" />
      <StaticResource x:Key="TextControlBorderBrushPointerOver" ResourceKey="Autonogrammer.Color.TextSecondary" />
      <StaticResource x:Key="TextControlButtonBackground" ResourceKey="Autonogrammer.Brush.Transparent" />
      <StaticResource x:Key="TextControlButtonBackgroundPointerOver" ResourceKey="Autonogrammer.Color.Hover" />
      <StaticResource x:Key="TextControlButtonBackgroundPressed" ResourceKey="Autonogrammer.Color.SurfaceActive" />
      <StaticResource x:Key="TextControlButtonBorderBrush" ResourceKey="Autonogrammer.Brush.Transparent" />
      <StaticResource x:Key="TextControlButtonBorderBrushPointerOver" ResourceKey="Autonogrammer.Brush.Transparent" />
