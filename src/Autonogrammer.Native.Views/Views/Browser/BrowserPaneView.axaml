<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Autonogrammer.Native.Views.Browser.BrowserPaneView"
             x:Name="PaneRoot"
             Classes="browser-pane"
             Focusable="True"
             IsTabStop="True"
             AutomationProperties.Name="Browser">
  <UserControl.Styles>
    <StyleInclude Source="avares://Autonogrammer.Native.Views/Views/Browser/BrowserPaneStyles.axaml" />
  </UserControl.Styles>
  <DockPanel>
    <Border x:Name="Chrome"
            Classes="browser-pane-chrome"
            DockPanel.Dock="Top"
            Padding="8"
            AutomationProperties.Name="Browser controls">
      <StackPanel Orientation="Vertical" Spacing="4">
        <TextBlock x:Name="HeaderSentence"
                   TextWrapping="Wrap"
                   IsVisible="False"
                   AutomationProperties.LiveSetting="Off" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button x:Name="TakeOverButton"
                  Content="Take over"
                  MinHeight="{DynamicResource Autonogrammer.Size.TargetMin}"
                  MinWidth="{DynamicResource Autonogrammer.Size.TargetMin}"
                  IsTabStop="True"
                  AutomationProperties.Name="Take over" />
          <Button x:Name="StopButton"
                  Content="Stop"
                  MinHeight="{DynamicResource Autonogrammer.Size.TargetMin}"
                  MinWidth="{DynamicResource Autonogrammer.Size.TargetMin}"
                  IsTabStop="True"
                  AutomationProperties.Name="Stop" />
          <Button x:Name="CloseButton"
                  Content="Close"
                  MinHeight="{DynamicResource Autonogrammer.Size.TargetMin}"
                  MinWidth="{DynamicResource Autonogrammer.Size.TargetMin}"
                  IsTabStop="True"
                  AutomationProperties.Name="Close" />
          <Button x:Name="FixButton"
                  MinHeight="{DynamicResource Autonogrammer.Size.TargetMin}"
                  MinWidth="{DynamicResource Autonogrammer.Size.TargetMin}"
                  IsTabStop="True"
                  IsVisible="False" />
        </StackPanel>
        <ItemsControl x:Name="VisionChoices" IsVisible="False" />
        <TextBlock x:Name="AgentStrip" TextWrapping="Wrap" IsVisible="False" AutomationProperties.Name="Agent view" />
      </StackPanel>
    </Border>
    <TextBlock x:Name="Announcement"
               DockPanel.Dock="Bottom"
               TextWrapping="Wrap"
               AutomationProperties.LiveSetting="Polite"
               AutomationProperties.Name="Browser status" />
    <TextBlock x:Name="Sentence"
               DockPanel.Dock="Bottom"
               TextWrapping="Wrap"
               Margin="8" />
    <Border x:Name="PageFrame"
            Classes="browser-pane-frame"
            Margin="8"
            MinHeight="32">
      <Image x:Name="FrameImage"
             Stretch="Uniform"
             IsVisible="False" />
    </Border>
  </DockPanel>
</UserControl>
