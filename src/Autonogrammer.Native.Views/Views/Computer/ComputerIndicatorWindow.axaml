<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:comp="clr-namespace:Autonogrammer.Presentation.Computer;assembly=Autonogrammer.Presentation"
        x:Class="Autonogrammer.Native.Views.Computer.ComputerIndicatorWindow"
        x:DataType="comp:ComputerIndicatorViewModel"
        Title="Autonogrammer is controlling this computer"
        Width="420"
        Height="96"
        Topmost="True"
        ShowActivated="False"
        Focusable="False"
        CanResize="False"
        WindowDecorations="None"
        AutomationProperties.Name="Autonogrammer is controlling this computer">
  <Window.Styles>
    <StyleInclude Source="avares://Autonogrammer.Native.Views/Views/Settings/SettingsStyles.axaml" />
  </Window.Styles>
  <StackPanel Margin="12" Spacing="{DynamicResource Autonogrammer.Gap.Xs}">
    <TextBlock Classes="settings-body" Text="{CompiledBinding Headline}" />
    <TextBlock Classes="settings-body" Text="{CompiledBinding SessionName}" AutomationProperties.Name="Session" />
    <TextBlock Classes="settings-body" Text="{CompiledBinding KillChord}" AutomationProperties.Name="Kill chord" />
    <TextBlock Classes="settings-body" Text="{CompiledBinding StateLabel}" AutomationProperties.Name="Indicator state" />
    <TextBlock Classes="settings-body"
               IsVisible="{CompiledBinding HasRemoteLabel}"
               Text="{CompiledBinding RemoteLabel}"
               AutomationProperties.Name="Remote Dispatch" />
    <Button Content="Stop"
            MinWidth="24"
            MinHeight="24"
            Focusable="True"
            Command="{CompiledBinding Stop}"
            AutomationProperties.Name="Stop" />
  </StackPanel>
</Window>
