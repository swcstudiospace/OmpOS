<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:about="clr-namespace:Autonogrammer.Presentation.About;assembly=Autonogrammer.Presentation"
        x:Class="Autonogrammer.Native.Views.AboutWindow"
        Title="{x:Static about:AboutCopy.WindowTitle}"
        Icon="avares://Autonogrammer.Native.Views/Assets/Brand/autonogrammer-mark-256.png"
        Width="560"
        Height="620"
        MinWidth="420"
        MinHeight="480"
        CanResize="True"
        Background="{DynamicResource Autonogrammer.Color.Surface}"
        WindowStartupLocation="CenterScreen"
        AutomationProperties.Name="{x:Static about:AboutCopy.WindowTitle}" />
