<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:panel="clr-namespace:Autonogrammer.Native.Views.AgentPanel"
             xmlns:copy="clr-namespace:Autonogrammer.Presentation.AgentPanel;assembly=Autonogrammer.Presentation"
             x:Class="Autonogrammer.Native.Views.Blocks.PermissionBlockView"
             AutomationProperties.Name="Permission request">

  <!-- A permission request is a card with a 1 px accent outline (parity spec 4.6): the warning glyph, the prompt, the options in an
       inset sunken card in the mono face, and the policy note. The block has no decision controls; the decision is made by policy. -->
  <Border Classes="card"
          BorderBrush="{DynamicResource Autonogrammer.Color.AccentPurple}"
          Padding="12,10">
    <Grid ColumnDefinitions="Auto,*"
          ColumnSpacing="{DynamicResource Autonogrammer.Gap.Sm}">

      <panel:StageIcon Grid.Column="0"
                       IconKey="{x:Static copy:StatusIcon.Alert}"
                       VerticalAlignment="Top" />

      <StackPanel Grid.Column="1"
                  Spacing="{DynamicResource Autonogrammer.Gap.Sm}">
        <TextBlock x:Name="Prompt"
                   Classes="strong"
                   FontWeight="{DynamicResource Autonogrammer.Font.Weight.Semibold}"
                   TextWrapping="Wrap" />
        <Border Classes="card-sunken"
                Padding="{DynamicResource Autonogrammer.Space.Sm}">
          <StackPanel x:Name="OptionList"
                      Spacing="{DynamicResource Autonogrammer.Gap.Xs}"
                      AutomationProperties.Name="Permission options" />
        </Border>
        <TextBlock Classes="muted small"
                   TextWrapping="Wrap"
                   Text="The decision is made by policy." />
      </StackPanel>

    </Grid>
  </Border>

</UserControl>
