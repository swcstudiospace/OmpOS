<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Autonogrammer.Native.Views.Blocks.MarkdownBlockView"
             AutomationProperties.Name="Markdown">

  <UserControl.Styles>
    <!-- A block quote reads as secondary text; its bar is drawn by the builder in the strong border role. -->
    <Style Selector="Border.md-quote TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Autonogrammer.Color.TextSecondary}" />
    </Style>
  </UserControl.Styles>

  <!-- Assistant prose sits on the thread surface with no bubble. Paragraphs are 8 px apart. -->
  <StackPanel x:Name="Body"
              Spacing="{DynamicResource Autonogrammer.Gap.Sm}" />

</UserControl>
