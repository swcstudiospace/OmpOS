<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Autonogrammer.Native.Views.Blocks.UserMessageView"
             AutomationProperties.Name="User message">

  <!-- The user's prompt is a rounded card across the whole column, not a right-aligned bubble (parity spec 4.6). -->
  <Border Classes="card"
          CornerRadius="{DynamicResource Autonogrammer.Radius.Column}"
          Padding="12,10">
    <TextBlock x:Name="Body"
               FontSize="{DynamicResource Autonogrammer.Font.Size.Body}"
               LineHeight="{DynamicResource Autonogrammer.Font.LineHeight.Body}"
               TextWrapping="Wrap" />
  </Border>

</UserControl>
