<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:rem="clr-namespace:Autonogrammer.Presentation.Remote;assembly=Autonogrammer.Presentation"
             x:Class="Autonogrammer.Native.Views.Remote.EnvironmentPickerView"
             x:DataType="rem:NewSessionTargetModel"
             Focusable="False">

  <UserControl.Styles>
    <StyleInclude Source="avares://Autonogrammer.Native.Views/Views/AgentPanel/PanelStyles.axaml" />
    <StyleInclude Source="avares://Autonogrammer.Native.Views/Views/Settings/SettingsStyles.axaml" />
  </UserControl.Styles>

  <!-- The environment selector of the New session dialog: this computer, each saved ssh environment, and the cloud. The status of an environment is
       said in words next to its name; the message under the list says why the choice cannot start, or that it is ready. Tokens only. -->
  <StackPanel Spacing="{DynamicResource Autonogrammer.Gap.Xs}">

    <TextBlock x:Name="PickerHeading"
               Classes="settings-section"
               Text="{x:Static rem:RemoteCopy.PickerHeading}" />

    <ListBox x:Name="TargetList"
             ItemsSource="{CompiledBinding Options}"
             SelectedItem="{CompiledBinding Selected, Mode=OneWay}"
             SelectionMode="Single"
             AutomationProperties.Name="{x:Static rem:RemoteCopy.PickerListName}"
             SelectionChanged="OnSelectionChanged">
      <ListBox.Styles>
        <Style Selector="ListBoxItem">
          <Setter Property="AutomationProperties.Name" Value="{ReflectionBinding AccessibleName}" />
        </Style>
      </ListBox.Styles>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="rem:NewSessionTargetOption">
          <StackPanel MinHeight="{DynamicResource Autonogrammer.Size.TargetMin}"
                      Spacing="2"
                      AutomationProperties.Name="{CompiledBinding AccessibleName}">
            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="8">
              <TextBlock Grid.Column="0"
                         Classes="settings-label"
                         Text="{CompiledBinding Label}" />
              <TextBlock Grid.Column="1"
                         Classes="settings-chip-text"
                         IsVisible="{CompiledBinding StatusLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                         Text="{CompiledBinding StatusLabel}" />
            </Grid>
            <TextBlock Classes="settings-help"
                       Text="{CompiledBinding Detail}" />
            <TextBlock Classes="tone-warning settings-help"
                       IsVisible="{CompiledBinding !IsAvailable}"
                       Text="{CompiledBinding UnavailableReason}" />
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <!-- The polite live region: ready, or why the choice cannot start. -->
    <TextBlock x:Name="ValidationText"
               Classes="settings-body"
               Classes.tone-error="{CompiledBinding !CanStart}"
               Text="{CompiledBinding Validation.Message}"
               AutomationProperties.LiveSetting="Polite"
               AutomationProperties.Name="{x:Static rem:RemoteCopy.PickerHeading}" />

    <Button x:Name="ManageButton"
            HorizontalAlignment="Left"
            MinHeight="{DynamicResource Autonogrammer.Size.TargetMin}"
            MinWidth="{DynamicResource Autonogrammer.Size.TargetMin}"
            Content="{x:Static rem:RemoteCopy.ManageLabel}"
            AutomationProperties.Name="{x:Static rem:RemoteCopy.ManageLabel}"
            Click="OnManageClick" />

  </StackPanel>

</UserControl>
