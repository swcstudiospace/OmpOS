<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:copy="clr-namespace:Autonogrammer.Presentation.Changes;assembly=Autonogrammer.Presentation"
             x:Class="Autonogrammer.Native.Views.Changes.ChangesBarView"
             x:DataType="copy:ChangeSetModel"
             IsVisible="{CompiledBinding HasChanges}"
             AutomationProperties.Name="{x:Static copy:ChangeCopy.BarName}">

  <!-- The Changes bar: the files the agent changed in this session, each with its added and removed lines and its own Review, Keep and Undo,
       and Keep all and Undo all for the whole set. It is hidden while the session changed no file. The result of every action is read out by the
       polite live region at the bottom, so a keyboard or screen-reader user hears what Undo did, including a refusal. -->
  <Border Background="{DynamicResource Autonogrammer.Color.SurfaceRaised}"
          BorderBrush="{DynamicResource Autonogrammer.Color.Border}"
          BorderThickness="0,1,0,0"
          Padding="{DynamicResource Autonogrammer.Space.Sm}">
    <StackPanel Spacing="{DynamicResource Autonogrammer.Gap.Xs}">

      <DockPanel>
        <WrapPanel DockPanel.Dock="Right"
                   Orientation="Horizontal"
                   VerticalAlignment="Center"
                   ItemSpacing="{DynamicResource Autonogrammer.Gap.Sm}"
                   LineSpacing="{DynamicResource Autonogrammer.Gap.Sm}">
          <Button x:Name="UndoAllButton"
                  Classes="sm"
                  Content="{x:Static copy:ChangeCopy.UndoAll}"
                  Command="{CompiledBinding UndoAllCommand}"
                  MinHeight="{DynamicResource Autonogrammer.Size.TargetMin}"
                  MinWidth="{DynamicResource Autonogrammer.Size.TargetMin}"
                  AutomationProperties.Name="{x:Static copy:ChangeCopy.UndoAllName}" />
          <Button x:Name="KeepAllButton"
                  Classes="primary sm"
                  Content="{x:Static copy:ChangeCopy.KeepAll}"
                  Command="{CompiledBinding KeepAllCommand}"
                  MinHeight="{DynamicResource Autonogrammer.Size.TargetMin}"
                  MinWidth="{DynamicResource Autonogrammer.Size.TargetMin}"
                  AutomationProperties.Name="{x:Static copy:ChangeCopy.KeepAllName}" />
        </WrapPanel>
        <TextBlock x:Name="SummaryText"
                   Text="{CompiledBinding Summary}"
                   Classes="strong"
                   FontWeight="{DynamicResource Autonogrammer.Font.Weight.Semibold}"
                   VerticalAlignment="Center"
                   Margin="0,0,8,0"
                   TextWrapping="Wrap" />
      </DockPanel>

      <ScrollViewer MaxHeight="160"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
        <ItemsControl x:Name="ChangeRows"
                      ItemsSource="{CompiledBinding Entries}"
                      AutomationProperties.Name="{x:Static copy:ChangeCopy.ListName}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="copy:ChangeEntry">
              <DockPanel Margin="0,2"
                         AutomationProperties.Name="{CompiledBinding RowName}">
                <WrapPanel DockPanel.Dock="Right"
                           Orientation="Horizontal"
                           VerticalAlignment="Center"
                           ItemSpacing="{DynamicResource Autonogrammer.Gap.Xs}"
                           LineSpacing="{DynamicResource Autonogrammer.Gap.Xs}">
                  <Button Classes="sm"
                          Content="{x:Static copy:ChangeCopy.Review}"
                          Command="{CompiledBinding ReviewCommand}"
                          MinHeight="{DynamicResource Autonogrammer.Size.TargetMin}"
                          MinWidth="{DynamicResource Autonogrammer.Size.TargetMin}"
                          AutomationProperties.Name="{CompiledBinding ReviewName}" />
                  <Button Classes="sm"
                          Content="{x:Static copy:ChangeCopy.Keep}"
                          Command="{CompiledBinding KeepCommand}"
                          MinHeight="{DynamicResource Autonogrammer.Size.TargetMin}"
                          MinWidth="{DynamicResource Autonogrammer.Size.TargetMin}"
                          AutomationProperties.Name="{CompiledBinding KeepName}" />
                  <Button Classes="sm"
                          Content="{x:Static copy:ChangeCopy.Undo}"
                          Command="{CompiledBinding UndoCommand}"
                          MinHeight="{DynamicResource Autonogrammer.Size.TargetMin}"
                          MinWidth="{DynamicResource Autonogrammer.Size.TargetMin}"
                          AutomationProperties.Name="{CompiledBinding UndoName}" />
                </WrapPanel>
                <StackPanel Orientation="Horizontal"
                            Spacing="{DynamicResource Autonogrammer.Gap.Sm}"
                            VerticalAlignment="Center">
                  <TextBlock Text="{CompiledBinding Path}"
                             Classes="mono"
                             TextTrimming="CharacterEllipsis"
                             MaxWidth="360" />
                  <TextBlock Text="{CompiledBinding AddedText}"
                             Classes="mono muted" />
                  <TextBlock Text="{CompiledBinding RemovedText}"
                             Classes="mono muted" />
                  <TextBlock Text="{CompiledBinding KindText}"
                             Classes="muted small" />
                  <TextBlock Text="{CompiledBinding StatusText}"
                             Classes="muted small" />
                </StackPanel>
              </DockPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <TextBlock x:Name="ResultText"
                 Text="{CompiledBinding Announcement}"
                 Classes="muted small"
                 TextWrapping="Wrap"
                 IsVisible="{CompiledBinding Announcement, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                 AutomationProperties.Name="{x:Static copy:ChangeCopy.ResultName}"
                 AutomationProperties.LiveSetting="Polite" />

    </StackPanel>
  </Border>

</UserControl>
