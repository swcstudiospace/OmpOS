<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:diff="clr-namespace:Autonogrammer.Native.Views.Diff"
             xmlns:copy="clr-namespace:Autonogrammer.Presentation.Changes;assembly=Autonogrammer.Presentation"
             x:Class="Autonogrammer.Native.Views.Diff.DiffReviewView">

  <UserControl.Styles>
    <!-- Added and removed lines are tinted, and each also carries its sign in the marker column, so colour is never the only signal. -->
    <Style Selector="Border.diff-line.added">
      <Setter Property="Background" Value="{DynamicResource Autonogrammer.Color.DiffAdded}" />
    </Style>
    <Style Selector="Border.diff-line.removed">
      <Setter Property="Background" Value="{DynamicResource Autonogrammer.Color.DiffRemoved}" />
    </Style>
  </UserControl.Styles>

  <Panel>

  <!-- While no review is shown the tool says so, instead of standing empty. The sentence takes focus so the skip link and Tab land on it. -->
  <TextBlock x:Name="EmptyText"
             Focusable="True"
             Margin="{DynamicResource Autonogrammer.Space.Md}"
             Classes="muted"
             Text="{x:Static copy:ChangeCopy.NothingToReview}"
             TextWrapping="Wrap"
             AutomationProperties.Name="{x:Static copy:ChangeCopy.NothingToReview}" />

  <Grid x:Name="ReviewContent"
        RowDefinitions="Auto,Auto,*,Auto,Auto"
        IsVisible="False">

    <!-- The header of a review of an agent's changes: the file, the control that writes the decisions, and the result of the last write. -->
    <Grid x:Name="ReviewHeader"
          Grid.Row="0"
          ColumnDefinitions="*,Auto"
          Margin="{DynamicResource Autonogrammer.Space.Sm}"
          IsVisible="False">
      <StackPanel Grid.Column="0"
                  Spacing="{DynamicResource Autonogrammer.Gap.Xxs}"
                  VerticalAlignment="Center">
        <TextBlock x:Name="TitleText"
                   Classes="strong"
                   FontWeight="{DynamicResource Autonogrammer.Font.Weight.Semibold}"
                   TextWrapping="Wrap" />
        <TextBlock x:Name="ResultText"
                   Classes="muted small"
                   TextWrapping="Wrap"
                   IsVisible="False"
                   AutomationProperties.Name="{x:Static copy:ChangeCopy.ResultName}"
                   AutomationProperties.LiveSetting="Polite" />
      </StackPanel>
      <Button x:Name="ApplyButton"
              Grid.Column="1"
              Classes="primary sm"
              Content="{x:Static copy:ChangeCopy.ApplyReview}"
              MinHeight="{DynamicResource Autonogrammer.Size.TargetMin}"
              MinWidth="{DynamicResource Autonogrammer.Size.TargetMin}"
              VerticalAlignment="Center"
              AutomationProperties.Name="{x:Static copy:ChangeCopy.ApplyReviewName}" />
    </Grid>

    <TextBlock x:Name="PendingText"
               Grid.Row="1"
               Margin="{DynamicResource Autonogrammer.Space.Sm}"
               TextWrapping="Wrap"
               AutomationProperties.Name="Pending hunks"
               AutomationProperties.LiveSetting="Polite" />

    <ScrollViewer Grid.Row="2"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto"
                  Padding="{DynamicResource Autonogrammer.Space.Sm}">
      <ItemsControl x:Name="HunkRows"
                    AutomationProperties.Name="Diff hunks">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="diff:DiffHunkRow">
            <!-- One hunk is a card: a heading, its lines on the sunken surface in the mono face, and the decision row. -->
            <Border Classes="card"
                    ClipToBounds="True"
                    Margin="0,0,0,12">
              <StackPanel>

                <TextBlock Text="{CompiledBinding Heading}"
                           Classes="strong"
                           FontWeight="{DynamicResource Autonogrammer.Font.Weight.Semibold}"
                           Margin="10,8"
                           TextWrapping="Wrap" />

                <Border Background="{DynamicResource Autonogrammer.Color.SurfaceSunken}">
                  <ItemsControl ItemsSource="{CompiledBinding Lines}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="diff:DiffLineRow">
                        <Border Classes="diff-line"
                                Classes.added="{CompiledBinding Marker, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=+}"
                                Classes.removed="{CompiledBinding Marker, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=-}">
                          <Grid ColumnDefinitions="24,*">
                            <TextBlock Grid.Column="0"
                                       Text="{CompiledBinding Marker}"
                                       Classes="mono"
                                       TextAlignment="Center"
                                       LineHeight="{DynamicResource Autonogrammer.Font.LineHeight.Mono}" />
                            <TextBlock Grid.Column="1"
                                       Text="{CompiledBinding Line.Text}"
                                       Classes="mono"
                                       LineHeight="{DynamicResource Autonogrammer.Font.LineHeight.Mono}"
                                       TextWrapping="Wrap" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Border>

                <StackPanel Orientation="Horizontal"
                            Spacing="{DynamicResource Autonogrammer.Gap.Sm}"
                            Margin="10,8">
                  <TextBlock Text="{CompiledBinding DecisionText}"
                             Classes="muted small"
                             VerticalAlignment="Center" />
                  <Button Classes="primary sm"
                          Content="Accept"
                          Command="{CompiledBinding AcceptCommand}"
                          AutomationProperties.Name="{CompiledBinding AcceptName}" />
                  <Button Classes="sm"
                          Content="Reject"
                          Command="{CompiledBinding RejectCommand}"
                          AutomationProperties.Name="{CompiledBinding RejectName}" />
                </StackPanel>

              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <TextBlock Grid.Row="3"
               Margin="{DynamicResource Autonogrammer.Space.Sm}"
               Text="Resulting text"
               Classes="strong"
               FontWeight="{DynamicResource Autonogrammer.Font.Weight.Semibold}" />

    <TextBox x:Name="ResultBox"
             Grid.Row="4"
             Classes="mono"
             Margin="{DynamicResource Autonogrammer.Space.Sm}"
             MaxHeight="220"
             IsReadOnly="True"
             AcceptsReturn="True"
             TextWrapping="Wrap"
             AutomationProperties.Name="Resulting text" />

  </Grid>

  </Panel>

</UserControl>
