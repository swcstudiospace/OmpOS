<local:SettingsPageViewBase xmlns="https://github.com/avaloniaui"
                            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                            xmlns:hk="clr-namespace:Autonogrammer.Presentation.Hooks;assembly=Autonogrammer.Presentation"
                            xmlns:local="clr-namespace:Autonogrammer.Native.Views.Settings"
                            xmlns:hooks="clr-namespace:Autonogrammer.Native.Views.Hooks"
                            x:Class="Autonogrammer.Native.Views.Hooks.HooksPageView"
                            x:DataType="hk:HooksSettingsPage"
                            Focusable="False">

  <local:SettingsPageViewBase.Styles>
    <StyleInclude Source="avares://Autonogrammer.Native.Views/Views/AgentPanel/PanelStyles.axaml" />
    <StyleInclude Source="avares://Autonogrammer.Native.Views/Views/Settings/SettingsStyles.axaml" />
  </local:SettingsPageViewBase.Styles>

  <!-- The Hooks page: the Run hooks switch, then one of loading, error, switched off, untrusted folder, invalid files, empty, or the list of hooks
       by scope and file. A hook is reviewed in a consent panel before it can be approved. Nothing here starts a hook. -->
  <Panel>

    <local:PageStatusView x:Name="StateView" />

    <ScrollViewer x:Name="ReadyPanel"
                  Focusable="False"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
      <StackPanel Classes="settings-column">

        <TextBlock Classes="settings-heading"
                   Text="{x:Static hk:HooksCopy.Heading}" />
        <TextBlock Classes="settings-description"
                   Text="{x:Static hk:HooksCopy.Description}" />

        <CheckBox x:Name="RunHooksBox"
                  Content="{x:Static hk:HooksCopy.RunHooksLabel}"
                  AutomationProperties.Name="{x:Static hk:HooksCopy.RunHooksLabel}"
                  AutomationProperties.HelpText="{x:Static hk:HooksCopy.RunHooksOnDescription}" />
        <TextBlock x:Name="RunHooksHelp"
                   Classes="settings-help"
                   Text="{CompiledBinding RunHooksDescription}" />

        <!-- Polite live region: what the last action did. -->
        <TextBlock x:Name="AnnouncementText"
                   Classes="settings-body"
                   IsVisible="{CompiledBinding Announcement, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                   Text="{CompiledBinding Announcement}"
                   AutomationProperties.LiveSetting="Polite"
                   AutomationProperties.Name="{CompiledBinding Announcement}" />

        <!-- Assertive live region: a change that could not be stored. -->
        <TextBlock x:Name="ActionErrorText"
                   Classes="tone-error settings-body"
                   IsVisible="{CompiledBinding HasError}"
                   Text="{CompiledBinding SaveError}"
                   AutomationProperties.LiveSetting="Assertive"
                   AutomationProperties.Name="{CompiledBinding SaveError}" />

        <!-- Switched off. -->
        <Border x:Name="OffState"
                Classes="settings-banner"
                IsVisible="False">
          <TextBlock Classes="settings-body"
                     Text="{x:Static hk:HooksCopy.RunHooksOffState}" />
        </Border>

        <!-- The folder is not trusted: its hook files are not read. -->
        <StackPanel x:Name="UntrustedState"
                    IsVisible="False"
                    Spacing="{DynamicResource Autonogrammer.Gap.Sm}">
          <TextBlock Classes="settings-section"
                     Text="{x:Static hk:HooksCopy.UntrustedHeading}" />
          <TextBlock Classes="settings-body"
                     Text="{x:Static hk:HooksCopy.UntrustedExplanation}" />
          <ItemsControl x:Name="WithheldList"
                        ItemsSource="{CompiledBinding WithheldFiles}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <TextBlock Classes="settings-mono"
                           Text="{CompiledBinding .}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button x:Name="TrustFolderButton"
                  Classes="primary"
                  HorizontalAlignment="Left"
                  Content="{x:Static hk:HooksCopy.TrustFolderLabel}"
                  AutomationProperties.Name="{x:Static hk:HooksCopy.TrustFolderLabel}"
                  Click="OnTrustFolderClick" />
        </StackPanel>

        <!-- Every hook file is invalid. The diagnostics below say why. -->
        <StackPanel x:Name="InvalidState"
                    IsVisible="False"
                    Spacing="{DynamicResource Autonogrammer.Gap.Sm}">
          <TextBlock Classes="settings-section"
                     Text="{x:Static hk:HooksCopy.InvalidHeading}" />
          <TextBlock Classes="settings-body"
                     Text="{x:Static hk:HooksCopy.InvalidExplanation}" />
        </StackPanel>

        <!-- No hook files: explain hooks and offer a file to copy. -->
        <StackPanel x:Name="EmptyState"
                    IsVisible="False"
                    Spacing="{DynamicResource Autonogrammer.Gap.Sm}">
          <TextBlock Classes="settings-section"
                     Text="{x:Static hk:HooksCopy.EmptyHeading}" />
          <TextBlock Classes="settings-body"
                     Text="{x:Static hk:HooksCopy.EmptyExplanation}" />
          <TextBlock Classes="settings-label"
                     Text="{x:Static hk:HooksCopy.ExampleLabel}" />
          <SelectableTextBlock x:Name="ExampleText"
                               Classes="settings-selectable settings-mono"
                               Text="{CompiledBinding ExampleJson}"
                               AutomationProperties.Name="{x:Static hk:HooksCopy.ExampleLabel}" />
          <Button x:Name="CopyExampleButton"
                  HorizontalAlignment="Left"
                  Content="{x:Static hk:HooksCopy.CopyExampleLabel}"
                  AutomationProperties.Name="{x:Static hk:HooksCopy.CopyExampleLabel}"
                  Click="OnCopyExampleClick" />
        </StackPanel>

        <!-- The trust prompt above a list that also holds hooks (user hooks, for example). -->
        <Border x:Name="UntrustedBanner"
                Classes="settings-banner"
                IsVisible="{CompiledBinding ShowUntrustedBanner}">
          <StackPanel Spacing="{DynamicResource Autonogrammer.Gap.Xs}">
            <TextBlock Classes="settings-label"
                       Text="{x:Static hk:HooksCopy.UntrustedHeading}" />
            <TextBlock Classes="settings-help"
                       Text="{x:Static hk:HooksCopy.UntrustedExplanation}" />
            <Button x:Name="TrustBannerButton"
                    HorizontalAlignment="Left"
                    Content="{x:Static hk:HooksCopy.TrustFolderLabel}"
                    AutomationProperties.Name="{x:Static hk:HooksCopy.TrustFolderLabel}"
                    Click="OnTrustFolderClick" />
          </StackPanel>
        </Border>

        <!-- The list. -->
        <StackPanel x:Name="ListState"
                    IsVisible="False"
                    Spacing="{DynamicResource Autonogrammer.Gap.Sm}">

          <StackPanel IsVisible="{CompiledBinding CanTrustAll}"
                      Spacing="{DynamicResource Autonogrammer.Gap.Xs}">
            <Button x:Name="TrustAllButton"
                    HorizontalAlignment="Left"
                    Content="{x:Static hk:HooksCopy.TrustAllLabel}"
                    AutomationProperties.Name="{x:Static hk:HooksCopy.TrustAllLabel}"
                    Click="OnTrustAllClick" />
            <TextBlock Classes="settings-help"
                       Text="{x:Static hk:HooksCopy.TrustAllExplanation}" />
          </StackPanel>

          <ItemsControl x:Name="GroupList"
                        ItemsSource="{CompiledBinding Groups}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="hk:HookSourceGroup">
                <StackPanel Spacing="{DynamicResource Autonogrammer.Gap.Xs}"
                            Margin="0,8,0,0">
                  <TextBlock Classes="settings-section"
                             Text="{CompiledBinding ScopeTitle}" />
                  <TextBlock Classes="settings-mono"
                             Text="{CompiledBinding File}" />
                  <ItemsControl ItemsSource="{CompiledBinding Rows}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="hk:HookPageRow">
                        <Border Classes="settings-row"
                                AutomationProperties.Name="{CompiledBinding AutomationName}">
                          <StackPanel Spacing="{DynamicResource Autonogrammer.Gap.Xs}">
                            <Grid ColumnDefinitions="*,Auto"
                                  ColumnSpacing="8">
                              <TextBlock Grid.Column="0"
                                         Classes="settings-label"
                                         Text="{CompiledBinding Name}" />
                              <Border Grid.Column="1"
                                      Classes="chip">
                                <TextBlock Classes="settings-chip-text"
                                           Text="{CompiledBinding StateText}" />
                              </Border>
                            </Grid>
                            <StackPanel Orientation="Horizontal"
                                        Spacing="{DynamicResource Autonogrammer.Gap.Sm}">
                              <TextBlock Classes="settings-help"
                                         Text="{CompiledBinding EventName}" />
                              <TextBlock Classes="settings-help"
                                         Text="{CompiledBinding MatcherText}" />
                              <TextBlock Classes="settings-help"
                                         Text="{CompiledBinding TypeText}" />
                            </StackPanel>
                            <TextBlock Classes="settings-mono"
                                       Text="{CompiledBinding Preview}" />
                            <TextBlock Classes="settings-help"
                                       Text="{CompiledBinding StateDetail}" />
                            <TextBlock Classes="settings-help"
                                       Text="{CompiledBinding LastRunText}" />
                            <StackPanel Orientation="Horizontal"
                                        Spacing="{DynamicResource Autonogrammer.Gap.Sm}">
                              <Button Content="{x:Static hk:HooksCopy.ReviewLabel}"
                                      AutomationProperties.Name="{CompiledBinding ReviewAutomationName}"
                                      Click="OnReviewClick" />
                              <CheckBox Content="{x:Static hk:HooksCopy.EnabledLabel}"
                                        IsChecked="{CompiledBinding Item.IsEnabled, Mode=OneWay}"
                                        IsEnabled="{CompiledBinding CanToggle}"
                                        AutomationProperties.Name="{CompiledBinding ToggleAutomationName}"
                                        Click="OnEnabledClick" />
                            </StackPanel>
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

        </StackPanel>

        <!-- The consent prompt of the selected hook: everything the hook will run, nothing shortened. -->
        <Border x:Name="ConsentCard"
                Classes="settings-card"
                IsVisible="{CompiledBinding ConsentPrompt, Converter={x:Static ObjectConverters.IsNotNull}}"
                AutomationProperties.Name="{x:Static hk:HooksCopy.ConsentHeading}">
          <ContentControl x:Name="ConsentHost"
                          Content="{CompiledBinding ConsentPrompt}"
                          Focusable="False">
            <ContentControl.ContentTemplate>
              <DataTemplate x:DataType="hk:HookConsentPrompt">
                <StackPanel Spacing="{DynamicResource Autonogrammer.Gap.Sm}">
                  <TextBlock Classes="settings-section"
                             Text="{x:Static hk:HooksCopy.ConsentHeading}" />
                  <TextBlock Classes="settings-label"
                             Text="{CompiledBinding Title}" />
                  <TextBlock Classes="settings-help"
                             Text="{CompiledBinding Source}" />
                  <TextBlock Classes="settings-label"
                             Text="{CompiledBinding ExactLabel}" />
                  <SelectableTextBlock Classes="settings-selectable settings-mono"
                                       Text="{CompiledBinding ExactText}"
                                       AutomationProperties.Name="{CompiledBinding ExactLabel}" />
                  <TextBlock Classes="settings-body"
                             Text="{CompiledBinding ShellText}" />
                  <TextBlock Classes="settings-label"
                             Text="{x:Static hk:HooksCopy.MatcherLabel}" />
                  <TextBlock Classes="settings-mono"
                             Text="{CompiledBinding MatcherText}" />
                  <TextBlock Classes="settings-label"
                             Text="{x:Static hk:HooksCopy.TimeoutLabel}" />
                  <TextBlock Classes="settings-body"
                             Text="{CompiledBinding TimeoutText}" />
                  <TextBlock Classes="settings-label"
                             Text="{x:Static hk:HooksCopy.WorkingDirectoryLabel}" />
                  <TextBlock Classes="settings-mono"
                             Text="{CompiledBinding WorkingDirectory}" />
                  <TextBlock Classes="settings-label"
                             Text="{x:Static hk:HooksCopy.EnvironmentLabel}" />
                  <TextBlock Classes="settings-mono"
                             Text="{CompiledBinding EnvironmentText}" />
                  <TextBlock Classes="settings-label"
                             Text="{x:Static hk:HooksCopy.FailurePolicyLabel}" />
                  <TextBlock Classes="settings-body"
                             Text="{CompiledBinding FailurePolicyText}" />
                  <TextBlock Classes="settings-label"
                             Text="{CompiledBinding ChangesSummary}" />
                  <ItemsControl ItemsSource="{CompiledBinding Changes}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="hk:HookFieldChange">
                        <SelectableTextBlock Classes="settings-selectable settings-mono"
                                             Text="{CompiledBinding Text}"
                                             AutomationProperties.Name="{CompiledBinding Text}" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Classes="tone-warning settings-body"
                             Text="{CompiledBinding Warning}" />
                  <StackPanel Orientation="Horizontal"
                              Spacing="{DynamicResource Autonogrammer.Gap.Sm}">
                    <Button Classes="primary"
                            IsEnabled="{CompiledBinding CanApprove}"
                            Content="{x:Static hk:HooksCopy.ApproveLabel}"
                            AutomationProperties.Name="{x:Static hk:HooksCopy.ApproveLabel}"
                            Click="OnApproveClick" />
                    <Button IsEnabled="{CompiledBinding CanRevoke}"
                            Content="{x:Static hk:HooksCopy.RevokeLabel}"
                            AutomationProperties.Name="{x:Static hk:HooksCopy.RevokeLabel}"
                            Click="OnRevokeClick" />
                    <Button Content="{x:Static hk:HooksCopy.CloseReviewLabel}"
                            AutomationProperties.Name="{x:Static hk:HooksCopy.CloseReviewLabel}"
                            Click="OnCloseReviewClick" />
                  </StackPanel>
                </StackPanel>
              </DataTemplate>
            </ContentControl.ContentTemplate>
          </ContentControl>
        </Border>

        <!-- Quarantined sources: lifting needs a reason, which is recorded. -->
        <ItemsControl x:Name="QuarantineList"
                      ItemsSource="{CompiledBinding Quarantines}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="hk:HookQuarantineRow">
              <Border Classes="settings-banner"
                      Margin="0,8,0,0">
                <StackPanel Spacing="{DynamicResource Autonogrammer.Gap.Xs}">
                  <TextBlock Classes="settings-label"
                             Text="{CompiledBinding Source}" />
                  <TextBlock Classes="settings-help"
                             Text="{CompiledBinding Reason}" />
                  <TextBox x:Name="LiftReason"
                           PlaceholderText="{x:Static hk:HooksCopy.LiftReasonLabel}"
                           AutomationProperties.Name="{x:Static hk:HooksCopy.LiftReasonLabel}" />
                  <Button Content="{x:Static hk:HooksCopy.LiftQuarantineLabel}"
                          HorizontalAlignment="Left"
                          AutomationProperties.Name="{x:Static hk:HooksCopy.LiftQuarantineLabel}"
                          Click="OnLiftQuarantineClick" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Validation diagnostics: file, place and reason. -->
        <StackPanel IsVisible="{CompiledBinding HasDiagnostics}"
                    Spacing="{DynamicResource Autonogrammer.Gap.Xs}">
          <TextBlock Classes="settings-section"
                     Margin="0,8,0,0"
                     Text="{x:Static hk:HooksCopy.DiagnosticsHeading}" />
          <ItemsControl x:Name="DiagnosticList"
                        ItemsSource="{CompiledBinding Diagnostics}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="hk:HookDiagnosticItem">
                <Border Classes="settings-row"
                        AutomationProperties.Name="{CompiledBinding Summary}">
                  <StackPanel Spacing="{DynamicResource Autonogrammer.Gap.Xs}">
                    <TextBlock Classes="settings-mono"
                               Text="{CompiledBinding File}" />
                    <TextBlock Classes="settings-mono"
                               Text="{CompiledBinding Location}" />
                    <TextBlock Classes="settings-body"
                               Text="{CompiledBinding Reason}" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <!-- The run log, under the list. -->
        <hooks:HookRunLogView x:Name="LogView"
                              Margin="0,16,0,0"
                              DataContext="{CompiledBinding RunLog}" />

      </StackPanel>
    </ScrollViewer>

  </Panel>

</local:SettingsPageViewBase>
