<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hk="clr-namespace:Autonogrammer.Presentation.Hooks;assembly=Autonogrammer.Presentation"
             xmlns:local="clr-namespace:Autonogrammer.Native.Views.Hooks"
             x:Class="Autonogrammer.Native.Views.Hooks.HookRunLogDrawerView"
             x:DataType="hk:HookRunLogModel"
             Focusable="False">

  <UserControl.Styles>
    <StyleInclude Source="avares://Autonogrammer.Native.Views/Views/AgentPanel/PanelStyles.axaml" />
    <StyleInclude Source="avares://Autonogrammer.Native.Views/Views/Settings/SettingsStyles.axaml" />
  </UserControl.Styles>

  <!-- The run-log drawer a thread opens from a hook notice: the same log under a close button. The host places it at the edge of the thread. -->
  <Border Classes="settings-card"
          AutomationProperties.Name="{x:Static hk:HooksCopy.RunLogHeading}">
    <DockPanel LastChildFill="True">

      <Button x:Name="CloseButton"
              DockPanel.Dock="Top"
              HorizontalAlignment="Right"
              Content="{x:Static hk:HooksCopy.CloseLogLabel}"
              AutomationProperties.Name="{x:Static hk:HooksCopy.CloseLogLabel}"
              Click="OnCloseClick" />

      <ScrollViewer Focusable="False"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
        <local:HookRunLogView x:Name="Log" />
      </ScrollViewer>

    </DockPanel>
  </Border>

</UserControl>
