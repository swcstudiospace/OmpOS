<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:agents="clr-namespace:Autonogrammer.Presentation.Agents;assembly=Autonogrammer.Presentation"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             x:Class="Autonogrammer.Native.Views.Agents.AgentsView"
             x:DataType="agents:AgentsViewModel"
             Padding="{DynamicResource Autonogrammer.Space.Sm}">

  <DockPanel>

    <StackPanel DockPanel.Dock="Top"
                Spacing="{DynamicResource Autonogrammer.Gap.Sm}">

      <TextBlock Text="Agents"
                 FontWeight="{DynamicResource Autonogrammer.Font.Weight.Semibold}"
                 FontSize="{DynamicResource Autonogrammer.Font.Size.Body}" />

      <StackPanel Orientation="Horizontal"
                  Spacing="{DynamicResource Autonogrammer.Gap.Sm}">

        <TextBlock Text="Status"
                   VerticalAlignment="Center"
                   FontSize="{DynamicResource Autonogrammer.Font.Size.Label}" />

        <ComboBox x:Name="StatusFilter"
                  MinWidth="160"
                  AutomationProperties.Name="Filter runs by status" />

      </StackPanel>

      <TextBlock x:Name="EmptyState"
                 Classes="muted"
                 FontSize="{DynamicResource Autonogrammer.Font.Size.Label}"
                 TextWrapping="Wrap" />

    </StackPanel>

    <Border x:Name="RunPanel"
            x:DataType="agents:AgentRun"
            Classes="card"
            DockPanel.Dock="Bottom"
            IsVisible="False"
            Margin="{DynamicResource Autonogrammer.Space.Xs}"
            Padding="{DynamicResource Autonogrammer.Space.Sm}"
            BorderBrush="{DynamicResource Autonogrammer.Color.AccentPurple}">

      <StackPanel Spacing="{DynamicResource Autonogrammer.Gap.Xs}">

        <TextBlock Text="{CompiledBinding Title}"
                   FontWeight="{DynamicResource Autonogrammer.Font.Weight.Semibold}"
                   FontSize="{DynamicResource Autonogrammer.Font.Size.Body}"
                   TextTrimming="CharacterEllipsis"
                   MaxLines="1" />

        <TextBlock Text="{CompiledBinding StatusText}"
                   Classes="muted"
                   FontSize="{DynamicResource Autonogrammer.Font.Size.Label}" />

        <Button x:Name="CloseRunButton"
                Classes="sm"
                Content="Close run"
                HorizontalAlignment="Left"
                AutomationProperties.Name="Close run" />

        <ScrollViewer MaxHeight="240"
                      AutomationProperties.Name="Run transcript">
          <ItemsControl ItemsSource="{CompiledBinding Transcript}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="sys:String">
                <TextBlock Text="{CompiledBinding}"
                           TextWrapping="Wrap"
                           FontSize="{DynamicResource Autonogrammer.Font.Size.Label}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

      </StackPanel>

    </Border>

    <ScrollViewer AutomationProperties.Name="Agent runs">
      <ItemsControl x:Name="AgentRows"
                    ItemsSource="{CompiledBinding VisibleRuns}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="agents:AgentRun">
            <Button Classes="ghost"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left"
                    Margin="0,1"
                    AutomationProperties.Name="{CompiledBinding AccessibleLabel}">
              <StackPanel Spacing="{DynamicResource Autonogrammer.Gap.Xs}">
                <TextBlock Text="{CompiledBinding Title}"
                           FontWeight="{DynamicResource Autonogrammer.Font.Weight.Semibold}"
                           TextTrimming="CharacterEllipsis"
                           MaxLines="1" />
                <TextBlock Text="{CompiledBinding StatusText}"
                           Classes="muted"
                           FontSize="{DynamicResource Autonogrammer.Font.Size.Label}" />
              </StackPanel>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

  </DockPanel>

</UserControl>
