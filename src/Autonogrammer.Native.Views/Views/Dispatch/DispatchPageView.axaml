<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dispatch="clr-namespace:Autonogrammer.Presentation.Dispatch;assembly=Autonogrammer.Presentation"
             x:Class="Autonogrammer.Native.Views.Dispatch.DispatchPageView"
             x:DataType="dispatch:DispatchPageModel"
             Focusable="False">

  <UserControl.Styles>
    <StyleInclude Source="avares://Autonogrammer.Native.Views/Views/Settings/SettingsStyles.axaml" />
    <Style Selector="ToggleSwitch.dispatch-switch">
      <Setter Property="MinHeight" Value="{DynamicResource Autonogrammer.Size.TargetMin}" />
      <Setter Property="MinWidth" Value="{DynamicResource Autonogrammer.Size.TargetMin}" />
    </Style>
  </UserControl.Styles>

  <!-- The Dispatch page. The status line is polite, the problems line is assertive; the rows, the switches and the pairing text follow in XAML order. -->
  <StackPanel Spacing="{DynamicResource Autonogrammer.Gap.Sm}">

    <TextBlock x:Name="PageHeading"
               Classes="settings-heading"
               Focusable="True"
               IsTabStop="False"
               AutomationProperties.Name="{x:Static dispatch:DispatchCopy.PageHeading}" />

    <TextBlock x:Name="StatusText"
               Classes="settings-body"
               Text="{CompiledBinding Devices.StatusLine}"
               TextWrapping="Wrap"
               AutomationProperties.LiveSetting="Polite"
               AutomationProperties.Name="{x:Static dispatch:DispatchCopy.DevicesLabel}" />

    <TextBlock x:Name="FailureText"
               Classes="settings-body"
               TextWrapping="Wrap"
               AutomationProperties.LiveSetting="Assertive"
               AutomationProperties.Name="{x:Static dispatch:DispatchCopy.ProblemsLabel}" />

    <ItemsControl x:Name="DeviceList"
                  ItemsSource="{CompiledBinding Devices.Rows}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="dispatch:DeviceRowModel">
          <StackPanel Orientation="Horizontal"
                      Spacing="{DynamicResource Autonogrammer.Gap.Sm}"
                      Margin="0,0,0,4">
            <TextBlock Classes="settings-body"
                       Text="{CompiledBinding Name}" />
            <TextBlock Classes="settings-help"
                       Text="{CompiledBinding StatusText}"
                       TextWrapping="Wrap" />
          </StackPanel>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <ItemsControl x:Name="CommandList"
                  ItemsSource="{CompiledBinding Commands}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="dispatch:DispatchCommandRowModel">
          <StackPanel Spacing="{DynamicResource Autonogrammer.Gap.Sm}"
                      Margin="0,0,0,4">
            <TextBlock Classes="settings-body"
                       Text="{CompiledBinding TaskText}"
                       TextWrapping="Wrap" />
            <TextBlock Classes="settings-help"
                       Text="{CompiledBinding StatusText}"
                       TextWrapping="Wrap" />
            <Button Classes="sm"
                    HorizontalAlignment="Left"
                    Content="{x:Static dispatch:DispatchCopy.CancelLabel}"
                    AutomationProperties.Name="{x:Static dispatch:DispatchCopy.CancelLabel}"
                    Tag="{CompiledBinding CommandId}"
                    IsVisible="{CompiledBinding CanCancel}"
                    MinHeight="{DynamicResource Autonogrammer.Size.TargetMin}"
                    MinWidth="{DynamicResource Autonogrammer.Size.TargetMin}"
                    Click="OnCancelClicked" />
          </StackPanel>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <StackPanel x:Name="PairControls"
                Spacing="{DynamicResource Autonogrammer.Gap.Sm}">
      <ToggleSwitch x:Name="PauseToggle"
                    Classes="dispatch-switch"
                    Content="{x:Static dispatch:DispatchCopy.PauseLabel}"
                    AutomationProperties.Name="{x:Static dispatch:DispatchCopy.PauseLabel}"
                    IsVisible="False" />
      <StackPanel x:Name="CapabilityList"
                  Spacing="{DynamicResource Autonogrammer.Gap.Sm}" />
    </StackPanel>

    <TextBlock x:Name="PairText"
               Classes="settings-body"
               TextWrapping="Wrap" />

  </StackPanel>
</UserControl>
