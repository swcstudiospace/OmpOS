<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Autonogrammer.Native.Views.Workspace"
        x:Class="Autonogrammer.Native.Views.Workspace.WorkspaceSetPickerWindow"
        Title="{x:Static local:WorkspaceSetPickerCopy.WindowTitle}"
        Icon="avares://Autonogrammer.Native.Views/Assets/Brand/autonogrammer-mark-256.png"
        Width="640"
        Height="640"
        MinWidth="480"
        MinHeight="420"
        CanResize="True"
        ShowInTaskbar="False"
        Background="{DynamicResource Autonogrammer.Color.Surface}"
        WindowStartupLocation="CenterOwner"
        AutomationProperties.Name="{x:Static local:WorkspaceSetPickerCopy.WindowTitle}" />
