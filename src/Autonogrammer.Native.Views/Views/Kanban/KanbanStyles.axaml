<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Styles the Kanban tab shares. Tokens only: no colour literal, no literal font family. Each Kanban view includes this file. -->

  <!-- A column (spec 4.10): a sunken surface with a transparent 2 px border, so the drop highlight appears without moving anything. -->
  <Style Selector="Border.kanban-column">
    <Setter Property="Background" Value="{DynamicResource Autonogrammer.Color.SurfaceSunken}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Autonogrammer.Brush.Transparent}" />
    <Setter Property="BorderThickness" Value="{DynamicResource Autonogrammer.Size.FocusBorder}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Autonogrammer.Radius.Column}" />
    <Setter Property="Padding" Value="{DynamicResource Autonogrammer.Space.Sm}" />
    <Setter Property="MinWidth" Value="240" />
    <Setter Property="Width" Value="{DynamicResource Autonogrammer.Size.KanbanColumnWidth}" />
  </Style>
  <!-- The column header is one TextBlock holding the title and the count, in DM Sans (the display face is for headings of 20 px and up only). -->
  <Style Selector="TextBlock.kanban-column-header">
    <Setter Property="FontFamily" Value="{DynamicResource Autonogrammer.Font.Family}" />
    <Setter Property="FontSize" Value="{DynamicResource Autonogrammer.Font.Size.Label}" />
    <Setter Property="FontWeight" Value="{DynamicResource Autonogrammer.Font.Weight.Semibold}" />
    <Setter Property="Foreground" Value="{DynamicResource Autonogrammer.Color.TextPrimary}" />
    <Setter Property="TextWrapping" Value="NoWrap" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="Padding" Value="4,5" />
    <Setter Property="Margin" Value="0,0,0,4" />
  </Style>
  <!-- The text of a column without a card: the drop hint in Backlog and Archived, "No tasks" elsewhere. -->
  <Style Selector="TextBlock.kanban-empty">
    <Setter Property="FontSize" Value="{DynamicResource Autonogrammer.Font.Size.Small}" />
    <Setter Property="Foreground" Value="{DynamicResource Autonogrammer.Color.TextSecondary}" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="Padding" Value="8,12" />
  </Style>
  <Style Selector="Border.kanban-column.drop-target">
    <Setter Property="Background" Value="{DynamicResource Autonogrammer.Color.Hover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Autonogrammer.Color.AccentPurple}" />
  </Style>

  <!-- A card (spec 4.10). The outer Frame keeps the transparent 2 px ring border (the keyboard focus ring is drawn in it, so nothing moves);
       the face inside it is a Border.card with a hairline. Hover tints the face. -->
  <Style Selector="Border.kanban-card">
    <Setter Property="Background" Value="{DynamicResource Autonogrammer.Brush.Transparent}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Autonogrammer.Brush.Transparent}" />
    <Setter Property="BorderThickness" Value="{DynamicResource Autonogrammer.Size.FocusBorder}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Autonogrammer.Radius.Md}" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="Border.kanban-card-face">
    <Setter Property="Padding" Value="10,8" />
  </Style>
  <Style Selector=".kanban-card-view:pointerover Border.kanban-card-face">
    <Setter Property="Background" Value="{DynamicResource Autonogrammer.Color.Hover}" />
  </Style>
  <Style Selector=".kanban-card-view:focus-visible Border#Frame">
    <Setter Property="BorderBrush" Value="{DynamicResource Autonogrammer.Color.AccentPurple}" />
  </Style>

  <!-- The drag grip of a Backlog or Archived card: six dots in TextSecondary. -->
  <Style Selector="Path.kanban-grip">
    <Setter Property="Fill" Value="{DynamicResource Autonogrammer.Color.TextSecondary}" />
    <Setter Property="Width" Value="8" />
    <Setter Property="Height" Value="12" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Margin" Value="0,3,0,0" />
  </Style>

  <!-- Ids and the model line are drawn in the mono face of the Greptile families. -->
  <Style Selector="TextBlock.kanban-id">
    <Setter Property="FontFamily" Value="{DynamicResource Autonogrammer.Font.Mono}" />
    <Setter Property="FontSize" Value="{DynamicResource Autonogrammer.Font.Size.Mono}" />
  </Style>

  <!-- Loading skeleton: static bars. The view adds skeleton-pulse only while motion is full, never under reduced motion. -->
  <Style Selector="Border.skeleton">
    <Setter Property="Background" Value="{DynamicResource Autonogrammer.Color.SurfaceActive}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Autonogrammer.Radius.Sm}" />
    <Setter Property="Height" Value="{DynamicResource Autonogrammer.Size.ChipHeight}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Border.skeleton.skeleton-pulse">
    <Style.Animations>
      <Animation Duration="0:0:1.6" IterationCount="INFINITE">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="1" />
        </KeyFrame>
        <KeyFrame Cue="50%">
          <Setter Property="Opacity" Value="0.5" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="1" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

</Styles>
