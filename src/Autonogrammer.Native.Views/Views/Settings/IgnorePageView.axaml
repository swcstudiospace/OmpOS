<local:SettingsPageViewBase xmlns="https://github.com/avaloniaui"
                            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                            xmlns:ign="clr-namespace:Autonogrammer.Presentation.Settings.Ignore;assembly=Autonogrammer.Presentation"
                            xmlns:local="clr-namespace:Autonogrammer.Native.Views.Settings"
                            x:Class="Autonogrammer.Native.Views.Settings.IgnorePageView"
                            x:DataType="ign:IgnoreSettingsPage"
                            Focusable="False">

  <local:SettingsPageViewBase.Styles>
    <StyleInclude Source="avares://Autonogrammer.Native.Views/Views/AgentPanel/PanelStyles.axaml" />
    <StyleInclude Source="avares://Autonogrammer.Native.Views/Views/Settings/SettingsStyles.axaml" />
  </local:SettingsPageViewBase.Styles>

  <!-- The Ignore page: the global pattern list and the two switches you edit, then the fixed built-in list (hidden until asked for) and the ignore files found in the
       workspace. Everything you edit is a draft until the footer's Save writes it. The rows of the lists are drawn from the page in the code-behind. -->
  <Panel>

    <local:PageStatusView x:Name="StateView" />

    <ScrollViewer x:Name="ReadyPanel"
                  Focusable="False"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
      <StackPanel Classes="settings-column">

        <TextBlock Classes="settings-heading"
                   Text="{x:Static ign:IgnoreCopy.Heading}" />
        <TextBlock Classes="settings-description"
                   Text="{x:Static ign:IgnoreCopy.Description}" />

        <TextBlock Classes="settings-section"
                   Margin="0,8,0,0"
                   Text="{x:Static ign:IgnoreCopy.GlobalHeading}" />
        <TextBlock Classes="settings-help"
                   Text="{x:Static ign:IgnoreCopy.GlobalHelp}" />
        <StackPanel x:Name="PatternList"
                    Spacing="{DynamicResource Autonogrammer.Gap.Xs}" />
        <Grid ColumnDefinitions="*,Auto"
              ColumnSpacing="8">
          <TextBox x:Name="PatternBox"
                   Grid.Column="0"
                   Classes="settings-mono"
                   PlaceholderText="{x:Static ign:IgnoreCopy.PatternPlaceholder}"
                   AutomationProperties.Name="{x:Static ign:IgnoreCopy.PatternLabel}"
                   KeyDown="OnPatternKeyDown" />
          <Button x:Name="AddButton"
                  Grid.Column="1"
                  Content="{x:Static ign:IgnoreCopy.AddLabel}"
                  AutomationProperties.Name="{x:Static ign:IgnoreCopy.AddLabel}"
                  Click="OnAddClick" />
        </Grid>
        <TextBlock x:Name="EntryErrorText"
                   Classes="tone-error settings-body"
                   IsVisible="{CompiledBinding HasEntryError}"
                   Text="{CompiledBinding EntryError}"
                   AutomationProperties.LiveSetting="Assertive"
                   AutomationProperties.Name="{CompiledBinding EntryError}" />

        <CheckBox x:Name="UseDefaultBox"
                  Margin="0,16,0,0"
                  Content="{x:Static ign:IgnoreCopy.UseDefaultLabel}"
                  AutomationProperties.Name="{x:Static ign:IgnoreCopy.UseDefaultLabel}"
                  AutomationProperties.HelpText="{x:Static ign:IgnoreCopy.UseDefaultHelp}" />
        <TextBlock Classes="settings-help"
                   Text="{x:Static ign:IgnoreCopy.UseDefaultHelp}" />

        <CheckBox x:Name="HierarchicalBox"
                  Content="{x:Static ign:IgnoreCopy.HierarchicalLabel}"
                  AutomationProperties.Name="{x:Static ign:IgnoreCopy.HierarchicalLabel}"
                  AutomationProperties.HelpText="{x:Static ign:IgnoreCopy.HierarchicalHelp}" />
        <TextBlock Classes="settings-help"
                   Text="{x:Static ign:IgnoreCopy.HierarchicalHelp}" />

        <TextBlock x:Name="SaveFailedHeading"
                   Classes="tone-error settings-body"
                   IsVisible="{CompiledBinding HasError}"
                   Text="{x:Static ign:IgnoreCopy.SaveFailedHeading}"
                   AutomationProperties.LiveSetting="Assertive"
                   AutomationProperties.Name="{x:Static ign:IgnoreCopy.SaveFailedHeading}" />
        <TextBlock x:Name="SaveFailedBody"
                   Classes="tone-error settings-body"
                   IsVisible="{CompiledBinding HasError}"
                   Text="{CompiledBinding SaveError}" />

        <Button x:Name="DefaultsToggle"
                Margin="0,16,0,0"
                HorizontalAlignment="Left"
                Content="{x:Static ign:IgnoreCopy.ShowDefaultsLabel}"
                AutomationProperties.Name="{x:Static ign:IgnoreCopy.ShowDefaultsLabel}"
                Click="OnDefaultsToggleClick" />
        <StackPanel x:Name="DefaultsPanel"
                    IsVisible="False"
                    Spacing="{DynamicResource Autonogrammer.Gap.Xs}">
          <TextBlock Classes="settings-section"
                     Text="{x:Static ign:IgnoreCopy.DefaultsHeading}" />
          <TextBlock Classes="settings-help"
                     Text="{x:Static ign:IgnoreCopy.DefaultsHelp}" />
          <StackPanel x:Name="DefaultsList" />
        </StackPanel>

        <TextBlock Classes="settings-section"
                   Margin="0,16,0,0"
                   Text="{x:Static ign:IgnoreCopy.FilesHeading}" />
        <StackPanel x:Name="FileList"
                    Spacing="{DynamicResource Autonogrammer.Gap.Xs}" />

      </StackPanel>
    </ScrollViewer>

  </Panel>

</local:SettingsPageViewBase>
