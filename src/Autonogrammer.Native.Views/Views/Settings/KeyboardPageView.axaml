<local:SettingsPageViewBase xmlns="https://github.com/avaloniaui"
                            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                            xmlns:set="clr-namespace:Autonogrammer.Presentation.Settings;assembly=Autonogrammer.Presentation"
                            xmlns:local="clr-namespace:Autonogrammer.Native.Views.Settings"
                            x:Class="Autonogrammer.Native.Views.Settings.KeyboardPageView"
                            x:DataType="set:KeyboardSettingsPage"
                            Focusable="False">

  <local:SettingsPageViewBase.Styles>
    <StyleInclude Source="avares://Autonogrammer.Native.Views/Views/AgentPanel/PanelStyles.axaml" />
    <StyleInclude Source="avares://Autonogrammer.Native.Views/Views/Settings/SettingsStyles.axaml" />
  </local:SettingsPageViewBase.Styles>

  <!-- The Keyboard page: the shortcuts the shell handles, grouped by scope, read-only. Remapping is left out on purpose. -->
  <Panel>

    <local:PageStatusView x:Name="StateView" />

    <ScrollViewer x:Name="ReadyPanel"
                  Focusable="False"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
      <StackPanel Classes="settings-column">

        <TextBlock Classes="settings-heading"
                   Text="{x:Static set:KeyboardCopy.Heading}" />
        <TextBlock Classes="settings-description"
                   Text="{x:Static set:KeyboardCopy.Description}" />

        <TextBlock x:Name="EmptyText"
                   Classes="muted settings-body"
                   IsVisible="{CompiledBinding IsEmpty}"
                   Text="{x:Static set:KeyboardCopy.Empty}" />

        <ItemsControl x:Name="ShortcutGroups"
                      ItemsSource="{CompiledBinding Groups}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="set:ShortcutGroup">
              <StackPanel Spacing="{DynamicResource Autonogrammer.Gap.Xs}"
                          Margin="0,0,0,16">
                <TextBlock Classes="settings-section"
                           Text="{CompiledBinding Scope}" />
                <ItemsControl ItemsSource="{CompiledBinding Rows}"
                              AutomationProperties.Name="{CompiledBinding Scope}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="set:ShortcutRow">
                      <Border Classes="settings-row"
                              AutomationProperties.Name="{CompiledBinding Summary}">
                        <Grid ColumnDefinitions="*,Auto"
                              ColumnSpacing="16">
                          <TextBlock Grid.Column="0"
                                     Classes="settings-body"
                                     VerticalAlignment="Center"
                                     Text="{CompiledBinding Action}" />
                          <Border Grid.Column="1"
                                  Classes="chip"
                                  VerticalAlignment="Center">
                            <TextBlock Classes="settings-chip-text settings-mono"
                                       Text="{CompiledBinding Gesture}" />
                          </Border>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

      </StackPanel>
    </ScrollViewer>

  </Panel>

</local:SettingsPageViewBase>
