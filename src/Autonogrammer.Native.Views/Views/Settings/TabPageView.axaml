<local:SettingsPageViewBase xmlns="https://github.com/avaloniaui"
                            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                            xmlns:set="clr-namespace:Autonogrammer.Presentation.Settings;assembly=Autonogrammer.Presentation"
                            xmlns:local="clr-namespace:Autonogrammer.Native.Views.Settings"
                            x:Class="Autonogrammer.Native.Views.Settings.TabPageView"
                            x:DataType="set:TabPage"
                            Focusable="False">

  <local:SettingsPageViewBase.Styles>
    <StyleInclude Source="avares://Autonogrammer.Native.Views/Views/AgentPanel/PanelStyles.axaml" />
    <StyleInclude Source="avares://Autonogrammer.Native.Views/Views/Settings/SettingsStyles.axaml" />
  </local:SettingsPageViewBase.Styles>

  <!-- The Tab page: the read-only status of inline completion. Nothing here is a tab stop except the selectable endpoint. -->
  <Panel>

    <local:PageStatusView x:Name="StateView" />

    <ScrollViewer x:Name="ReadyPanel"
                  Focusable="False"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
      <StackPanel Classes="settings-column">

        <TextBlock Classes="settings-heading"
                   Text="{x:Static set:SettingsCopy.TabHeading}" />
        <TextBlock Classes="settings-description"
                   Text="{x:Static set:SettingsCopy.TabDescription}" />

        <TextBlock x:Name="StatusLine"
                   Classes="settings-section"
                   Text="{CompiledBinding StatusText}"
                   AutomationProperties.LiveSetting="Polite"
                   AutomationProperties.Name="{CompiledBinding StatusText}" />

        <!-- A read-only status row: the label on the left, the endpoint on the right as selectable monospace text. -->
        <Border Classes="settings-row">
          <Grid ColumnDefinitions="Auto,*"
                ColumnSpacing="16">
            <TextBlock Grid.Column="0"
                       Classes="settings-label"
                       VerticalAlignment="Center"
                       Text="{x:Static set:SettingsCopy.TabEndpointLabel}" />
            <SelectableTextBlock x:Name="EndpointLine"
                                 Grid.Column="1"
                                 Classes="settings-selectable settings-mono"
                                 HorizontalAlignment="Right"
                                 VerticalAlignment="Center"
                                 Text="{CompiledBinding EndpointText}"
                                 AutomationProperties.Name="{CompiledBinding EndpointText}" />
          </Grid>
        </Border>

        <TextBlock x:Name="HowConfiguredLine"
                   Classes="settings-help"
                   Margin="0,4,0,0"
                   Text="{CompiledBinding HowConfiguredText}" />

      </StackPanel>
    </ScrollViewer>

  </Panel>

</local:SettingsPageViewBase>
