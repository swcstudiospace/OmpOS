<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Autonogrammer.Native.Views.Completion.InlineCompletionBox">

  <StackPanel Spacing="{DynamicResource Autonogrammer.Gap.Xs}">

    <Grid>
      <TextBox x:Name="InputBox"
               AcceptsReturn="True"
               TextWrapping="Wrap"
               BorderThickness="1"
               Padding="8,6"
               MinHeight="{DynamicResource Autonogrammer.Size.TargetMin}"
               Background="{DynamicResource Autonogrammer.Color.Surface}"
               Foreground="{DynamicResource Autonogrammer.Color.TextPrimary}"
               CaretBrush="{DynamicResource Autonogrammer.Color.TextPrimary}"
               AutomationProperties.Name="Message with suggestions" />

      <!-- The mirror draws over the text box while a suggestion shows. It never takes input, so clicks reach the text box. -->
      <Border x:Name="GhostHost"
              IsHitTestVisible="False"
              IsVisible="False"
              BorderThickness="1"
              BorderBrush="Transparent"
              Padding="8,6">
        <TextBlock x:Name="GhostText"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource Autonogrammer.Color.TextPrimary}"
                   AutomationProperties.Name="Suggested completion" />
      </Border>
    </Grid>

    <TextBlock x:Name="UnavailableText"
               Classes="muted"
               IsVisible="False"
               FontSize="{DynamicResource Autonogrammer.Font.Size.Label}"
               TextWrapping="Wrap"
               Text="Suggestions are unavailable: the provider did not answer."
               AutomationProperties.Name="Suggestion status"
               AutomationProperties.LiveSetting="Polite" />

  </StackPanel>

</UserControl>
