<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Autonogrammer.Native.Views.Cowork.ProjectsView"
             x:Name="ProjectsRoot"
             Focusable="True"
             IsTabStop="False"
             AutomationProperties.Name="Projects">
  <StackPanel Spacing="{DynamicResource Autonogrammer.Gap.Sm}">
    <TextBlock x:Name="Heading"
               Text="Projects"
               AutomationProperties.Name="Projects" />
    <TextBlock x:Name="StatusText"
               AutomationProperties.LiveSetting="Polite"
               AutomationProperties.Name="Project status" />
    <ListBox x:Name="ProjectRows"
             TabIndex="1"
             AutomationProperties.Name="Project list" />
    <TextBox x:Name="NameBox"
             TabIndex="2"
             MinHeight="{DynamicResource Autonogrammer.Size.TargetMin}"
             AutomationProperties.Name="Project name" />
    <Button x:Name="RenameButton"
            TabIndex="3"
            Content="Rename"
            MinHeight="{DynamicResource Autonogrammer.Size.TargetMin}"
            MinWidth="{DynamicResource Autonogrammer.Size.TargetMin}"
            AutomationProperties.Name="Rename project" />
    <Button x:Name="ArchiveButton"
            TabIndex="4"
            Content="Archive"
            MinHeight="{DynamicResource Autonogrammer.Size.TargetMin}"
            MinWidth="{DynamicResource Autonogrammer.Size.TargetMin}"
            AutomationProperties.Name="Archive project" />
    <Button x:Name="PrepareDeleteButton"
            TabIndex="5"
            Content="Delete"
            MinHeight="{DynamicResource Autonogrammer.Size.TargetMin}"
            MinWidth="{DynamicResource Autonogrammer.Size.TargetMin}"
            AutomationProperties.Name="Delete project" />
    <TextBlock x:Name="ConfirmText"
               AutomationProperties.Name="Delete confirmation" />
    <Button x:Name="ConfirmDeleteButton"
            TabIndex="6"
            Content="Confirm delete"
            MinHeight="{DynamicResource Autonogrammer.Size.TargetMin}"
            MinWidth="{DynamicResource Autonogrammer.Size.TargetMin}"
            AutomationProperties.Name="Confirm delete" />
  </StackPanel>
</UserControl>
