<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Autonogrammer.Native.Views.Cowork.Artifacts.ArtifactPanelView"
             Focusable="False"
             AutomationProperties.Name="Artifact">
  <ScrollViewer>
    <StackPanel Margin="8"
                Spacing="{DynamicResource Autonogrammer.Gap.Sm}">
      <TextBlock x:Name="ChromeLabel"
                 TextWrapping="Wrap"
                 AutomationProperties.Name="Panel label" />
      <TextBlock x:Name="HeadingText"
                 TextWrapping="Wrap"
                 FontWeight="SemiBold" />
      <TextBlock x:Name="StatusText"
                 TextWrapping="Wrap"
                 AutomationProperties.Name="Sandbox status" />
      <Border x:Name="Banner"
              IsVisible="False"
              Padding="8"
              BorderThickness="1"
              BorderBrush="{DynamicResource Autonogrammer.Color.Border}"
              AutomationProperties.Name="Access banner">
        <StackPanel Spacing="{DynamicResource Autonogrammer.Gap.Sm}">
          <TextBlock x:Name="BannerText"
                     TextWrapping="Wrap" />
          <Button x:Name="ReviewAccessButton"
                  Content="Review access"
                  MinHeight="{DynamicResource Autonogrammer.Size.TargetMin}"
                  MinWidth="{DynamicResource Autonogrammer.Size.TargetMin}"
                  IsTabStop="True"
                  AutomationProperties.Name="Review access" />
        </StackPanel>
      </Border>
      <WrapPanel x:Name="ToolbarPanel"
                 AutomationProperties.Name="Artifact toolbar">
        <Button x:Name="DiffButton"
                Content="Diff"
                MinHeight="{DynamicResource Autonogrammer.Size.TargetMin}"
                MinWidth="{DynamicResource Autonogrammer.Size.TargetMin}"
                IsTabStop="True"
                AutomationProperties.Name="Diff" />
        <Button x:Name="CopyButton"
                Content="Copy"
                MinHeight="{DynamicResource Autonogrammer.Size.TargetMin}"
                MinWidth="{DynamicResource Autonogrammer.Size.TargetMin}"
                IsTabStop="True"
                AutomationProperties.Name="Copy" />
        <Button x:Name="ExportButton"
                Content="Export"
                MinHeight="{DynamicResource Autonogrammer.Size.TargetMin}"
                MinWidth="{DynamicResource Autonogrammer.Size.TargetMin}"
                IsTabStop="True"
                AutomationProperties.Name="Export" />
        <Button x:Name="EditButton"
                Content="Edit"
                MinHeight="{DynamicResource Autonogrammer.Size.TargetMin}"
                MinWidth="{DynamicResource Autonogrammer.Size.TargetMin}"
                IsTabStop="True"
                AutomationProperties.Name="Edit" />
        <Button x:Name="AccessButton"
                Content="Access"
                MinHeight="{DynamicResource Autonogrammer.Size.TargetMin}"
                MinWidth="{DynamicResource Autonogrammer.Size.TargetMin}"
                IsTabStop="True"
                AutomationProperties.Name="Access" />
        <Button x:Name="StopButton"
                Content="Stop"
                MinHeight="{DynamicResource Autonogrammer.Size.TargetMin}"
                MinWidth="{DynamicResource Autonogrammer.Size.TargetMin}"
                IsTabStop="True"
                AutomationProperties.Name="Stop" />
        <Button x:Name="CloseButton"
                Content="Close"
                MinHeight="{DynamicResource Autonogrammer.Size.TargetMin}"
                MinWidth="{DynamicResource Autonogrammer.Size.TargetMin}"
                IsTabStop="True"
                AutomationProperties.Name="Close" />
      </WrapPanel>
      <TextBlock x:Name="Announcement"
                 TextWrapping="Wrap"
                 AutomationProperties.LiveSetting="Polite"
                 AutomationProperties.Name="Artifact status" />
      <StackPanel x:Name="DiffPanel"
                  IsVisible="False"
                  Spacing="2"
                  AutomationProperties.Name="Diff against the previous version" />
      <HyperlinkButton x:Name="SkipLink"
                       Content="Skip generated content"
                       IsVisible="False"
                       IsTabStop="True"
                       AutomationProperties.Name="Skip generated content" />
      <Border x:Name="FrameBorder"
              IsVisible="False"
              MinHeight="240"
              BorderThickness="1"
              BorderBrush="{DynamicResource Autonogrammer.Color.BorderStrong}">
        <ContentControl x:Name="FrameContent" />
      </Border>
      <Button x:Name="ReturnButton"
              Content="Return to chat"
              IsVisible="False"
              MinHeight="{DynamicResource Autonogrammer.Size.TargetMin}"
              MinWidth="{DynamicResource Autonogrammer.Size.TargetMin}"
              IsTabStop="True"
              AutomationProperties.Name="Return to chat" />
      <ContentControl x:Name="AccessHost" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
