<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:cloud="clr-namespace:Autonogrammer.Presentation.Cloud;assembly=Autonogrammer.Presentation"
        x:Class="Autonogrammer.Native.Views.Cloud.CloudHandoffWindow"
        Title="{x:Static cloud:CloudCopy.HandoffTitle}"
        Icon="avares://Autonogrammer.Native.Views/Assets/Brand/autonogrammer-mark-256.png"
        Width="560"
        MinWidth="420"
        SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        Background="{DynamicResource Autonogrammer.Color.Surface}"
        WindowStartupLocation="CenterOwner"
        AutomationProperties.Name="{x:Static cloud:CloudCopy.HandoffTitle}" />
