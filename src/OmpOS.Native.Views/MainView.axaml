<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:OmpOS.Native.Views"
             x:Class="OmpOS.Native.MainView">

  <!-- Logical and keyboard order follows XAML order: skip link, session list, transcript (or the Agents or tool view that opens in
       its place), run controls, prompt, send, stop, then transcript search, the Agents and side-chat toggles, the workspace tool
       toggles, and the side-chat region. -->
  <DockPanel>

    <Button x:Name="SkipLink"
            DockPanel.Dock="Top"
            HorizontalAlignment="Left"
            MinHeight="{DynamicResource OmpOS.Size.TargetMin}"
            Padding="{DynamicResource OmpOS.Space.Sm}"
            Margin="{DynamicResource OmpOS.Space.Sm}"
            Content="Skip to conversation"
            AutomationProperties.Name="Skip to conversation"
            Click="OnSkipLinkClick" />

    <Grid ColumnDefinitions="Auto,*">

      <Border Grid.Column="0"
              Width="{DynamicResource OmpOS.Size.SessionListWidth}"
              Background="{DynamicResource OmpOS.Color.SurfaceRaised}"
              Padding="{DynamicResource OmpOS.Space.Sm}">
        <views:ConversationListView x:Name="ConversationList" />
      </Border>

      <Grid Grid.Column="1" RowDefinitions="*,Auto,Auto,Auto,Auto,Auto,Auto,Auto">

        <Grid Grid.Row="0">
          <ContentControl x:Name="TranscriptHost" />
          <ContentControl x:Name="AgentsHost"
                          IsVisible="False" />
          <ContentControl x:Name="ToolHost"
                          IsVisible="False" />
        </Grid>

        <TextBlock x:Name="StatusLine"
                   Grid.Row="1"
                   Classes="muted"
                   Margin="{DynamicResource OmpOS.Space.Xs}"
                   Padding="{DynamicResource OmpOS.Space.Md}"
                   FontSize="{DynamicResource OmpOS.Font.Size.Label}"
                   TextWrapping="Wrap"
                   IsVisible="False"
                   AutomationProperties.Name="Session status"
                   AutomationProperties.LiveSetting="Polite" />

        <ContentControl x:Name="RunControlsHost"
                        Grid.Row="2" />

        <ContentControl x:Name="ComposerHost"
                        Grid.Row="3" />

        <ContentControl x:Name="SearchHost"
                        Grid.Row="4" />

        <StackPanel Grid.Row="5"
                    Orientation="Horizontal"
                    Margin="{DynamicResource OmpOS.Space.Sm}"
                    Spacing="{DynamicResource OmpOS.Gap.Sm}">
          <ToggleButton x:Name="AgentsToggle"
                        Content="Agents"
                        MinHeight="{DynamicResource OmpOS.Size.TargetMin}"
                        AutomationProperties.Name="Agents" />
          <ToggleButton x:Name="SideChatsToggle"
                        Content="Side chats"
                        MinHeight="{DynamicResource OmpOS.Size.TargetMin}"
                        AutomationProperties.Name="Show side chats" />
        </StackPanel>

        <!-- Each tool replaces the transcript in the host above. Opening one closes the others and the Agents view. -->
        <WrapPanel Grid.Row="6"
                   Margin="{DynamicResource OmpOS.Space.Sm}">
          <ToggleButton x:Name="EditorToggle"
                        Content="Editor"
                        Margin="{DynamicResource OmpOS.Space.Xs}"
                        MinHeight="{DynamicResource OmpOS.Size.TargetMin}"
                        AutomationProperties.Name="Editor" />
          <ToggleButton x:Name="ExplorerToggle"
                        Content="Explorer"
                        Margin="{DynamicResource OmpOS.Space.Xs}"
                        MinHeight="{DynamicResource OmpOS.Size.TargetMin}"
                        AutomationProperties.Name="Explorer" />
          <ToggleButton x:Name="TerminalToggle"
                        Content="Terminal"
                        Margin="{DynamicResource OmpOS.Space.Xs}"
                        MinHeight="{DynamicResource OmpOS.Size.TargetMin}"
                        AutomationProperties.Name="Terminal" />
          <ToggleButton x:Name="DiffToggle"
                        Content="Diff review"
                        Margin="{DynamicResource OmpOS.Space.Xs}"
                        MinHeight="{DynamicResource OmpOS.Size.TargetMin}"
                        AutomationProperties.Name="Diff review" />
          <ToggleButton x:Name="InlineEditToggle"
                        Content="Inline edit"
                        Margin="{DynamicResource OmpOS.Space.Xs}"
                        MinHeight="{DynamicResource OmpOS.Size.TargetMin}"
                        AutomationProperties.Name="Inline edit" />
          <ToggleButton x:Name="ConventionsToggle"
                        Content="Conventions"
                        Margin="{DynamicResource OmpOS.Space.Xs}"
                        MinHeight="{DynamicResource OmpOS.Size.TargetMin}"
                        AutomationProperties.Name="Workspace conventions" />
          <ToggleButton x:Name="McpToggle"
                        Content="MCP tools"
                        Margin="{DynamicResource OmpOS.Space.Xs}"
                        MinHeight="{DynamicResource OmpOS.Size.TargetMin}"
                        AutomationProperties.Name="MCP tools" />
          <ToggleButton x:Name="WorkspaceSearchToggle"
                        Content="Workspace search"
                        Margin="{DynamicResource OmpOS.Space.Xs}"
                        MinHeight="{DynamicResource OmpOS.Size.TargetMin}"
                        AutomationProperties.Name="Workspace search" />
          <ToggleButton x:Name="ExportToggle"
                        Content="Export"
                        Margin="{DynamicResource OmpOS.Space.Xs}"
                        MinHeight="{DynamicResource OmpOS.Size.TargetMin}"
                        AutomationProperties.Name="Transcript export" />
          <ToggleButton x:Name="SuggestionsToggle"
                        Content="Inline suggestions"
                        Margin="{DynamicResource OmpOS.Space.Xs}"
                        MinHeight="{DynamicResource OmpOS.Size.TargetMin}"
                        AutomationProperties.Name="Inline suggestions" />
        </WrapPanel>

        <ContentControl x:Name="SideChatHost"
                        Grid.Row="7"
                        IsVisible="False" />

      </Grid>

    </Grid>

  </DockPanel>

</UserControl>
