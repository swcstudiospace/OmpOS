<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:auto="clr-namespace:OmpOS.Presentation.Automations;assembly=OmpOS.Presentation"
             xmlns:local="clr-namespace:OmpOS.Native.Views.Automations"
             x:Class="OmpOS.Native.Views.Automations.AutomationEditorView"
             x:DataType="auto:AutomationEditorModel"
             Focusable="False">

  <UserControl.Styles>
    <StyleInclude Source="avares://OmpOS.Native.Views/Views/AgentPanel/PanelStyles.axaml" />
    <StyleInclude Source="avares://OmpOS.Native.Views/Views/Settings/SettingsStyles.axaml" />
  </UserControl.Styles>

  <!-- The automation editor. Keyboard order follows XAML order: the webhook secret panel when a secret is shown, name, prompt, enabled,
       time zone, schedule and its preview, webhook, target, repositories and the cloud settings, limits, Save, Cancel. A field message shows
       under its field and never repeats what was typed. The only place a secret value appears is the reveal-once panel. -->
  <StackPanel Spacing="{DynamicResource OmpOS.Gap.Sm}">

    <TextBlock x:Name="EditorTitle"
               Classes="settings-section" />

    <!-- The webhook secret, shown once. It stays until the user confirms it is stored. -->
    <Border x:Name="SecretPanel"
            Classes="banner"
            AutomationProperties.LiveSetting="Assertive"
            AutomationProperties.Name="{x:Static auto:AutomationsCopy.SecretHeading}">
      <StackPanel Spacing="{DynamicResource OmpOS.Gap.Sm}">
        <TextBlock Classes="settings-label"
                   Text="{x:Static auto:AutomationsCopy.SecretHeading}" />
        <TextBlock Classes="settings-body"
                   Text="{x:Static auto:AutomationsCopy.SecretBody}" />
        <SelectableTextBlock x:Name="SecretValueText"
                             Classes="settings-selectable settings-mono"
                             Text="{CompiledBinding RevealedSecret}"
                             AutomationProperties.Name="{x:Static auto:AutomationsCopy.SecretValueName}" />
        <WrapPanel Orientation="Horizontal">
          <Button x:Name="CopySecretButton"
                  Margin="0,0,8,0"
                  Content="{x:Static auto:AutomationsCopy.CopySecretLabel}"
                  AutomationProperties.Name="{x:Static auto:AutomationsCopy.CopySecretLabel}"
                  MinHeight="{DynamicResource OmpOS.Size.TargetMin}"
                  MinWidth="{DynamicResource OmpOS.Size.TargetMin}"
                  Click="OnCopySecretClick" />
          <Button x:Name="StoredSecretButton"
                  Content="{x:Static auto:AutomationsCopy.StoredSecretLabel}"
                  AutomationProperties.Name="{x:Static auto:AutomationsCopy.StoredSecretLabel}"
                  MinHeight="{DynamicResource OmpOS.Size.TargetMin}"
                  MinWidth="{DynamicResource OmpOS.Size.TargetMin}"
                  Click="OnStoredSecretClick" />
        </WrapPanel>
        <TextBlock x:Name="SecretCopiedText"
                   Classes="settings-help"
                   AutomationProperties.LiveSetting="Polite"
                   AutomationProperties.Name="{x:Static auto:AutomationsCopy.SecretCopied}" />
      </StackPanel>
    </Border>

    <StackPanel x:Name="FormFields"
                IsEnabled="{CompiledBinding !IsSaving}"
                Spacing="{DynamicResource OmpOS.Gap.Sm}">

      <TextBlock Classes="settings-label"
                 Text="{x:Static auto:AutomationsCopy.NameLabel}" />
      <TextBox x:Name="NameBox"
               Classes.invalid="{CompiledBinding NameError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
               Text="{CompiledBinding Name, Mode=TwoWay}"
               MinHeight="{DynamicResource OmpOS.Size.TargetMin}"
               AutomationProperties.Name="{x:Static auto:AutomationsCopy.NameLabel}" />
      <TextBlock x:Name="NameErrorText"
                 Classes="tone-error small"
                 IsVisible="{CompiledBinding NameError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                 Text="{CompiledBinding NameError}"
                 AutomationProperties.LiveSetting="Assertive"
                 AutomationProperties.Name="{x:Static auto:AutomationsCopy.FieldProblemName}" />

      <TextBlock Classes="settings-label"
                 Text="{x:Static auto:AutomationsCopy.PromptLabel}" />
      <TextBox x:Name="PromptBox"
               Classes.invalid="{CompiledBinding PromptError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
               Text="{CompiledBinding Prompt, Mode=TwoWay}"
               AcceptsReturn="True"
               TextWrapping="Wrap"
               MinHeight="120"
               AutomationProperties.Name="{x:Static auto:AutomationsCopy.PromptLabel}" />
      <TextBlock Classes="settings-help"
                 Text="{x:Static auto:AutomationsCopy.PromptHelp}" />
      <TextBlock x:Name="PromptErrorText"
                 Classes="tone-error small"
                 IsVisible="{CompiledBinding PromptError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                 Text="{CompiledBinding PromptError}"
                 AutomationProperties.LiveSetting="Assertive"
                 AutomationProperties.Name="{x:Static auto:AutomationsCopy.FieldProblemName}" />

      <CheckBox x:Name="EnabledBox"
                IsChecked="{CompiledBinding Enabled, Mode=TwoWay}"
                Content="{x:Static auto:AutomationsCopy.EnabledLabel}"
                AutomationProperties.Name="{x:Static auto:AutomationsCopy.EnabledLabel}" />

      <TextBlock Classes="settings-section"
                 Text="{x:Static auto:AutomationsCopy.TriggersHeading}" />
      <TextBlock x:Name="TriggersErrorText"
                 Classes="tone-error small"
                 IsVisible="{CompiledBinding TriggersError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                 Text="{CompiledBinding TriggersError}"
                 AutomationProperties.LiveSetting="Assertive"
                 AutomationProperties.Name="{x:Static auto:AutomationsCopy.FieldProblemName}" />

      <TextBlock Classes="settings-label"
                 Text="{x:Static auto:AutomationsCopy.TimeZoneLabel}" />
      <TextBox x:Name="TimeZoneBox"
               Classes="settings-mono"
               Text="{CompiledBinding TimeZone, Mode=TwoWay}"
               MinHeight="{DynamicResource OmpOS.Size.TargetMin}"
               AutomationProperties.Name="{x:Static auto:AutomationsCopy.TimeZoneLabel}" />
      <TextBlock Classes="settings-help"
                 Text="{x:Static auto:AutomationsCopy.TimeZoneHelp}" />

      <TextBlock Classes="settings-label"
                 Text="{x:Static auto:AutomationsCopy.CronLabel}" />
      <Grid ColumnDefinitions="*,Auto">
        <TextBox x:Name="CronBox"
                 Grid.Column="0"
                 Classes="settings-mono"
                 Classes.invalid="{CompiledBinding CronError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                 Text="{CompiledBinding CronText, Mode=TwoWay}"
                 MinHeight="{DynamicResource OmpOS.Size.TargetMin}"
                 AutomationProperties.Name="{x:Static auto:AutomationsCopy.CronLabel}" />
        <Button x:Name="PreviewButton"
                Grid.Column="1"
                Margin="8,0,0,0"
                Content="{x:Static auto:AutomationsCopy.PreviewCronLabel}"
                IsEnabled="{CompiledBinding !IsPreviewing}"
                AutomationProperties.Name="{x:Static auto:AutomationsCopy.PreviewCronLabel}"
                MinHeight="{DynamicResource OmpOS.Size.TargetMin}"
                MinWidth="{DynamicResource OmpOS.Size.TargetMin}"
                Click="OnPreviewClick" />
      </Grid>
      <TextBlock Classes="settings-help"
                 Text="{x:Static auto:AutomationsCopy.CronHelp}" />
      <TextBlock x:Name="CronErrorText"
                 Classes="tone-error small"
                 IsVisible="{CompiledBinding CronError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                 Text="{CompiledBinding CronError}"
                 AutomationProperties.LiveSetting="Assertive"
                 AutomationProperties.Name="{x:Static auto:AutomationsCopy.FieldProblemName}" />
      <TextBlock x:Name="CronPreviewErrorText"
                 Classes="tone-error small"
                 IsVisible="{CompiledBinding CronPreviewError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                 Text="{CompiledBinding CronPreviewError}"
                 AutomationProperties.LiveSetting="Assertive"
                 AutomationProperties.Name="{x:Static auto:AutomationsCopy.FieldProblemName}" />
      <TextBlock x:Name="CronPreviewHeading"
                 Classes="settings-label"
                 Text="{x:Static auto:AutomationsCopy.CronPreviewHeading}" />
      <ItemsControl x:Name="CronPreviewList"
                    AutomationProperties.LiveSetting="Polite"
                    AutomationProperties.Name="{x:Static auto:AutomationsCopy.CronPreviewName}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="x:String">
            <TextBlock Classes="settings-mono"
                       Text="{CompiledBinding .}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <CheckBox x:Name="WebhookEnabledBox"
                IsChecked="{CompiledBinding WebhookEnabled, Mode=TwoWay}"
                Content="{x:Static auto:AutomationsCopy.WebhookEnabledLabel}"
                AutomationProperties.Name="{x:Static auto:AutomationsCopy.WebhookEnabledLabel}" />
      <StackPanel x:Name="WebhookBlock"
                  IsVisible="{CompiledBinding WebhookEnabled}"
                  Spacing="{DynamicResource OmpOS.Gap.Sm}">
        <TextBlock Classes="settings-label"
                   Text="{x:Static auto:AutomationsCopy.WebhookFlavourLabel}" />
        <ComboBox x:Name="FlavourBox"
                  HorizontalAlignment="Stretch"
                  MinHeight="{DynamicResource OmpOS.Size.TargetMin}"
                  AutomationProperties.Name="{x:Static auto:AutomationsCopy.WebhookFlavourLabel}"
                  SelectionChanged="OnFlavourChanged">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="local:AutomationChoice">
              <TextBlock Text="{CompiledBinding Label}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>

        <StackPanel x:Name="GithubBlock"
                    IsVisible="{CompiledBinding IsGithubWebhook}"
                    Spacing="{DynamicResource OmpOS.Gap.Sm}">
          <TextBlock Classes="settings-label"
                     Text="{x:Static auto:AutomationsCopy.WebhookEventsLabel}" />
          <TextBox x:Name="EventsBox"
                   Classes="settings-mono"
                   Text="{CompiledBinding WebhookEventsText, Mode=TwoWay}"
                   MinHeight="{DynamicResource OmpOS.Size.TargetMin}"
                   AutomationProperties.Name="{x:Static auto:AutomationsCopy.WebhookEventsLabel}" />
          <TextBlock Classes="settings-help"
                     Text="{x:Static auto:AutomationsCopy.WebhookEventsHelp}" />
          <TextBlock Classes="settings-label"
                     Text="{x:Static auto:AutomationsCopy.WebhookActionsLabel}" />
          <TextBox x:Name="ActionsBox"
                   Classes="settings-mono"
                   Text="{CompiledBinding WebhookActionsText, Mode=TwoWay}"
                   MinHeight="{DynamicResource OmpOS.Size.TargetMin}"
                   AutomationProperties.Name="{x:Static auto:AutomationsCopy.WebhookActionsLabel}" />
          <TextBlock Classes="settings-help"
                     Text="{x:Static auto:AutomationsCopy.WebhookActionsHelp}" />
          <TextBlock Classes="settings-label"
                     Text="{x:Static auto:AutomationsCopy.WebhookBranchesLabel}" />
          <TextBox x:Name="BranchesBox"
                   Classes="settings-mono"
                   Text="{CompiledBinding WebhookBranchesText, Mode=TwoWay}"
                   MinHeight="{DynamicResource OmpOS.Size.TargetMin}"
                   AutomationProperties.Name="{x:Static auto:AutomationsCopy.WebhookBranchesLabel}" />
          <TextBlock Classes="settings-help"
                     Text="{x:Static auto:AutomationsCopy.WebhookBranchesHelp}" />
        </StackPanel>

        <TextBlock x:Name="WebhookErrorText"
                   Classes="tone-error small"
                   IsVisible="{CompiledBinding WebhookError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                   Text="{CompiledBinding WebhookError}"
                   AutomationProperties.LiveSetting="Assertive"
                   AutomationProperties.Name="{x:Static auto:AutomationsCopy.FieldProblemName}" />
        <TextBlock x:Name="WebhookPathText"
                   Classes="settings-mono" />
        <Button x:Name="RotateButton"
                HorizontalAlignment="Left"
                Content="{x:Static auto:AutomationsCopy.RotateSecretLabel}"
                IsEnabled="{CompiledBinding CanRotateSecret}"
                AutomationProperties.Name="{x:Static auto:AutomationsCopy.RotateSecretLabel}"
                MinHeight="{DynamicResource OmpOS.Size.TargetMin}"
                MinWidth="{DynamicResource OmpOS.Size.TargetMin}"
                Click="OnRotateClick" />
      </StackPanel>

      <TextBlock Classes="settings-section"
                 Text="{x:Static auto:AutomationsCopy.TargetHeading}" />
      <TextBlock Classes="settings-label"
                 Text="{x:Static auto:AutomationsCopy.TargetKindLabel}" />
      <ComboBox x:Name="TargetBox"
                HorizontalAlignment="Stretch"
                MinHeight="{DynamicResource OmpOS.Size.TargetMin}"
                AutomationProperties.Name="{x:Static auto:AutomationsCopy.TargetKindLabel}"
                SelectionChanged="OnTargetChanged">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="local:AutomationChoice">
            <TextBlock Text="{CompiledBinding Label}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <TextBlock x:Name="TargetErrorText"
                 Classes="tone-error small"
                 IsVisible="{CompiledBinding TargetError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                 Text="{CompiledBinding TargetError}"
                 AutomationProperties.LiveSetting="Assertive"
                 AutomationProperties.Name="{x:Static auto:AutomationsCopy.FieldProblemName}" />

      <StackPanel x:Name="CloudBlock"
                  IsVisible="{CompiledBinding IsCloudTarget}"
                  Spacing="{DynamicResource OmpOS.Gap.Sm}">
        <TextBlock Classes="settings-label"
                   Text="{x:Static auto:AutomationsCopy.RepositoriesLabel}" />
        <TextBox x:Name="RepositoriesBox"
                 Classes="settings-mono"
                 Classes.invalid="{CompiledBinding RepositoriesError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                 Text="{CompiledBinding RepositoriesText, Mode=TwoWay}"
                 AcceptsReturn="True"
                 TextWrapping="NoWrap"
                 MinHeight="80"
                 AutomationProperties.Name="{x:Static auto:AutomationsCopy.RepositoriesLabel}" />
        <TextBlock Classes="settings-help"
                   Text="{x:Static auto:AutomationsCopy.RepositoriesHelp}" />
        <TextBlock x:Name="RepositoriesErrorText"
                   Classes="tone-error small"
                   IsVisible="{CompiledBinding RepositoriesError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                   Text="{CompiledBinding RepositoriesError}"
                   AutomationProperties.LiveSetting="Assertive"
                   AutomationProperties.Name="{x:Static auto:AutomationsCopy.FieldProblemName}" />

        <TextBlock Classes="settings-label"
                   Text="{x:Static auto:AutomationsCopy.SecretRefsLabel}" />
        <TextBox x:Name="SecretRefsBox"
                 Classes="settings-mono"
                 Classes.invalid="{CompiledBinding SecretsError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                 Text="{CompiledBinding SecretRefsText, Mode=TwoWay}"
                 MinHeight="{DynamicResource OmpOS.Size.TargetMin}"
                 AutomationProperties.Name="{x:Static auto:AutomationsCopy.SecretRefsLabel}" />
        <TextBlock Classes="settings-help"
                   Text="{x:Static auto:AutomationsCopy.SecretRefsHelp}" />
        <TextBlock x:Name="SecretsErrorText"
                   Classes="tone-error small"
                   IsVisible="{CompiledBinding SecretsError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                   Text="{CompiledBinding SecretsError}"
                   AutomationProperties.LiveSetting="Assertive"
                   AutomationProperties.Name="{x:Static auto:AutomationsCopy.FieldProblemName}" />

        <TextBlock Classes="settings-label"
                   Text="{x:Static auto:AutomationsCopy.EnvironmentLabel}" />
        <TextBox x:Name="EnvironmentBox"
                 Classes="settings-mono"
                 Text="{CompiledBinding EnvironmentId, Mode=TwoWay}"
                 MinHeight="{DynamicResource OmpOS.Size.TargetMin}"
                 AutomationProperties.Name="{x:Static auto:AutomationsCopy.EnvironmentLabel}" />
        <TextBlock Classes="settings-label"
                   Text="{x:Static auto:AutomationsCopy.ModelLabel}" />
        <TextBox x:Name="ModelBox"
                 Classes="settings-mono"
                 Text="{CompiledBinding Model, Mode=TwoWay}"
                 MinHeight="{DynamicResource OmpOS.Size.TargetMin}"
                 AutomationProperties.Name="{x:Static auto:AutomationsCopy.ModelLabel}" />
        <TextBlock Classes="settings-label"
                   Text="{x:Static auto:AutomationsCopy.ModeLabel}" />
        <TextBox x:Name="ModeBox"
                 Classes="settings-mono"
                 Text="{CompiledBinding Mode, Mode=TwoWay}"
                 MinHeight="{DynamicResource OmpOS.Size.TargetMin}"
                 AutomationProperties.Name="{x:Static auto:AutomationsCopy.ModeLabel}" />
        <TextBlock Classes="settings-help"
                   Text="{x:Static auto:AutomationsCopy.HostDefaultHelp}" />

        <TextBlock Classes="settings-label"
                   Text="{x:Static auto:AutomationsCopy.AllowedToolsLabel}" />
        <CheckBox x:Name="AllowCreateBox"
                  IsChecked="{CompiledBinding AllowPullRequestCreate, Mode=TwoWay}"
                  Content="{x:Static auto:AutomationsCopy.AllowCreateLabel}"
                  AutomationProperties.Name="{x:Static auto:AutomationsCopy.AllowCreateLabel}" />
        <CheckBox x:Name="AllowCommentBox"
                  IsChecked="{CompiledBinding AllowPullRequestComment, Mode=TwoWay}"
                  Content="{x:Static auto:AutomationsCopy.AllowCommentLabel}"
                  AutomationProperties.Name="{x:Static auto:AutomationsCopy.AllowCommentLabel}" />
        <CheckBox x:Name="AllowReviewersBox"
                  IsChecked="{CompiledBinding AllowRequestReviewers, Mode=TwoWay}"
                  Content="{x:Static auto:AutomationsCopy.AllowReviewersLabel}"
                  AutomationProperties.Name="{x:Static auto:AutomationsCopy.AllowReviewersLabel}" />
      </StackPanel>

      <TextBlock Classes="settings-section"
                 Text="{x:Static auto:AutomationsCopy.LimitsHeading}" />
      <TextBlock Classes="settings-label"
                 Text="{x:Static auto:AutomationsCopy.MaxConcurrentLabel}" />
      <TextBox x:Name="ConcurrentBox"
               Classes="settings-mono"
               Text="{CompiledBinding MaxConcurrentRunsText, Mode=TwoWay}"
               MinHeight="{DynamicResource OmpOS.Size.TargetMin}"
               AutomationProperties.Name="{x:Static auto:AutomationsCopy.MaxConcurrentLabel}" />
      <TextBlock Classes="settings-label"
                 Text="{x:Static auto:AutomationsCopy.MaxRunsPerHourLabel}" />
      <TextBox x:Name="PerHourBox"
               Classes="settings-mono"
               Text="{CompiledBinding MaxRunsPerHourText, Mode=TwoWay}"
               MinHeight="{DynamicResource OmpOS.Size.TargetMin}"
               AutomationProperties.Name="{x:Static auto:AutomationsCopy.MaxRunsPerHourLabel}" />
      <TextBlock Classes="settings-label"
                 Text="{x:Static auto:AutomationsCopy.MaxRuntimeLabel}" />
      <TextBox x:Name="RuntimeBox"
               Classes="settings-mono"
               Text="{CompiledBinding MaxRuntimeMinutesText, Mode=TwoWay}"
               MinHeight="{DynamicResource OmpOS.Size.TargetMin}"
               AutomationProperties.Name="{x:Static auto:AutomationsCopy.MaxRuntimeLabel}" />
      <TextBlock x:Name="LimitsErrorText"
                 Classes="tone-error small"
                 IsVisible="{CompiledBinding LimitsError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                 Text="{CompiledBinding LimitsError}"
                 AutomationProperties.LiveSetting="Assertive"
                 AutomationProperties.Name="{x:Static auto:AutomationsCopy.FieldProblemName}" />
    </StackPanel>

    <TextBlock x:Name="WhyDisabledText"
               Classes="settings-help"
               IsVisible="{CompiledBinding WhyDisabled, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
               Text="{CompiledBinding WhyDisabled}" />
    <TextBlock x:Name="SaveFailureText"
               Classes="tone-error settings-body"
               IsVisible="{CompiledBinding SaveFailure, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
               Text="{CompiledBinding SaveFailure}"
               AutomationProperties.LiveSetting="Assertive"
               AutomationProperties.Name="{x:Static auto:AutomationsCopy.SaveFailureName}" />

    <StackPanel Orientation="Horizontal"
                Spacing="{DynamicResource OmpOS.Gap.Sm}">
      <Button x:Name="SaveButton"
              Classes="primary"
              Content="{x:Static auto:AutomationsCopy.SaveLabel}"
              IsEnabled="{CompiledBinding CanSave}"
              AutomationProperties.Name="{x:Static auto:AutomationsCopy.SaveLabel}"
              MinHeight="{DynamicResource OmpOS.Size.TargetMin}"
              MinWidth="{DynamicResource OmpOS.Size.TargetMin}"
              Click="OnSaveClick" />
      <Button x:Name="CancelButton"
              Content="{x:Static auto:AutomationsCopy.CancelLabel}"
              IsEnabled="{CompiledBinding !IsSaving}"
              AutomationProperties.Name="{x:Static auto:AutomationsCopy.CancelLabel}"
              MinHeight="{DynamicResource OmpOS.Size.TargetMin}"
              MinWidth="{DynamicResource OmpOS.Size.TargetMin}"
              Click="OnCancelClick" />
    </StackPanel>
  </StackPanel>

</UserControl>
