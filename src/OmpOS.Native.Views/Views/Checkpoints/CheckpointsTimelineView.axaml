<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cp="clr-namespace:OmpOS.Presentation.Checkpoints;assembly=OmpOS.Presentation"
             xmlns:local="clr-namespace:OmpOS.Native.Views.Checkpoints"
             x:Class="OmpOS.Native.Views.Checkpoints.CheckpointsTimelineView"
             x:DataType="cp:CheckpointsModel"
             IsVisible="{CompiledBinding IsOpen}"
             Focusable="False">

  <UserControl.Styles>
    <StyleInclude Source="avares://OmpOS.Native.Views/Views/AgentPanel/PanelStyles.axaml" />
    <StyleInclude Source="avares://OmpOS.Native.Views/Views/Settings/SettingsStyles.axaml" />
  </UserControl.Styles>

  <!-- The checkpoint timeline of one session: a row per turn in which the agent changed files, with Preview and Rewind on each row. A rewind
       never runs from a row: it opens the confirmation block, which says that only files are restored, lists what would change and waits for
       Confirm. Focus goes to Cancel when the block opens and comes back to the row's Rewind button when it closes. Esc cancels a pending
       confirmation, else closes the panel. Tab order is XAML order. The panel is hidden while the model is not open. -->
  <Border Classes="settings-card"
          AutomationProperties.Name="{x:Static cp:CheckpointsCopy.Title}">
    <StackPanel Spacing="{DynamicResource OmpOS.Gap.Sm}">

      <Grid ColumnDefinitions="*,Auto"
            ColumnSpacing="8">
        <StackPanel Grid.Column="0"
                    Orientation="Horizontal"
                    Spacing="{DynamicResource OmpOS.Gap.Sm}"
                    VerticalAlignment="Center">
          <TextBlock x:Name="PanelHeading"
                     Classes="settings-section"
                     VerticalAlignment="Center"
                     Text="{x:Static cp:CheckpointsCopy.Title}" />
          <TextBlock x:Name="CountLine"
                     Classes="settings-help"
                     VerticalAlignment="Center"
                     Text="{CompiledBinding CountText}" />
        </StackPanel>
        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="{DynamicResource OmpOS.Gap.Sm}">
          <Button x:Name="RefreshButton"
                  Content="{x:Static local:CheckpointsViewText.RefreshLabel}"
                  Command="{CompiledBinding RefreshCommand}"
                  MinHeight="{DynamicResource OmpOS.Size.TargetMin}"
                  MinWidth="{DynamicResource OmpOS.Size.TargetMin}"
                  AutomationProperties.Name="{x:Static local:CheckpointsViewText.RefreshName}"
                  Click="OnRefreshClick" />
          <Button x:Name="UndoButton"
                  Content="{x:Static local:CheckpointsViewText.UndoLastLabel}"
                  Command="{CompiledBinding UndoLastCommand}"
                  MinHeight="{DynamicResource OmpOS.Size.TargetMin}"
                  MinWidth="{DynamicResource OmpOS.Size.TargetMin}"
                  AutomationProperties.Name="{x:Static local:CheckpointsViewText.UndoLastName}"
                  Click="OnUndoClick" />
          <Button x:Name="CloseButton"
                  Content="{x:Static local:CheckpointsViewText.CloseLabel}"
                  MinHeight="{DynamicResource OmpOS.Size.TargetMin}"
                  MinWidth="{DynamicResource OmpOS.Size.TargetMin}"
                  AutomationProperties.Name="{x:Static local:CheckpointsViewText.CloseName}"
                  Click="OnCloseClick" />
        </StackPanel>
      </Grid>

      <!-- The confirmation block. It shows while a rewind waits, or after Preview on a row; the buttons show only while a rewind waits. The
           Overwrite button shows only when a file changed after the agent's last edit. -->
      <Border x:Name="DetailsCard"
              Classes="settings-card"
              IsVisible="False"
              AutomationProperties.Name="{x:Static local:CheckpointsViewText.ConfirmationName}">
        <StackPanel Spacing="{DynamicResource OmpOS.Gap.Sm}">
          <TextBlock x:Name="ConfirmationLine"
                     Classes="settings-body"
                     IsVisible="{CompiledBinding IsConfirming}"
                     Text="{CompiledBinding ConfirmationText}" />
          <ItemsControl x:Name="PreviewList"
                        ItemsSource="{CompiledBinding PreviewLines}"
                        AutomationProperties.Name="{x:Static local:CheckpointsViewText.PreviewListName}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <TextBlock Classes="settings-mono"
                           Margin="0,0,0,2"
                           Text="{CompiledBinding .}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <WrapPanel x:Name="ConfirmButtons"
                     Orientation="Horizontal"
                     ItemSpacing="{DynamicResource OmpOS.Gap.Sm}"
                     LineSpacing="{DynamicResource OmpOS.Gap.Sm}"
                     IsVisible="{CompiledBinding IsConfirming}">
            <Button x:Name="ConfirmButton"
                    Classes="destructive"
                    Content="{x:Static cp:CheckpointsCopy.RewindLabel}"
                    Command="{CompiledBinding ConfirmCommand}"
                    MinHeight="{DynamicResource OmpOS.Size.TargetMin}"
                    MinWidth="{DynamicResource OmpOS.Size.TargetMin}"
                    AutomationProperties.Name="{x:Static local:CheckpointsViewText.ConfirmName}" />
            <Button x:Name="ForceButton"
                    Classes="destructive"
                    Content="{x:Static cp:CheckpointsCopy.ForceLabel}"
                    Command="{CompiledBinding ForceCommand}"
                    IsVisible="{CompiledBinding CanForce}"
                    MinHeight="{DynamicResource OmpOS.Size.TargetMin}"
                    MinWidth="{DynamicResource OmpOS.Size.TargetMin}"
                    AutomationProperties.Name="{x:Static cp:CheckpointsCopy.ForceLabel}" />
            <Button x:Name="CancelButton"
                    Content="{x:Static cp:CheckpointsCopy.CancelLabel}"
                    Command="{CompiledBinding CancelCommand}"
                    MinHeight="{DynamicResource OmpOS.Size.TargetMin}"
                    MinWidth="{DynamicResource OmpOS.Size.TargetMin}"
                    AutomationProperties.Name="{x:Static local:CheckpointsViewText.CancelName}" />
          </WrapPanel>
        </StackPanel>
      </Border>

      <TextBlock x:Name="EmptyLine"
                 Classes="muted settings-body"
                 IsVisible="{CompiledBinding !HasCheckpoints}"
                 Text="{CompiledBinding EmptyText}" />

      <ScrollViewer Focusable="False"
                    MaxHeight="320"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
        <ItemsControl x:Name="RowList"
                      ItemsSource="{CompiledBinding Rows}"
                      AutomationProperties.Name="{x:Static local:CheckpointsViewText.RowsName}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="cp:CheckpointRow">
              <Grid ColumnDefinitions="Auto,*,Auto"
                    ColumnSpacing="8"
                    Margin="0,0,0,4"
                    MinHeight="{DynamicResource OmpOS.Size.TargetMin}"
                    ToolTip.Tip="{CompiledBinding FilesText}"
                    AutomationProperties.Name="{CompiledBinding RowName}">
                <TextBlock Grid.Column="0"
                           Classes="settings-mono"
                           VerticalAlignment="Center"
                           Text="{CompiledBinding TurnId, StringFormat='#{0}'}" />
                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center">
                  <TextBlock Classes="settings-label"
                             Text="{CompiledBinding Label}"
                             TextTrimming="CharacterEllipsis"
                             MaxLines="1" />
                  <StackPanel Orientation="Horizontal"
                              Spacing="{DynamicResource OmpOS.Gap.Sm}">
                    <TextBlock Classes="settings-help"
                               Text="{CompiledBinding TimeText}" />
                    <TextBlock Classes="settings-help"
                               Text="{CompiledBinding FilesText}"
                               TextTrimming="CharacterEllipsis"
                               MaxLines="1" />
                  </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            Spacing="{DynamicResource OmpOS.Gap.Sm}"
                            VerticalAlignment="Center">
                  <Button Classes="sm row-preview"
                          Content="{x:Static cp:CheckpointsCopy.PreviewLabel}"
                          MinHeight="{DynamicResource OmpOS.Size.TargetMin}"
                          MinWidth="{DynamicResource OmpOS.Size.TargetMin}"
                          AutomationProperties.Name="{CompiledBinding PreviewName}"
                          AttachedToVisualTree="OnRowButtonAttached"
                          Click="OnPreviewClick" />
                  <Button Classes="sm row-rewind"
                          Content="{x:Static cp:CheckpointsCopy.RewindLabel}"
                          MinHeight="{DynamicResource OmpOS.Size.TargetMin}"
                          MinWidth="{DynamicResource OmpOS.Size.TargetMin}"
                          AutomationProperties.Name="{CompiledBinding RewindName}"
                          AttachedToVisualTree="OnRowButtonAttached"
                          Click="OnRewindClick" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <!-- The status line: polite, assertive while it reports a failure. The view sets the live setting in code, because it follows HasError. -->
      <TextBlock x:Name="StatusLine"
                 Classes="settings-body"
                 Classes.tone-error="{CompiledBinding HasError}"
                 Text="{CompiledBinding StatusText}"
                 IsVisible="{CompiledBinding StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                 AutomationProperties.LiveSetting="Polite"
                 AutomationProperties.Name="{x:Static local:CheckpointsViewText.StatusName}" />

    </StackPanel>
  </Border>

</UserControl>
