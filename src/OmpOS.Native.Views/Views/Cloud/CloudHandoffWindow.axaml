<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:cloud="clr-namespace:OmpOS.Presentation.Cloud;assembly=OmpOS.Presentation"
        x:Class="OmpOS.Native.Views.Cloud.CloudHandoffWindow"
        Title="{x:Static cloud:CloudCopy.HandoffTitle}"
        Icon="avares://OmpOS.Native.Views/Assets/Brand/ompos-mark-256.png"
        Width="560"
        MinWidth="420"
        SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        Background="{DynamicResource OmpOS.Color.Surface}"
        WindowStartupLocation="CenterOwner"
        AutomationProperties.Name="{x:Static cloud:CloudCopy.HandoffTitle}" />
