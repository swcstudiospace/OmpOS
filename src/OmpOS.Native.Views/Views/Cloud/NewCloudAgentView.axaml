<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cloud="clr-namespace:OmpOS.Presentation.Cloud;assembly=OmpOS.Presentation"
             xmlns:local="clr-namespace:OmpOS.Native.Views.Cloud"
             x:Class="OmpOS.Native.Views.Cloud.NewCloudAgentView"
             x:DataType="cloud:NewCloudAgentModel"
             Focusable="False">

  <UserControl.Styles>
    <StyleInclude Source="avares://OmpOS.Native.Views/Views/AgentPanel/PanelStyles.axaml" />
    <StyleInclude Source="avares://OmpOS.Native.Views/Views/Settings/SettingsStyles.axaml" />
  </UserControl.Styles>

  <!-- The new cloud agent form. Keyboard order follows XAML order: name, repositories, branches, environment, model, secret names, idle time,
       first task, the cost confirmation, Create, Cancel. A field message shows under its field and never repeats what was typed. There is no
       field for a secret value anywhere in this form. Create stays disabled until the entries are valid and the cost is confirmed. -->
  <StackPanel Spacing="{DynamicResource OmpOS.Gap.Sm}">

    <TextBlock x:Name="DialogTitle"
               Classes="settings-section"
               Text="{x:Static cloud:CloudCopy.NewAgentTitle}"
               AutomationProperties.Name="{x:Static cloud:CloudCopy.NewAgentTitle}" />
    <TextBlock Classes="settings-help"
               Text="{x:Static cloud:CloudCopy.NewAgentDescription}" />

    <StackPanel x:Name="FormFields"
                IsEnabled="{CompiledBinding !IsCreating}"
                Spacing="{DynamicResource OmpOS.Gap.Sm}">

      <TextBlock Classes="settings-label"
                 Text="{x:Static cloud:CloudCopy.NameLabel}" />
      <TextBox x:Name="NameBox"
               Classes.invalid="{CompiledBinding NameError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
               Text="{CompiledBinding Name, Mode=TwoWay}"
               MinHeight="{DynamicResource OmpOS.Size.TargetMin}"
               AutomationProperties.Name="{x:Static cloud:CloudCopy.NameLabel}" />
      <TextBlock x:Name="NameErrorText"
                 Classes="tone-error small"
                 IsVisible="{CompiledBinding NameError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                 Text="{CompiledBinding NameError}" />

      <TextBlock Classes="settings-label"
                 Text="{x:Static cloud:CloudCopy.RepositoryEntryLabel}" />
      <Grid ColumnDefinitions="*,Auto">
        <TextBox x:Name="RepositoryBox"
                 Grid.Column="0"
                 Classes="settings-mono"
                 Classes.invalid="{CompiledBinding RepositoryEntryError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                 Text="{CompiledBinding RepositoryText, Mode=TwoWay}"
                 MinHeight="{DynamicResource OmpOS.Size.TargetMin}"
                 AutomationProperties.Name="{x:Static cloud:CloudCopy.RepositoryEntryLabel}" />
        <Button x:Name="AddRepositoryButton"
                Grid.Column="1"
                Margin="8,0,0,0"
                Content="{x:Static cloud:CloudCopy.AddRepositoryLabel}"
                IsEnabled="{CompiledBinding CanAddRepository}"
                AutomationProperties.Name="{x:Static cloud:CloudCopy.AddRepositoryLabel}"
                MinHeight="{DynamicResource OmpOS.Size.TargetMin}"
                MinWidth="{DynamicResource OmpOS.Size.TargetMin}"
                Click="OnAddRepositoryClick" />
      </Grid>
      <TextBlock Classes="settings-help"
                 Text="{x:Static cloud:CloudCopy.RepositoryEntryHelp}" />
      <TextBlock x:Name="RepositoryErrorText"
                 Classes="tone-error small"
                 IsVisible="{CompiledBinding RepositoryEntryError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                 Text="{CompiledBinding RepositoryEntryError}"
                 AutomationProperties.LiveSetting="Assertive"
                 AutomationProperties.Name="{x:Static cloud:CloudCopy.RepositoryProblemName}" />
      <TextBlock x:Name="NoRepositoriesText"
                 Classes="settings-help"
                 Text="{x:Static cloud:CloudCopy.NoRepositoriesAdded}" />
      <ItemsControl x:Name="RepositoryList"
                    AutomationProperties.Name="{x:Static cloud:CloudCopy.RepositoryListName}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="cloud:CloudRepository">
            <Grid ColumnDefinitions="*,Auto"
                  Margin="0,0,0,4">
              <TextBlock Grid.Column="0"
                         Classes="settings-mono"
                         VerticalAlignment="Center"
                         Text="{CompiledBinding DisplayName}" />
              <Button Grid.Column="1"
                      Classes="sm"
                      Content="{x:Static cloud:CloudCopy.RemoveLabel}"
                      AutomationProperties.Name="{CompiledBinding DisplayName, Converter={x:Static local:CloudNameConverters.RemoveRepository}}"
                      MinHeight="{DynamicResource OmpOS.Size.TargetMin}"
                      MinWidth="{DynamicResource OmpOS.Size.TargetMin}"
                      Click="OnRemoveRepositoryClick" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <TextBlock Classes="settings-label"
                 Text="{x:Static cloud:CloudCopy.BranchLabel}" />
      <TextBox x:Name="BranchBox"
               Classes="settings-mono"
               Classes.invalid="{CompiledBinding BranchError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
               Text="{CompiledBinding Branch, Mode=TwoWay}"
               MinHeight="{DynamicResource OmpOS.Size.TargetMin}"
               AutomationProperties.Name="{x:Static cloud:CloudCopy.BranchLabel}" />
      <TextBlock Classes="settings-help"
                 Text="{x:Static cloud:CloudCopy.BranchHelp}" />
      <TextBlock x:Name="BranchErrorText"
                 Classes="tone-error small"
                 IsVisible="{CompiledBinding BranchError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                 Text="{CompiledBinding BranchError}" />

      <TextBlock Classes="settings-label"
                 Text="{x:Static cloud:CloudCopy.BaseBranchLabel}" />
      <TextBox x:Name="BaseBranchBox"
               Classes="settings-mono"
               Classes.invalid="{CompiledBinding BaseBranchError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
               Text="{CompiledBinding BaseBranch, Mode=TwoWay}"
               MinHeight="{DynamicResource OmpOS.Size.TargetMin}"
               AutomationProperties.Name="{x:Static cloud:CloudCopy.BaseBranchLabel}" />
      <TextBlock Classes="settings-help"
                 Text="{x:Static cloud:CloudCopy.BaseBranchHelp}" />
      <TextBlock x:Name="BaseBranchErrorText"
                 Classes="tone-error small"
                 IsVisible="{CompiledBinding BaseBranchError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                 Text="{CompiledBinding BaseBranchError}" />

      <StackPanel x:Name="EnvironmentBlock"
                  IsVisible="{CompiledBinding HasEnvironments}"
                  Spacing="{DynamicResource OmpOS.Gap.Sm}">
        <TextBlock Classes="settings-label"
                   Text="{x:Static cloud:CloudCopy.EnvironmentLabel}" />
        <ComboBox x:Name="EnvironmentBox"
                  HorizontalAlignment="Stretch"
                  MinHeight="{DynamicResource OmpOS.Size.TargetMin}"
                  AutomationProperties.Name="{x:Static cloud:CloudCopy.EnvironmentLabel}"
                  SelectionChanged="OnEnvironmentChanged">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="cloud:CloudChoice">
              <TextBlock Text="{CompiledBinding Name}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </StackPanel>

      <StackPanel x:Name="ModelBlock"
                  IsVisible="{CompiledBinding HasModels}"
                  Spacing="{DynamicResource OmpOS.Gap.Sm}">
        <TextBlock Classes="settings-label"
                   Text="{x:Static cloud:CloudCopy.ModelLabel}" />
        <ComboBox x:Name="ModelBox"
                  HorizontalAlignment="Stretch"
                  MinHeight="{DynamicResource OmpOS.Size.TargetMin}"
                  AutomationProperties.Name="{x:Static cloud:CloudCopy.ModelLabel}"
                  SelectionChanged="OnModelChosen">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="cloud:CloudChoice">
              <TextBlock Text="{CompiledBinding Name}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </StackPanel>

      <TextBlock Classes="settings-label"
                 Text="{x:Static cloud:CloudCopy.SecretsLabel}" />
      <TextBlock Classes="settings-help"
                 Text="{x:Static cloud:CloudCopy.SecretsHelp}" />
      <Grid ColumnDefinitions="*,Auto">
        <TextBox x:Name="SecretBox"
                 Grid.Column="0"
                 Classes="settings-mono"
                 Classes.invalid="{CompiledBinding SecretEntryError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                 Text="{CompiledBinding SecretNameText, Mode=TwoWay}"
                 MinHeight="{DynamicResource OmpOS.Size.TargetMin}"
                 AutomationProperties.Name="{x:Static cloud:CloudCopy.SecretEntryLabel}" />
        <Button x:Name="AddSecretButton"
                Grid.Column="1"
                Margin="8,0,0,0"
                Content="{x:Static cloud:CloudCopy.AddSecretLabel}"
                IsEnabled="{CompiledBinding CanAddSecretName}"
                AutomationProperties.Name="{x:Static cloud:CloudCopy.AddSecretLabel}"
                MinHeight="{DynamicResource OmpOS.Size.TargetMin}"
                MinWidth="{DynamicResource OmpOS.Size.TargetMin}"
                Click="OnAddSecretClick" />
      </Grid>
      <TextBlock x:Name="SecretErrorText"
                 Classes="tone-error small"
                 IsVisible="{CompiledBinding SecretEntryError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                 Text="{CompiledBinding SecretEntryError}"
                 AutomationProperties.LiveSetting="Assertive"
                 AutomationProperties.Name="{x:Static cloud:CloudCopy.SecretProblemName}" />
      <Grid x:Name="KnownSecretBlock"
            ColumnDefinitions="*,Auto">
        <ComboBox x:Name="KnownSecretBox"
                  Grid.Column="0"
                  HorizontalAlignment="Stretch"
                  MinHeight="{DynamicResource OmpOS.Size.TargetMin}"
                  AutomationProperties.Name="{x:Static cloud:CloudCopy.KnownSecretLabel}" />
        <Button x:Name="AddKnownSecretButton"
                Grid.Column="1"
                Margin="8,0,0,0"
                Content="{x:Static cloud:CloudCopy.AddKnownSecretLabel}"
                AutomationProperties.Name="{x:Static cloud:CloudCopy.AddKnownSecretLabel}"
                MinHeight="{DynamicResource OmpOS.Size.TargetMin}"
                MinWidth="{DynamicResource OmpOS.Size.TargetMin}"
                Click="OnAddKnownSecretClick" />
      </Grid>
      <TextBlock x:Name="NoSecretsText"
                 Classes="settings-help"
                 Text="{x:Static cloud:CloudCopy.NoSecretsAdded}" />
      <ItemsControl x:Name="SecretList"
                    AutomationProperties.Name="{x:Static cloud:CloudCopy.SecretListName}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="x:String">
            <Grid ColumnDefinitions="*,Auto"
                  Margin="0,0,0,4">
              <TextBlock Grid.Column="0"
                         Classes="settings-mono"
                         VerticalAlignment="Center"
                         Text="{CompiledBinding .}" />
              <Button Grid.Column="1"
                      Classes="sm"
                      Content="{x:Static cloud:CloudCopy.RemoveLabel}"
                      AutomationProperties.Name="{CompiledBinding ., Converter={x:Static local:CloudNameConverters.RemoveSecret}}"
                      MinHeight="{DynamicResource OmpOS.Size.TargetMin}"
                      MinWidth="{DynamicResource OmpOS.Size.TargetMin}"
                      Click="OnRemoveSecretClick" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <TextBlock Classes="settings-label"
                 Text="{x:Static cloud:CloudCopy.IdleLabel}" />
      <TextBox x:Name="IdleBox"
               Classes.invalid="{CompiledBinding IdleError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
               Text="{CompiledBinding IdleMinutesText, Mode=TwoWay}"
               MinHeight="{DynamicResource OmpOS.Size.TargetMin}"
               AutomationProperties.Name="{x:Static cloud:CloudCopy.IdleLabel}" />
      <TextBlock Classes="settings-help"
                 Text="{x:Static cloud:CloudCopy.IdleHelp}" />
      <TextBlock x:Name="IdleErrorText"
                 Classes="tone-error small"
                 IsVisible="{CompiledBinding IdleError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                 Text="{CompiledBinding IdleError}" />

      <TextBlock Classes="settings-label"
                 Text="{x:Static cloud:CloudCopy.FirstTaskLabel}" />
      <TextBox x:Name="PromptBox"
               AcceptsReturn="True"
               TextWrapping="Wrap"
               MinHeight="72"
               Classes.invalid="{CompiledBinding PromptError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
               Text="{CompiledBinding Prompt, Mode=TwoWay}"
               AutomationProperties.Name="{x:Static cloud:CloudCopy.FirstTaskLabel}" />
      <TextBlock x:Name="PromptErrorText"
                 Classes="tone-error small"
                 IsVisible="{CompiledBinding PromptError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                 Text="{CompiledBinding PromptError}" />

      <!-- The cost confirmation: plain words about what is billed, and an explicit checkbox. Create cannot start before it is ticked. -->
      <Border x:Name="CostBlock"
              Classes="banner">
        <StackPanel Spacing="{DynamicResource OmpOS.Gap.Sm}">
          <TextBlock Classes="settings-label"
                     Text="{x:Static cloud:CloudCopy.CostHeading}" />
          <TextBlock x:Name="CostNoticeText"
                     Classes="settings-body"
                     Text="{CompiledBinding CostNotice}" />
          <CheckBox x:Name="CostConfirmBox"
                    IsChecked="{CompiledBinding CostConfirmed, Mode=TwoWay}"
                    Content="{x:Static cloud:CloudCopy.CostConfirmLabel}"
                    AutomationProperties.Name="{x:Static cloud:CloudCopy.CostConfirmLabel}" />
        </StackPanel>
      </Border>
    </StackPanel>

    <TextBlock x:Name="WhyDisabledText"
               Classes="settings-help"
               IsVisible="{CompiledBinding WhyDisabled, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
               Text="{CompiledBinding WhyDisabled}"
               AutomationProperties.Name="{x:Static cloud:CloudCopy.WhyDisabledName}" />
    <TextBlock x:Name="ResultText"
               Classes="settings-body"
               AutomationProperties.LiveSetting="Assertive"
               AutomationProperties.Name="{x:Static cloud:CloudCopy.ResultName}" />

    <StackPanel Orientation="Horizontal"
                Spacing="{DynamicResource OmpOS.Gap.Sm}">
      <Button x:Name="CreateButton"
              Classes="primary"
              IsEnabled="{CompiledBinding CanCreate}"
              AutomationProperties.Name="{x:Static cloud:CloudCopy.CreateLabel}"
              MinHeight="{DynamicResource OmpOS.Size.TargetMin}"
              MinWidth="{DynamicResource OmpOS.Size.TargetMin}"
              Click="OnCreateClick" />
      <Button x:Name="CancelButton"
              Content="{x:Static cloud:CloudCopy.CancelLabel}"
              IsEnabled="{CompiledBinding !IsCreating}"
              AutomationProperties.Name="{x:Static cloud:CloudCopy.CancelLabel}"
              MinHeight="{DynamicResource OmpOS.Size.TargetMin}"
              MinWidth="{DynamicResource OmpOS.Size.TargetMin}"
              Click="OnCancelClick" />
    </StackPanel>

  </StackPanel>

</UserControl>
