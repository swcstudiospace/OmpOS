<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="OmpOS.Native.Views.Blocks.UserMessageView"
             AutomationProperties.Name="User message">

  <Border Background="{DynamicResource OmpOS.Color.SurfaceRaised}"
          Padding="{DynamicResource OmpOS.Space.Sm}">
    <TextBlock x:Name="Body"
               TextWrapping="Wrap" />
  </Border>

</UserControl>
