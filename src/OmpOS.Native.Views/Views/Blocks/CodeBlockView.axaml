<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="OmpOS.Native.Views.Blocks.CodeBlockView"
             AutomationProperties.Name="Code block">

  <!-- A code block is a sunken card (parity spec 4.6): a 28 px header with the language at the left and the copy icon at the right,
       then the code in the mono face, scrolling sideways instead of wrapping. -->
  <Border Classes="card-sunken">
    <StackPanel>

      <Grid ColumnDefinitions="*,Auto"
            Height="28"
            Margin="12,0,4,0">
        <TextBlock x:Name="LanguageLabel"
                   Grid.Column="0"
                   Classes="muted small"
                   VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis"
                   MaxLines="1" />
        <Button x:Name="CopyButton"
                Grid.Column="1"
                Classes="ghost icon sm"
                VerticalAlignment="Center"
                AutomationProperties.Name="Copy code"
                ToolTip.Tip="Copy code">
          <Path Data="M5.5 5.5h7v7h-7ZM3.5 10.5v-7h7"
                Stretch="Uniform"
                Width="{DynamicResource OmpOS.Size.IconSize}"
                Height="{DynamicResource OmpOS.Size.IconSize}"
                StrokeLineCap="Round"
                StrokeJoin="Round"
                AutomationProperties.AccessibilityView="Raw" />
        </Button>
      </Grid>

      <!-- The line-number gutter sits outside the scroller so the numbers stay put while the code scrolls sideways. It is decoration: no hit
           area and raw to assistive technology, so a screen reader reads the code and not the numbers. The display switch hides it. -->
      <Grid ColumnDefinitions="Auto,*">
        <TextBlock x:Name="LineNumbers"
                   Grid.Column="0"
                   Classes="muted"
                   Margin="12,0,0,8"
                   TextAlignment="Right"
                   FontSize="{DynamicResource OmpOS.Font.Size.Mono}"
                   LineHeight="{DynamicResource OmpOS.Font.LineHeight.Mono}"
                   TextWrapping="NoWrap"
                   IsHitTestVisible="False"
                   AutomationProperties.AccessibilityView="Raw" />
        <ScrollViewer Grid.Column="1"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled">
          <TextBlock x:Name="CodeText"
                     Margin="12,0,12,8"
                     FontSize="{DynamicResource OmpOS.Font.Size.Mono}"
                     LineHeight="{DynamicResource OmpOS.Font.LineHeight.Mono}"
                     TextWrapping="NoWrap" />
        </ScrollViewer>
      </Grid>

    </StackPanel>
  </Border>

</UserControl>
