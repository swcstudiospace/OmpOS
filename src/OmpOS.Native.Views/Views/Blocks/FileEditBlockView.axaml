<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="OmpOS.Native.Views.Blocks.FileEditBlockView">

  <UserControl.Styles>
    <!-- Added and removed lines are tinted, and each also carries its sign, so colour is never the only signal. -->
    <Style Selector="Border.diff-line.added">
      <Setter Property="Background" Value="{DynamicResource OmpOS.Color.DiffAdded}" />
    </Style>
    <Style Selector="Border.diff-line.removed">
      <Setter Property="Background" Value="{DynamicResource OmpOS.Color.DiffRemoved}" />
    </Style>
    <Style Selector="TextBlock.diff-added">
      <Setter Property="Foreground" Value="{DynamicResource OmpOS.Color.StatusSuccess}" />
    </Style>
    <Style Selector="TextBlock.diff-removed">
      <Setter Property="Foreground" Value="{DynamicResource OmpOS.Color.StatusError}" />
    </Style>
  </UserControl.Styles>

  <!-- A file edit is a compact diff card (parity spec 4.6): a 32 px header with the file glyph, the path, the +n -n counts and the
       operation words; then the lines on the sunken surface in the mono face, with a line-number gutter, a sign column and a tint.
       The card shows its first eight lines and a ghost row opens the rest. -->
  <Border Classes="card"
          ClipToBounds="True">
    <StackPanel>

      <Border MinHeight="32"
              Padding="10,0"
              BorderThickness="0,0,0,1"
              BorderBrush="{DynamicResource OmpOS.Color.Border}">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto"
              ColumnSpacing="{DynamicResource OmpOS.Gap.Sm}">
          <Path Grid.Column="0"
                Data="M4 2h5.5L12.5 5v9h-8.5ZM9.5 2v3h3"
                Stroke="{DynamicResource OmpOS.Color.TextSecondary}"
                StrokeThickness="1.5"
                StrokeLineCap="Round"
                StrokeJoin="Round"
                Stretch="Uniform"
                Width="{DynamicResource OmpOS.Size.IconSizeSm}"
                Height="{DynamicResource OmpOS.Size.IconSizeSm}"
                VerticalAlignment="Center"
                AutomationProperties.AccessibilityView="Raw" />
          <TextBlock x:Name="PathText"
                     Grid.Column="1"
                     Classes="strong"
                     TextTrimming="CharacterEllipsis"
                     MaxLines="1"
                     VerticalAlignment="Center" />
          <StackPanel x:Name="Counts"
                      Grid.Column="2"
                      Orientation="Horizontal"
                      Spacing="{DynamicResource OmpOS.Gap.Compact}"
                      VerticalAlignment="Center">
            <TextBlock x:Name="AddedCount"
                       Classes="mono diff-added" />
            <TextBlock x:Name="RemovedCount"
                       Classes="mono diff-removed" />
          </StackPanel>
          <TextBlock x:Name="OperationText"
                     Grid.Column="3"
                     Classes="muted small"
                     VerticalAlignment="Center" />
        </Grid>
      </Border>

      <Border Background="{DynamicResource OmpOS.Color.SurfaceSunken}">
        <StackPanel>
          <ScrollViewer HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Disabled">
            <StackPanel x:Name="Sections" />
          </ScrollViewer>
          <Button x:Name="MoreButton"
                  Classes="ghost sm"
                  HorizontalAlignment="Left"
                  Margin="4,2"
                  IsVisible="False" />
        </StackPanel>
      </Border>

    </StackPanel>
  </Border>

</UserControl>
