<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="OmpOS.Native.Views.Blocks.DiffPlaceholderView"
             AutomationProperties.Name="Diff placeholder">

  <StackPanel Spacing="{DynamicResource OmpOS.Gap.Xs}">
    <TextBlock x:Name="PathText"
               FontWeight="{DynamicResource OmpOS.Font.Weight.Semibold}"
               TextWrapping="Wrap" />
    <TextBlock x:Name="ReasonText"
               Classes="muted"
               FontSize="{DynamicResource OmpOS.Font.Size.Label}"
               TextWrapping="Wrap" />
  </StackPanel>

</UserControl>
