<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:panel="clr-namespace:OmpOS.Native.Views.AgentPanel"
             x:Class="OmpOS.Native.Views.Blocks.ToolCallBlockView">

  <!-- A tool call is one quiet 28 px row on the thread surface, not a card (parity spec 4.6): the status glyph (it pulses while the
       call runs, under full motion), the tool phrase in the secondary text role, and the status words at the right. The glyph is
       decorative; the status is always also written in words. -->
  <Border MinHeight="28"
          Padding="4,0"
          CornerRadius="{DynamicResource OmpOS.Radius.Control}">
    <Grid ColumnDefinitions="Auto,*,Auto"
          ColumnSpacing="{DynamicResource OmpOS.Gap.Sm}">
      <panel:StageIcon x:Name="StatusGlyph"
                       Grid.Column="0"
                       VerticalAlignment="Center" />
      <TextBlock x:Name="ToolName"
                 Grid.Column="1"
                 Classes="muted"
                 TextTrimming="CharacterEllipsis"
                 MaxLines="1"
                 VerticalAlignment="Center" />
      <TextBlock x:Name="ToolStatus"
                 Grid.Column="2"
                 Classes="muted small"
                 VerticalAlignment="Center" />
    </Grid>
  </Border>

</UserControl>
