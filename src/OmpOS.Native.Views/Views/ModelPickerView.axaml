<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:composer="clr-namespace:OmpOS.Presentation.Composer;assembly=OmpOS.Presentation"
             x:Class="OmpOS.Native.Views.ModelPickerView"
             IsVisible="False">

  <UserControl.Styles>
    <!-- A provider heading in the list: it names a group and is not a choice. -->
    <Style Selector="TextBlock.heading">
      <Setter Property="Foreground" Value="{DynamicResource OmpOS.Color.TextSecondary}" />
      <Setter Property="FontSize" Value="{DynamicResource OmpOS.Font.Size.Label}" />
      <Setter Property="FontWeight" Value="{DynamicResource OmpOS.Font.Weight.Semibold}" />
    </Style>
  </UserControl.Styles>

  <!-- The model chip of the composer footer. It opens a flyout with a search box and the models grouped by provider. The popup has no
       animation, so reduced motion needs no class here. -->
  <Button x:Name="ChipButton"
          HorizontalContentAlignment="Left"
          MinHeight="{DynamicResource OmpOS.Size.TargetMin}"
          MinWidth="{DynamicResource OmpOS.Size.TargetMin}"
          Padding="{DynamicResource OmpOS.Space.Sm}"
          CornerRadius="{DynamicResource OmpOS.Radius.Md}"
          AutomationProperties.Name="Model">
    <StackPanel Orientation="Horizontal"
                Spacing="{DynamicResource OmpOS.Gap.Xs}">
      <TextBlock x:Name="LabelText"
                 FontFamily="{DynamicResource OmpOS.Font.Mono}"
                 FontSize="{DynamicResource OmpOS.Font.Size.Label}"
                 MaxWidth="{DynamicResource OmpOS.Size.SessionListWidth}"
                 TextTrimming="CharacterEllipsis"
                 MaxLines="1"
                 VerticalAlignment="Center" />
      <Path Data="M2 4 6 8 10 4"
            Stroke="{DynamicResource OmpOS.Color.TextSecondary}"
            StrokeThickness="1.5"
            Stretch="Uniform"
            Width="12"
            Height="12"
            VerticalAlignment="Center" />
    </StackPanel>

    <Button.Flyout>
      <Flyout Placement="TopEdgeAlignedLeft">
        <Grid RowDefinitions="Auto,*,Auto"
              RowSpacing="{DynamicResource OmpOS.Gap.Sm}"
              Width="{DynamicResource OmpOS.Size.StageFlyoutWidth}"
              MaxHeight="{DynamicResource OmpOS.Size.StageFlyoutMaxHeight}">

          <TextBox x:Name="SearchBox"
                   Grid.Row="0"
                   PlaceholderText="Search models"
                   MinHeight="{DynamicResource OmpOS.Size.TargetMin}"
                   Background="{DynamicResource OmpOS.Color.Surface}"
                   Foreground="{DynamicResource OmpOS.Color.TextPrimary}"
                   AutomationProperties.Name="Search models"
                   AutomationProperties.HelpText="Type to filter. Up and Down move through the models, Enter selects, Escape closes the list." />

          <!-- Focus stays in the search box: the arrow keys move the selection of this list from there, so the list takes no tab stop. -->
          <ListBox x:Name="ModelList"
                   Grid.Row="1"
                   Focusable="False"
                   AutomationProperties.Name="Models">
            <!-- No row takes focus (it stays in the search box), and a provider heading takes no pointer input either, so it cannot be selected. -->
            <ListBox.Styles>
              <Style Selector="ListBoxItem">
                <Setter Property="Focusable" Value="False" />
                <Setter Property="IsHitTestVisible" Value="{ReflectionBinding IsHeading, Converter={x:Static BoolConverters.Not}}" />
              </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="composer:ModelPickerRow">
                <Grid ColumnDefinitions="*,Auto"
                      ColumnSpacing="{DynamicResource OmpOS.Gap.Sm}"
                      AutomationProperties.Name="{CompiledBinding AutomationName}">
                  <TextBlock Grid.Column="0"
                             Text="{CompiledBinding Text}"
                             Classes.heading="{CompiledBinding IsHeading}"
                             TextTrimming="CharacterEllipsis"
                             MaxLines="1"
                             VerticalAlignment="Center" />
                  <Path Grid.Column="1"
                        IsVisible="{CompiledBinding IsCurrent}"
                        Data="M2 8 6 12 14 4"
                        Stroke="{DynamicResource OmpOS.Color.AccentPurple}"
                        StrokeThickness="2"
                        Stretch="Uniform"
                        Width="16"
                        Height="16"
                        VerticalAlignment="Center" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <!-- One live region: loading, a refused or failed switch, no match, or the identifier of the highlighted model. -->
          <TextBlock x:Name="StatusText"
                     Grid.Row="2"
                     Classes="muted"
                     FontFamily="{DynamicResource OmpOS.Font.Mono}"
                     FontSize="{DynamicResource OmpOS.Font.Size.Label}"
                     TextWrapping="Wrap"
                     AutomationProperties.Name="Model list status"
                     AutomationProperties.LiveSetting="Polite" />
        </Grid>
      </Flyout>
    </Button.Flyout>
  </Button>

</UserControl>
