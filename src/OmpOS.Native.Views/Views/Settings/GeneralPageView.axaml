<local:SettingsPageViewBase xmlns="https://github.com/avaloniaui"
                            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                            xmlns:set="clr-namespace:OmpOS.Presentation.Settings;assembly=OmpOS.Presentation"
                            xmlns:local="clr-namespace:OmpOS.Native.Views.Settings"
                            x:Class="OmpOS.Native.Views.Settings.GeneralPageView"
                            x:DataType="set:GeneralPage"
                            Focusable="False">

  <local:SettingsPageViewBase.Styles>
    <StyleInclude Source="avares://OmpOS.Native.Views/Views/AgentPanel/PanelStyles.axaml" />
    <StyleInclude Source="avares://OmpOS.Native.Views/Views/Settings/SettingsStyles.axaml" />
  </local:SettingsPageViewBase.Styles>

  <!-- The General page. Keyboard order follows XAML order: the motion list (one stop; Up and Down move the choice), then the privacy statement. -->
  <Panel>

    <local:PageStatusView x:Name="StateView" />

    <ScrollViewer x:Name="ReadyPanel"
                  Focusable="False"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="{DynamicResource OmpOS.Space.Lg}"
                  Spacing="{DynamicResource OmpOS.Gap.Sm}"
                  MaxWidth="640"
                  HorizontalAlignment="Left">

        <TextBlock Classes="settings-heading"
                   Text="{x:Static set:SettingsCopy.GeneralHeading}" />

        <TextBlock Classes="settings-label"
                   Margin="0,8,0,0"
                   Text="{x:Static set:SettingsCopy.MotionLabel}" />
        <TextBlock Classes="settings-help"
                   Text="{x:Static set:SettingsCopy.MotionHelp}" />
        <ListBox x:Name="MotionList"
                 SelectionMode="Single"
                 AutomationProperties.Name="{x:Static set:SettingsCopy.MotionLabel}" />

        <TextBlock x:Name="SaveFailedHeading"
                   Classes="tone-error settings-body"
                   IsVisible="{CompiledBinding HasError}"
                   Text="{x:Static set:SettingsCopy.SaveFailedHeading}"
                   AutomationProperties.LiveSetting="Assertive"
                   AutomationProperties.Name="{x:Static set:SettingsCopy.SaveFailedHeading}" />
        <TextBlock x:Name="SaveFailedBody"
                   Classes="tone-error settings-body"
                   IsVisible="{CompiledBinding HasError}"
                   Text="{CompiledBinding SaveError}" />

        <TextBlock Classes="settings-section"
                   Margin="0,16,0,0"
                   Text="{x:Static set:SettingsCopy.PrivacyHeading}" />
        <SelectableTextBlock x:Name="PrivacyText"
                             Classes="settings-selectable settings-body"
                             Text="{x:Static set:SettingsCopy.PrivacyStatement}"
                             AutomationProperties.Name="{x:Static set:SettingsCopy.PrivacyStatement}" />

      </StackPanel>
    </ScrollViewer>

  </Panel>

</local:SettingsPageViewBase>
