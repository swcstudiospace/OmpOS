<local:SettingsPageViewBase xmlns="https://github.com/avaloniaui"
                            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                            xmlns:set="clr-namespace:OmpOS.Presentation.Settings;assembly=OmpOS.Presentation"
                            xmlns:local="clr-namespace:OmpOS.Native.Views.Settings"
                            x:Class="OmpOS.Native.Views.Settings.GeneralPageView"
                            x:DataType="set:GeneralPage"
                            Focusable="False">

  <local:SettingsPageViewBase.Styles>
    <StyleInclude Source="avares://OmpOS.Native.Views/Views/AgentPanel/PanelStyles.axaml" />
    <StyleInclude Source="avares://OmpOS.Native.Views/Views/Settings/SettingsStyles.axaml" />
  </local:SettingsPageViewBase.Styles>

  <!-- The General page. Keyboard order follows XAML order: the theme list, the motion list (one stop; Up and Down move the choice), then the privacy statement. -->
  <Panel>

    <local:PageStatusView x:Name="StateView" />

    <ScrollViewer x:Name="ReadyPanel"
                  Focusable="False"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
      <StackPanel Classes="settings-column">

        <TextBlock Classes="settings-heading"
                   Text="{x:Static set:SettingsCopy.GeneralHeading}" />
        <TextBlock Classes="settings-description"
                   Text="{x:Static set:SettingsCopy.GeneralDescription}" />

        <!-- Theme (System, Light, Dark) and Motion are lists of three choices, each with its sentence. A choice is a draft until Save. -->
        <TextBlock Classes="settings-section"
                   Margin="0,8,0,0"
                   Text="{x:Static set:SettingsCopy.ThemeLabel}" />
        <TextBlock Classes="settings-help"
                   Text="{x:Static set:SettingsCopy.ThemeHelp}" />
        <Border Classes="card"
                Padding="{DynamicResource OmpOS.Space.Xs}">
          <ListBox x:Name="ThemeList"
                   SelectionMode="Single"
                   AutomationProperties.Name="{x:Static set:SettingsCopy.ThemeLabel}" />
        </Border>

        <TextBlock Classes="settings-section"
                   Margin="0,16,0,0"
                   Text="{x:Static set:SettingsCopy.MotionLabel}" />
        <TextBlock Classes="settings-help"
                   Text="{x:Static set:SettingsCopy.MotionHelp}" />
        <Border Classes="card"
                Padding="{DynamicResource OmpOS.Space.Xs}">
          <ListBox x:Name="MotionList"
                   SelectionMode="Single"
                   AutomationProperties.Name="{x:Static set:SettingsCopy.MotionLabel}" />
        </Border>

        <TextBlock x:Name="SaveFailedHeading"
                   Classes="tone-error settings-label"
                   IsVisible="{CompiledBinding HasError}"
                   Text="{x:Static set:SettingsCopy.SaveFailedHeading}"
                   AutomationProperties.LiveSetting="Assertive"
                   AutomationProperties.Name="{x:Static set:SettingsCopy.SaveFailedHeading}" />
        <TextBlock x:Name="SaveFailedBody"
                   Classes="tone-error small"
                   IsVisible="{CompiledBinding HasError}"
                   Text="{CompiledBinding SaveError}" />

        <TextBlock Classes="settings-section"
                   Margin="0,24,0,0"
                   Text="{x:Static set:SettingsCopy.PrivacyHeading}" />
        <SelectableTextBlock x:Name="PrivacyText"
                             Classes="settings-selectable settings-body"
                             Text="{x:Static set:SettingsCopy.PrivacyStatement}"
                             AutomationProperties.Name="{x:Static set:SettingsCopy.PrivacyStatement}" />

        <!-- About: the button opens the About window through the head. It is absent when the head has no About window. -->
        <TextBlock x:Name="AboutHeading"
                   Classes="settings-section"
                   Margin="0,24,0,0"
                   IsVisible="{CompiledBinding CanOpenAbout}"
                   Text="{x:Static set:SettingsCopy.AboutHeading}" />
        <Button x:Name="AboutButton"
                HorizontalAlignment="Left"
                MinHeight="{DynamicResource OmpOS.Size.TargetMin}"
                MinWidth="{DynamicResource OmpOS.Size.TargetMin}"
                IsVisible="{CompiledBinding CanOpenAbout}"
                Content="{x:Static set:SettingsCopy.AboutLabel}"
                AutomationProperties.Name="{x:Static set:SettingsCopy.AboutLabel}"
                AutomationProperties.HelpText="{x:Static set:SettingsCopy.AboutHelp}" />
        <TextBlock Classes="settings-help"
                   IsVisible="{CompiledBinding CanOpenAbout}"
                   Text="{x:Static set:SettingsCopy.AboutHelp}" />

      </StackPanel>
    </ScrollViewer>

  </Panel>

</local:SettingsPageViewBase>
