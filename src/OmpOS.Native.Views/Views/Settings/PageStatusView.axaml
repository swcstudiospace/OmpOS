<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:set="clr-namespace:OmpOS.Presentation.Settings;assembly=OmpOS.Presentation"
             xmlns:glyphs="clr-namespace:OmpOS.Presentation.AgentPanel;assembly=OmpOS.Presentation"
             xmlns:agent="clr-namespace:OmpOS.Native.Views.AgentPanel"
             x:Class="OmpOS.Native.Views.Settings.PageStatusView"
             Focusable="False">

  <UserControl.Styles>
    <StyleInclude Source="avares://OmpOS.Native.Views/Views/AgentPanel/PanelStyles.axaml" />
    <StyleInclude Source="avares://OmpOS.Native.Views/Views/Settings/SettingsStyles.axaml" />
  </UserControl.Styles>

  <!-- The state of a settings page that is not its controls: loading, or the load failed (with Try again).
       At most one block shows at a time. Plain text and one button; the live regions say what changed. -->
  <StackPanel Classes="settings-column">

    <TextBlock x:Name="LoadingText"
               Classes="muted settings-body"
               IsVisible="False"
               AutomationProperties.LiveSetting="Polite" />

    <StackPanel x:Name="ErrorBlock"
                IsVisible="False"
                Spacing="{DynamicResource OmpOS.Gap.Sm}"
                AutomationProperties.LiveSetting="Assertive">
      <TextBlock x:Name="ErrorHeading"
                 Classes="settings-section" />
      <Border Classes="banner"
              Background="{DynamicResource OmpOS.Color.DiffRemoved}">
        <StackPanel Orientation="Horizontal"
                    Spacing="{DynamicResource OmpOS.Gap.Sm}">
          <agent:StageIcon IconKey="{x:Static glyphs:StatusIcon.Cross}"
                           VerticalAlignment="Top" />
          <TextBlock x:Name="ErrorBody"
                     Classes="tone-error settings-body" />
        </StackPanel>
      </Border>
      <Button x:Name="RetryButton"
              Content="{x:Static set:SettingsCopy.RetryLabel}"
              Classes="sm"
              HorizontalAlignment="Left"
              AutomationProperties.Name="{x:Static set:SettingsCopy.RetryLabel}"
              Click="OnRetryClick" />
    </StackPanel>

  </StackPanel>

</UserControl>
