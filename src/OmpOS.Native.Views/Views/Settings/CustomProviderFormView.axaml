<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:OmpOS.Presentation.Settings.Models;assembly=OmpOS.Presentation"
             xmlns:local="clr-namespace:OmpOS.Native.Views.Settings"
             x:Class="OmpOS.Native.Views.Settings.CustomProviderFormView"
             x:DataType="models:CustomProviderDraft"
             Focusable="False">

  <UserControl.Styles>
    <StyleInclude Source="avares://OmpOS.Native.Views/Views/AgentPanel/PanelStyles.axaml" />
    <StyleInclude Source="avares://OmpOS.Native.Views/Views/Settings/SettingsStyles.axaml" />
  </UserControl.Styles>

  <!-- The custom provider form: every field of the draft with its message under it. Keyboard order follows XAML order. A message shows once
       its entry was changed or a save was tried. The key is not part of the form: it is added on the saved provider's card. -->
  <StackPanel Spacing="{DynamicResource OmpOS.Gap.Sm}">

    <TextBlock x:Name="FormTitle"
               Classes="settings-section"
               Text="{CompiledBinding Title}" />

    <!-- Where the draft came from, when it was started from a template. -->
    <TextBlock x:Name="TemplateNoteLine"
               Classes="settings-help"
               IsVisible="{CompiledBinding TemplateNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
               Text="{CompiledBinding TemplateNote}" />
    <TextBlock x:Name="TemplateRemarkLine"
               Classes="settings-help"
               IsVisible="{CompiledBinding TemplateRemark, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
               Text="{CompiledBinding TemplateRemark}" />

    <TextBlock Classes="settings-label"
               Text="{x:Static models:ModelsCopy.FieldDisplayName}" />
    <TextBox x:Name="DisplayNameBox"
             Text="{CompiledBinding DisplayName, Mode=TwoWay}"
             AutomationProperties.Name="{x:Static models:ModelsCopy.FieldDisplayName}" />
    <TextBlock x:Name="DisplayNameError"
               Classes="tone-error settings-body"
               IsVisible="{CompiledBinding DisplayNameError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
               Text="{CompiledBinding DisplayNameError}" />

    <TextBlock Classes="settings-label"
               Text="{x:Static models:ModelsCopy.FieldId}" />
    <TextBox x:Name="IdBox"
             Classes="settings-mono"
             Text="{CompiledBinding Id, Mode=TwoWay}"
             IsEnabled="{CompiledBinding !IsEditing}"
             AutomationProperties.Name="{x:Static models:ModelsCopy.FieldId}" />
    <TextBlock x:Name="IdError"
               Classes="tone-error settings-body"
               IsVisible="{CompiledBinding IdError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
               Text="{CompiledBinding IdError}" />

    <TextBlock Classes="settings-label"
               Text="{x:Static models:ModelsCopy.FieldProtocol}" />
    <ComboBox x:Name="ProtocolBox"
              HorizontalAlignment="Stretch"
              AutomationProperties.Name="{x:Static models:ModelsCopy.FieldProtocol}" />

    <TextBlock Classes="settings-label"
               Text="{x:Static models:ModelsCopy.FieldEndpoint}" />
    <TextBox x:Name="EndpointBox"
             Classes="settings-mono"
             Text="{CompiledBinding EndpointText, Mode=TwoWay}"
             AutomationProperties.Name="{x:Static models:ModelsCopy.FieldEndpoint}" />
    <TextBlock x:Name="EndpointHint"
               Classes="settings-help"
               Text="{CompiledBinding EndpointHint}" />
    <TextBlock x:Name="EndpointError"
               Classes="tone-error settings-body"
               IsVisible="{CompiledBinding EndpointError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
               Text="{CompiledBinding EndpointError}" />

    <TextBlock Classes="settings-label"
               Text="{x:Static models:ModelsCopy.FieldAuth}" />
    <ComboBox x:Name="AuthBox"
              HorizontalAlignment="Stretch"
              AutomationProperties.Name="{x:Static models:ModelsCopy.FieldAuth}" />

    <TextBlock Classes="settings-label"
               Text="{x:Static models:ModelsCopy.FieldModels}" />
    <TextBox x:Name="ModelsBox"
             Classes="settings-mono"
             Text="{CompiledBinding ModelsText, Mode=TwoWay}"
             AcceptsReturn="True"
             TextWrapping="NoWrap"
             MinHeight="96"
             AutomationProperties.Name="{x:Static models:ModelsCopy.FieldModels}" />
    <TextBlock x:Name="ModelsError"
               Classes="tone-error settings-body"
               IsVisible="{CompiledBinding ModelsError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
               Text="{CompiledBinding ModelsError}" />

    <TextBlock Classes="settings-label"
               Text="{x:Static models:ModelsCopy.FieldCapabilities}" />
    <StackPanel Spacing="{DynamicResource OmpOS.Gap.Xs}"
                AutomationProperties.Name="{x:Static models:ModelsCopy.FieldCapabilities}">
      <CheckBox x:Name="ChatBox"
                Content="{x:Static models:ModelsCopy.CapabilityChat}"
                IsChecked="{CompiledBinding SupportsChat, Mode=TwoWay}"
                AutomationProperties.Name="{x:Static models:ModelsCopy.CapabilityChat}" />
      <CheckBox x:Name="ResponsesBox"
                Content="{x:Static models:ModelsCopy.CapabilityResponses}"
                IsChecked="{CompiledBinding SupportsResponses, Mode=TwoWay}"
                AutomationProperties.Name="{x:Static models:ModelsCopy.CapabilityResponses}" />
      <CheckBox x:Name="EmbeddingsBox"
                Content="{x:Static models:ModelsCopy.CapabilityEmbeddings}"
                IsChecked="{CompiledBinding SupportsEmbeddings, Mode=TwoWay}"
                AutomationProperties.Name="{x:Static models:ModelsCopy.CapabilityEmbeddings}" />
    </StackPanel>

    <CheckBox x:Name="PlainHttpBox"
              Content="{x:Static models:ModelsCopy.FieldAllowPlainHttp}"
              IsChecked="{CompiledBinding AllowRemotePlainHttp, Mode=TwoWay}"
              AutomationProperties.Name="{x:Static models:ModelsCopy.FieldAllowPlainHttp}"
              AutomationProperties.HelpText="{x:Static models:ModelsCopy.AllowPlainHttpHint}" />
    <TextBlock x:Name="PlainHttpWarning"
               Classes="tone-warning settings-body"
               Text="{x:Static models:ModelsCopy.AllowPlainHttpHint}" />

    <TextBlock x:Name="KeyHint"
               Classes="settings-help"
               Text="{x:Static models:ModelsCopy.CustomKeyHint}" />
    <TextBlock x:Name="WriteNotice"
               Classes="settings-help"
               Text="{x:Static models:ModelsCopy.CustomProviderWriteNotice}" />

  </StackPanel>

</UserControl>
