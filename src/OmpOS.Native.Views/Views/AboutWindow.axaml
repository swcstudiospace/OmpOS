<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:about="clr-namespace:OmpOS.Presentation.About;assembly=OmpOS.Presentation"
        x:Class="OmpOS.Native.Views.AboutWindow"
        Title="{x:Static about:AboutCopy.WindowTitle}"
        Icon="avares://OmpOS.Native.Views/Assets/Brand/ompos-mark-256.png"
        Width="560"
        Height="620"
        MinWidth="420"
        MinHeight="480"
        CanResize="True"
        Background="{DynamicResource OmpOS.Color.Surface}"
        WindowStartupLocation="CenterScreen"
        AutomationProperties.Name="{x:Static about:AboutCopy.WindowTitle}" />
