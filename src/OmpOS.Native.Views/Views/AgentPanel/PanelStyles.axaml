<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Styles the Agent Panel views share (46-UI-SPEC). Tokens only: no colour literal. Each view includes this file. -->

  <!-- Text roles of the status chips and stage rows. A class wins over the application's TextBlock style. -->
  <Style Selector="TextBlock.tone-primary">
    <Setter Property="Foreground" Value="{DynamicResource OmpOS.Color.TextPrimary}" />
  </Style>
  <Style Selector="TextBlock.tone-secondary">
    <Setter Property="Foreground" Value="{DynamicResource OmpOS.Color.TextSecondary}" />
  </Style>
  <Style Selector="TextBlock.tone-success">
    <Setter Property="Foreground" Value="{DynamicResource OmpOS.Color.StatusSuccess}" />
  </Style>
  <Style Selector="TextBlock.tone-warning">
    <Setter Property="Foreground" Value="{DynamicResource OmpOS.Color.StatusWarning}" />
  </Style>
  <Style Selector="TextBlock.tone-error">
    <Setter Property="Foreground" Value="{DynamicResource OmpOS.Color.StatusError}" />
  </Style>

  <!-- Stroke roles of the glyphs. -->
  <Style Selector="Path.tone-primary">
    <Setter Property="Stroke" Value="{DynamicResource OmpOS.Color.TextPrimary}" />
  </Style>
  <Style Selector="Path.tone-secondary">
    <Setter Property="Stroke" Value="{DynamicResource OmpOS.Color.TextSecondary}" />
  </Style>
  <Style Selector="Path.tone-success">
    <Setter Property="Stroke" Value="{DynamicResource OmpOS.Color.StatusSuccess}" />
  </Style>
  <Style Selector="Path.tone-warning">
    <Setter Property="Stroke" Value="{DynamicResource OmpOS.Color.StatusWarning}" />
  </Style>
  <Style Selector="Path.tone-error">
    <Setter Property="Stroke" Value="{DynamicResource OmpOS.Color.StatusError}" />
  </Style>
  <Style Selector="Path.tone-accent">
    <Setter Property="Stroke" Value="{DynamicResource OmpOS.Color.AccentPurple}" />
  </Style>

  <!-- The Running glyph pulses only while motion is full: the view adds the class in code and never adds it under reduced motion. -->
  <Style Selector="Path.running-pulse">
    <Style.Animations>
      <Animation Duration="0:0:1.2" IterationCount="INFINITE">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="1" />
        </KeyFrame>
        <KeyFrame Cue="50%">
          <Setter Property="Opacity" Value="0.5" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="1" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- The chip shape of the status, graph and steering chips. -->
  <Style Selector="Border.chip">
    <Setter Property="Height" Value="{DynamicResource OmpOS.Size.ChipHeight}" />
    <Setter Property="CornerRadius" Value="{DynamicResource OmpOS.Radius.Lg}" />
    <Setter Property="Background" Value="{DynamicResource OmpOS.Color.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource OmpOS.Color.TextSecondary}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="8,0" />
  </Style>

  <!-- The primary button: the only accent fill. It keeps its fill on hover and press (opacity changes instead). -->
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource OmpOS.Color.AccentPurple}" />
    <Setter Property="Foreground" Value="{DynamicResource OmpOS.Color.AccentPurpleOn}" />
    <Setter Property="CornerRadius" Value="{DynamicResource OmpOS.Radius.Md}" />
    <Setter Property="Padding" Value="16,0" />
    <Setter Property="MinHeight" Value="{DynamicResource OmpOS.Size.TargetMin}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.primary /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource OmpOS.Color.AccentPurple}" />
    <Setter Property="Foreground" Value="{DynamicResource OmpOS.Color.AccentPurpleOn}" />
  </Style>
  <Style Selector="Button.primary:pointerover">
    <Setter Property="Background" Value="{DynamicResource OmpOS.Color.AccentPurple}" />
    <Setter Property="Opacity" Value="0.88" />
  </Style>
  <Style Selector="Button.primary:pressed">
    <Setter Property="Background" Value="{DynamicResource OmpOS.Color.AccentPurple}" />
    <Setter Property="Opacity" Value="0.88" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource OmpOS.Color.AccentPurple}" />
  </Style>
  <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource OmpOS.Color.AccentPurple}" />
  </Style>
  <Style Selector="Button.primary:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource OmpOS.Color.TextPrimary}" />
    <Setter Property="BorderThickness" Value="{DynamicResource OmpOS.Size.FocusBorder}" />
  </Style>

  <!-- Destructive label of the Close agent confirmation. -->
  <Style Selector="Button.destructive">
    <Setter Property="Foreground" Value="{DynamicResource OmpOS.Color.StatusError}" />
  </Style>

  <!-- A button whose face is a chip or a strip of pills: it keeps a transparent 2 px border so the focus ring appears without moving anything. -->
  <Style Selector="Button.chip-button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="{DynamicResource OmpOS.Size.FocusBorder}" />
    <Setter Property="MinHeight" Value="{DynamicResource OmpOS.Size.TargetMin}" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.chip-button:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource OmpOS.Color.AccentPurple}" />
  </Style>
  <Style Selector="Button.strip">
    <Setter Property="Background" Value="{DynamicResource OmpOS.Color.SurfaceRaised}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="{DynamicResource OmpOS.Size.FocusBorder}" />
    <Setter Property="MinHeight" Value="{DynamicResource OmpOS.Size.TargetMin}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Padding" Value="{DynamicResource OmpOS.Space.Sm}" />
  </Style>
  <Style Selector="Button.strip:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource OmpOS.Color.AccentPurple}" />
  </Style>
  <Style Selector="Button.destructive /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource OmpOS.Color.StatusError}" />
  </Style>

  <!-- Reduced motion: no transition on the panel buttons. -->
  <Style Selector=".reduced-motion Button">
    <Setter Property="Transitions">
      <Transitions />
    </Setter>
  </Style>
  <Style Selector=".reduced-motion ToggleButton">
    <Setter Property="Transitions">
      <Transitions />
    </Setter>
  </Style>

</Styles>
