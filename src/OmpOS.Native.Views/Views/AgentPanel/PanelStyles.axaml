<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Styles the Agent Panel views share (46-UI-SPEC): the status tones, glyph strokes and the running pulse. Tokens only: no colour literal. Each view includes this file. -->

  <!-- Text roles of the status chips and stage rows. A class wins over the application's TextBlock style. -->
  <Style Selector="TextBlock.tone-primary">
    <Setter Property="Foreground" Value="{DynamicResource OmpOS.Color.TextPrimary}" />
  </Style>
  <Style Selector="TextBlock.tone-secondary">
    <Setter Property="Foreground" Value="{DynamicResource OmpOS.Color.TextSecondary}" />
  </Style>
  <Style Selector="TextBlock.tone-success">
    <Setter Property="Foreground" Value="{DynamicResource OmpOS.Color.StatusSuccess}" />
  </Style>
  <Style Selector="TextBlock.tone-warning">
    <Setter Property="Foreground" Value="{DynamicResource OmpOS.Color.StatusWarning}" />
  </Style>
  <Style Selector="TextBlock.tone-error">
    <Setter Property="Foreground" Value="{DynamicResource OmpOS.Color.StatusError}" />
  </Style>

  <!-- Stroke roles of the glyphs. -->
  <Style Selector="Path.tone-primary">
    <Setter Property="Stroke" Value="{DynamicResource OmpOS.Color.TextPrimary}" />
  </Style>
  <Style Selector="Path.tone-secondary">
    <Setter Property="Stroke" Value="{DynamicResource OmpOS.Color.TextSecondary}" />
  </Style>
  <Style Selector="Path.tone-success">
    <Setter Property="Stroke" Value="{DynamicResource OmpOS.Color.StatusSuccess}" />
  </Style>
  <Style Selector="Path.tone-warning">
    <Setter Property="Stroke" Value="{DynamicResource OmpOS.Color.StatusWarning}" />
  </Style>
  <Style Selector="Path.tone-error">
    <Setter Property="Stroke" Value="{DynamicResource OmpOS.Color.StatusError}" />
  </Style>
  <Style Selector="Path.tone-accent">
    <Setter Property="Stroke" Value="{DynamicResource OmpOS.Color.AccentPurple}" />
  </Style>

  <!-- The Running glyph pulses only while motion is full: the view adds the class in code and never adds it under reduced motion. -->
  <Style Selector="Path.running-pulse">
    <Style.Animations>
      <Animation Duration="0:0:1.2" IterationCount="INFINITE">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="1" />
        </KeyFrame>
        <KeyFrame Cue="50%">
          <Setter Property="Opacity" Value="0.5" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="1" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- The chip shape, the buttons (primary, destructive, chip-button, strip), the focus rule and the reduced-motion overrides live in
       Themes/OmpOSControls.axaml, which the application includes once. -->

</Styles>
