<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="OmpOS.Native.Views.AgentPanel.StageIcon"
             Width="{DynamicResource OmpOS.Size.IconSize}"
             Height="{DynamicResource OmpOS.Size.IconSize}"
             Focusable="False"
             IsHitTestVisible="False"
             AutomationProperties.AccessibilityView="Raw">

  <UserControl.Styles>
    <StyleInclude Source="avares://OmpOS.Native.Views/Views/AgentPanel/PanelStyles.axaml" />
  </UserControl.Styles>

  <!-- A decorative glyph (46-UI-SPEC, Glyph Table): the adjacent text carries the meaning. The glyph fills the control, which is 16 px by
       default; a chip or a pill sets Width and Height to the 14 px small size. -->
  <Path x:Name="Glyph"
        Stretch="Uniform"
        StrokeThickness="1.5"
        StrokeLineCap="Round"
        StrokeJoin="Round" />

</UserControl>
