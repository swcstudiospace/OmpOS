<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:copy="clr-namespace:OmpOS.Presentation.AgentPanel;assembly=OmpOS.Presentation"
             xmlns:local="clr-namespace:OmpOS.Native.Views.AgentPanel"
             x:Class="OmpOS.Native.Views.AgentPanel.PipelineTabView"
             x:DataType="copy:StageTimelineModel">

  <UserControl.Styles>
    <StyleInclude Source="avares://OmpOS.Native.Views/Views/AgentPanel/PanelStyles.axaml" />
  </UserControl.Styles>

  <!-- The Pipeline tab: an optional run summary, then one block per source in pipeline order. The scroller is the one tab stop; the retry
       buttons inside it are tab stops of their own. -->
  <ScrollViewer x:Name="PipelineDetails"
                Focusable="True"
                IsTabStop="True"
                HorizontalScrollBarVisibility="Disabled"
                AutomationProperties.Name="{x:Static local:AgentPanelViewText.PipelineDetailsName}">

    <StackPanel Spacing="{DynamicResource OmpOS.Gap.Sm}"
                Margin="{DynamicResource OmpOS.Space.Xs}">

      <StackPanel x:Name="RunSummaryBlock"
                  Spacing="{DynamicResource OmpOS.Gap.Xs}"
                  IsVisible="False">
        <TextBlock Text="{x:Static local:AgentPanelViewText.RunSummaryHeading}"
                   FontSize="{DynamicResource OmpOS.Font.Size.Label}"
                   FontWeight="{DynamicResource OmpOS.Font.Weight.Semibold}" />
        <TextBlock x:Name="RunSummaryText"
                   TextWrapping="Wrap" />
      </StackPanel>

      <ItemsControl x:Name="SourceBlocks"
                    ItemsSource="{CompiledBinding Blocks}"
                    Focusable="False"
                    IsTabStop="False">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="copy:StageSourceBlock">
            <StackPanel Spacing="{DynamicResource OmpOS.Gap.Xs}"
                        Margin="0,0,0,8">

              <Grid ColumnDefinitions="*,Auto"
                    ColumnSpacing="{DynamicResource OmpOS.Gap.Sm}">
                <TextBlock Grid.Column="0"
                           Text="{CompiledBinding Name}"
                           FontSize="{DynamicResource OmpOS.Font.Size.Label}"
                           FontWeight="{DynamicResource OmpOS.Font.Weight.Semibold}"
                           VerticalAlignment="Center" />
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="{DynamicResource OmpOS.Gap.Xs}"
                            IsVisible="{CompiledBinding RollUpText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                  <local:StageIcon IconKey="{CompiledBinding RollUpIconKey}"
                                   VerticalAlignment="Center" />
                  <TextBlock Text="{CompiledBinding RollUpText}"
                             FontSize="{DynamicResource OmpOS.Font.Size.Label}"
                             VerticalAlignment="Center" />
                </StackPanel>
              </Grid>

              <TextBlock Text="{CompiledBinding EmptyText}"
                         IsVisible="{CompiledBinding EmptyText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                         Classes="muted"
                         FontSize="{DynamicResource OmpOS.Font.Size.Label}"
                         TextWrapping="Wrap" />

              <ItemsControl ItemsSource="{CompiledBinding Rows}"
                            Focusable="False"
                            IsTabStop="False">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="copy:StageRow">
                    <Grid ColumnDefinitions="Auto,*,Auto"
                          ColumnSpacing="{DynamicResource OmpOS.Gap.Sm}"
                          MinHeight="{DynamicResource OmpOS.Size.StageRowMinHeight}"
                          Margin="{CompiledBinding Depth, Converter={x:Static local:PanelConverters.DepthIndent}}"
                          AutomationProperties.Name="{CompiledBinding AccessibleName}">

                      <local:StageIcon Grid.Column="0"
                                       IconKey="{CompiledBinding IconKey}"
                                       VerticalAlignment="Top"
                                       Margin="0,4,0,0" />

                      <StackPanel Grid.Column="1"
                                  Spacing="{DynamicResource OmpOS.Gap.Xs}">
                        <TextBlock Text="{CompiledBinding Title}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{CompiledBinding Detail}"
                                   IsVisible="{CompiledBinding ., Converter={x:Static local:PanelConverters.IsPlainDetail}}"
                                   Classes="muted"
                                   FontSize="{DynamicResource OmpOS.Font.Size.Label}"
                                   TextWrapping="Wrap" />
                        <SelectableTextBlock Text="{CompiledBinding Detail}"
                                             IsVisible="{CompiledBinding ., Converter={x:Static local:PanelConverters.IsFixLine}}"
                                             IsTabStop="False"
                                             Classes="muted"
                                             FontFamily="{DynamicResource OmpOS.Font.Mono}"
                                             FontSize="{DynamicResource OmpOS.Font.Size.Label}"
                                             TextWrapping="Wrap" />
                        <SelectableTextBlock Text="{CompiledBinding GraphId}"
                                             IsVisible="{CompiledBinding GraphId, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                             IsTabStop="False"
                                             Classes="muted"
                                             FontFamily="{DynamicResource OmpOS.Font.Mono}"
                                             FontSize="{DynamicResource OmpOS.Font.Size.Label}"
                                             TextWrapping="Wrap" />
                        <TextBlock Text="{CompiledBinding EffectText}"
                                   IsVisible="{CompiledBinding EffectText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                   Classes="muted"
                                   FontSize="{DynamicResource OmpOS.Font.Size.Label}"
                                   TextWrapping="Wrap" />
                        <Button Content="{x:Static copy:AgentPanelCopy.RetryStage}"
                                IsVisible="{CompiledBinding CanRetry}"
                                HorizontalAlignment="Left"
                                MinHeight="{DynamicResource OmpOS.Size.TargetMin}"
                                Padding="{DynamicResource OmpOS.Space.Md}"
                                AutomationProperties.Name="{CompiledBinding RetryName}" />
                      </StackPanel>

                      <local:ToneTextBlock Grid.Column="2"
                                           Text="{CompiledBinding StatusText}"
                                           Tone="{CompiledBinding Status, Converter={x:Static local:StatusGlyphs.StageTone}}"
                                           VerticalAlignment="Top"
                                           FontSize="{DynamicResource OmpOS.Font.Size.Label}" />

                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

    </StackPanel>

  </ScrollViewer>

</UserControl>
