<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pres="clr-namespace:OmpOS.Presentation.Kanban;assembly=OmpOS.Presentation"
             xmlns:glyphs="clr-namespace:OmpOS.Presentation.AgentPanel;assembly=OmpOS.Presentation"
             xmlns:agent="clr-namespace:OmpOS.Native.Views.AgentPanel"
             xmlns:local="clr-namespace:OmpOS.Native.Views.Kanban"
             x:Class="OmpOS.Native.Views.Kanban.KanbanCardView"
             x:DataType="pres:KanbanCardViewModel"
             Classes="kanban-card-view"
             Focusable="True"
             IsTabStop="False"
             Margin="0,0,0,8"
             AutomationProperties.Name="{CompiledBinding Card.SpokenName}"
             ToolTip.Tip="{x:Static local:KanbanCopy.CardTip}">

  <UserControl.Styles>
    <StyleInclude Source="avares://OmpOS.Native.Views/Views/AgentPanel/PanelStyles.axaml" />
    <StyleInclude Source="avares://OmpOS.Native.Views/Views/Kanban/KanbanStyles.axaml" />
  </UserControl.Styles>

  <!-- One task card (spec 4.10), about 112 px tall: title and kind tag, model and provider, status chip and last activity, stale and disconnected
       words, the Substrate fields in one wrapping row, and Steer, which is always visible. The outer Frame keeps the transparent 2 px ring border. -->
  <Border x:Name="Frame"
          Classes="kanban-card">
    <Border Classes="card kanban-card-face">
      <StackPanel Spacing="{DynamicResource OmpOS.Gap.Compact}">

        <Grid ColumnDefinitions="Auto,*,Auto">
          <!-- Only a Backlog or Archived card can be dragged; the grip is drawn for those cards alone (the code-behind shows it). -->
          <Path x:Name="DragGrip"
                Grid.Column="0"
                Classes="kanban-grip"
                Data="M0 0H2V2H0Z M4 0H6V2H4Z M0 4H2V6H0Z M4 4H6V6H4Z M0 8H2V10H0Z M4 8H6V10H4Z"
                Margin="0,3,8,0"
                IsVisible="False"
                AutomationProperties.AccessibilityView="Raw" />
          <TextBlock x:Name="TitleText"
                     Grid.Column="1"
                     Text="{CompiledBinding Card.Title}"
                     FontSize="{DynamicResource OmpOS.Font.Size.Label}"
                     FontWeight="{DynamicResource OmpOS.Font.Weight.Semibold}"
                     Margin="0,0,8,0"
                     MaxLines="2"
                     TextTrimming="CharacterEllipsis"
                     TextWrapping="Wrap" />
          <Border x:Name="KindTag"
                  Grid.Column="2"
                  Classes="chip"
                  VerticalAlignment="Top">
            <TextBlock x:Name="KindText"
                       Text="{CompiledBinding Card.KindText}"
                       VerticalAlignment="Center"
                       FontSize="{DynamicResource OmpOS.Font.Size.Small}"
                       FontWeight="{DynamicResource OmpOS.Font.Weight.Medium}"
                       TextWrapping="NoWrap" />
          </Border>
        </Grid>

        <TextBlock x:Name="ModelText"
                   Text="{CompiledBinding Card.ModelProviderText}"
                   Classes="muted kanban-id"
                   TextTrimming="CharacterEllipsis"
                   TextWrapping="NoWrap"
                   ToolTip.Tip="{CompiledBinding Card.ModelProviderText}" />

        <WrapPanel Orientation="Horizontal"
                   ItemSpacing="{DynamicResource OmpOS.Gap.Sm}"
                   LineSpacing="{DynamicResource OmpOS.Gap.Xs}">
          <agent:StatusChip x:Name="StatusChip" />
          <TextBlock x:Name="ActivityText"
                     Text="{CompiledBinding Card.LastActivityText}"
                     Classes="muted small"
                     VerticalAlignment="Center" />
        </WrapPanel>

        <StackPanel Orientation="Horizontal"
                    Spacing="{DynamicResource OmpOS.Gap.Xs}"
                    IsVisible="{CompiledBinding Card.IsStale}">
          <agent:StageIcon IconKey="{x:Static glyphs:StatusIcon.Alert}"
                           IsVisible="{CompiledBinding Card.IsStale}" />
          <TextBlock x:Name="StaleText"
                     Text="{CompiledBinding Card.StaleLabel}"
                     IsVisible="{CompiledBinding Card.IsStale}"
                     Classes="tone-warning small"
                     VerticalAlignment="Center"
                     TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Orientation="Horizontal"
                    Spacing="{DynamicResource OmpOS.Gap.Xs}"
                    IsVisible="{CompiledBinding Card.IsDisconnected}">
          <agent:StageIcon IconKey="{x:Static glyphs:StatusIcon.Alert}"
                           IsVisible="{CompiledBinding Card.IsDisconnected}" />
          <TextBlock x:Name="DisconnectedText"
                     Text="{CompiledBinding Card.DisconnectedText}"
                     IsVisible="{CompiledBinding Card.IsDisconnected}"
                     Classes="tone-warning small"
                     VerticalAlignment="Center"
                     TextWrapping="Wrap" />
        </StackPanel>

        <TextBlock x:Name="ClosedText"
                   Text="{x:Static local:KanbanCopy.Closed}"
                   IsVisible="{CompiledBinding Card.IsClosed}"
                   Classes="muted small" />

        <!-- The Substrate fields in one wrapping row. Each one reads unavailable when Substrate did not report it; ids are drawn in the mono family. -->
        <StackPanel x:Name="SubstrateRow"
                    AutomationProperties.Name="{CompiledBinding SubstrateName}">
          <WrapPanel Orientation="Horizontal"
                     ItemSpacing="{DynamicResource OmpOS.Gap.Sm}"
                     LineSpacing="{DynamicResource OmpOS.Gap.Xxs}">
            <TextBlock x:Name="TaskField"
                       Text="{CompiledBinding TaskText}"
                       Classes="muted small"
                       TextWrapping="Wrap" />
            <TextBlock x:Name="GraphField"
                       Text="{CompiledBinding GraphText}"
                       Classes="muted kanban-id"
                       TextWrapping="Wrap" />
            <TextBlock x:Name="LessonsField"
                       Text="{CompiledBinding LessonsText}"
                       Classes="muted small" />
            <TextBlock x:Name="LeaseField"
                       Text="{CompiledBinding LeaseText}"
                       Classes="muted kanban-id"
                       TextWrapping="Wrap" />
          </WrapPanel>
        </StackPanel>

        <!-- Steer is always drawn. When the session cannot be steered the button is disabled and the reason is written under it. -->
        <Button x:Name="SteerButton"
                Classes="ghost sm"
                IsEnabled="{CompiledBinding CanSteer}"
                IsTabStop="False"
                HorizontalAlignment="Left"
                MinWidth="{DynamicResource OmpOS.Size.ControlHeightSm}"
                ToolTip.Tip="{x:Static local:KanbanCopy.SteerTip}">
          <StackPanel Orientation="Horizontal"
                      Spacing="{DynamicResource OmpOS.Gap.Compact}">
            <TextBlock Text="{x:Static local:KanbanCopy.Steer}"
                       VerticalAlignment="Center" />
            <Path Data="M2 7H12M8 3 12 7 8 11"
                  Width="{DynamicResource OmpOS.Size.IconSizeSm}"
                  Height="{DynamicResource OmpOS.Size.IconSizeSm}"
                  Stretch="Uniform"
                  Stroke="{DynamicResource OmpOS.Color.TextSecondary}"
                  StrokeThickness="1.5"
                  StrokeLineCap="Round"
                  StrokeJoin="Round"
                  VerticalAlignment="Center"
                  AutomationProperties.AccessibilityView="Raw" />
          </StackPanel>
          <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedLeft">
              <StackPanel x:Name="SteerPanel"
                          x:DataType="pres:KanbanCardViewModel"
                          Width="320"
                          Spacing="{DynamicResource OmpOS.Gap.Sm}">
                <TextBox x:Name="SteerBox"
                         Text="{CompiledBinding SteerText, Mode=TwoWay}"
                         PlaceholderText="{x:Static local:KanbanCopy.SteerPlaceholder}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         MinHeight="72"
                         FontFamily="{DynamicResource OmpOS.Font.Family}"
                         AutomationProperties.Name="{x:Static local:KanbanCopy.SteerBoxName}" />
                <!-- Send now stays first in XAML order (the tab order); the grid puts it at the right edge with Queue beside it. -->
                <Grid ColumnDefinitions="*,Auto,Auto"
                      ColumnSpacing="{DynamicResource OmpOS.Gap.Sm}">
                  <Button x:Name="SendNowButton"
                          Grid.Column="2"
                          Classes="primary sm"
                          Content="{x:Static local:KanbanCopy.SendNow}"
                          Command="{CompiledBinding SteerCommand}"
                          CommandParameter="{x:Static pres:CardSteerMode.SendNow}"
                          AutomationProperties.Name="{x:Static local:KanbanCopy.SendNowName}" />
                  <Button x:Name="QueueButton"
                          Grid.Column="1"
                          Classes="sm"
                          Content="{x:Static local:KanbanCopy.QueueNext}"
                          Command="{CompiledBinding SteerCommand}"
                          CommandParameter="{x:Static pres:CardSteerMode.FollowUp}"
                          AutomationProperties.Name="{x:Static local:KanbanCopy.QueueNextName}" />
                </Grid>
                <TextBlock x:Name="SteerResult"
                           Text="{CompiledBinding SteerResultText}"
                           IsVisible="{CompiledBinding SteerResultText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           Classes="tone-secondary small"
                           TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Polite"
                           AutomationProperties.Name="{x:Static local:KanbanCopy.SteerResultName}" />
              </StackPanel>
            </Flyout>
          </Button.Flyout>
        </Button>
        <TextBlock x:Name="SteerReason"
                   Text="{x:Static local:KanbanCopy.SteerUnavailable}"
                   IsVisible="{CompiledBinding CanSteer, Converter={x:Static BoolConverters.Not}}"
                   Classes="muted small"
                   TextWrapping="Wrap" />

      </StackPanel>
    </Border>
  </Border>

</UserControl>
