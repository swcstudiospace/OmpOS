<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- The composer card (parity spec 4.7). The text box itself is the card, so its focus ring, its name and its tab stop stay what the
       keyboard tests expect; the footer (chips and buttons) is drawn over its bottom padding by the view that hosts it. Tokens only.
       Rest: a 1 px hairline. Hover: the strong border. Keyboard focus: the shared 2 px accent ring, with the padding giving up 1 px a
       side so the text never moves. -->
  <Style Selector="TextBox.composer">
    <Setter Property="CornerRadius" Value="{DynamicResource OmpOS.Radius.Lg}" />
    <Setter Property="Background" Value="{DynamicResource OmpOS.Color.SurfaceRaised}" />
    <Setter Property="BorderBrush" Value="{DynamicResource OmpOS.Color.Border}" />
    <Setter Property="BorderThickness" Value="{DynamicResource OmpOS.Border.Hairline}" />
    <Setter Property="FontSize" Value="{DynamicResource OmpOS.Font.Size.Body}" />
    <Setter Property="MinHeight" Value="{DynamicResource OmpOS.Size.ComposerMinHeight}" />
    <Setter Property="MaxHeight" Value="{DynamicResource OmpOS.Size.ComposerMaxHeight}" />
    <Setter Property="VerticalContentAlignment" Value="Top" />
  </Style>
  <Style Selector="TextBox.composer[AcceptsReturn=True]">
    <Setter Property="Padding" Value="12,10,12,44" />
  </Style>
  <Style Selector="TextBox.composer:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource OmpOS.Color.SurfaceRaised}" />
    <Setter Property="BorderBrush" Value="{DynamicResource OmpOS.Color.BorderStrong}" />
  </Style>
  <Style Selector="TextBox.composer:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource OmpOS.Color.SurfaceRaised}" />
  </Style>
  <Style Selector="TextBox.composer:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource OmpOS.Color.AccentPurple}" />
    <Setter Property="BorderThickness" Value="{DynamicResource OmpOS.Size.FocusBorder}" />
  </Style>
  <Style Selector="TextBox.composer[AcceptsReturn=True]:focus-visible">
    <Setter Property="Padding" Value="11,9,11,43" />
  </Style>
  <Style Selector="TextBox.composer:focus-visible /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush" Value="{DynamicResource OmpOS.Color.AccentPurple}" />
    <Setter Property="BorderThickness" Value="{DynamicResource OmpOS.Size.FocusBorder}" />
  </Style>

  <!-- The stop control stays a tab stop while nothing runs (the keyboard map does not change), but it is drawn dimmed so it does not
       read as a live control that can stop something. -->
  <Style Selector="Button.idle">
    <Setter Property="Opacity" Value="0.45" />
  </Style>

  <!-- An attached mention above the card: a pill with the name, the size and a remove button. Its height is the target size, because the remove button is one. Tokens only. -->
  <Style Selector="Border.mention-chip">
    <Setter Property="MinHeight" Value="{DynamicResource OmpOS.Size.TargetMin}" />
    <Setter Property="CornerRadius" Value="{DynamicResource OmpOS.Radius.Pill}" />
    <Setter Property="Background" Value="{DynamicResource OmpOS.Color.SurfaceSunken}" />
    <Setter Property="BorderBrush" Value="{DynamicResource OmpOS.Color.Border}" />
    <Setter Property="BorderThickness" Value="{DynamicResource OmpOS.Border.Hairline}" />
    <Setter Property="Padding" Value="10,0,0,0" />
  </Style>

</Styles>
