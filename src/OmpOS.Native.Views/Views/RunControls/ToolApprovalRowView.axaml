<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="OmpOS.Native.Views.RunControls.ToolApprovalRowView">

  <!-- The request card: a card with a hairline in the accent, as a permission request is drawn in the transcript. -->
  <Border Classes="card"
          BorderBrush="{DynamicResource OmpOS.Color.AccentPurple}"
          Padding="{DynamicResource OmpOS.Space.Sm}">

    <StackPanel Spacing="{DynamicResource OmpOS.Gap.Xs}">

      <TextBlock x:Name="ToolNameText"
                 FontWeight="{DynamicResource OmpOS.Font.Weight.Semibold}"
                 FontSize="{DynamicResource OmpOS.Font.Size.Body}"
                 TextWrapping="Wrap" />

      <TextBlock x:Name="ArgumentsText"
                 Classes="muted mono"
                 TextWrapping="Wrap" />

      <TextBlock x:Name="StatusText"
                 FontSize="{DynamicResource OmpOS.Font.Size.Label}"
                 TextWrapping="Wrap"
                 IsVisible="False"
                 AutomationProperties.Name="Approval status"
                 AutomationProperties.LiveSetting="Polite" />

      <StackPanel Orientation="Horizontal"
                  Spacing="{DynamicResource OmpOS.Gap.Sm}">

        <Button x:Name="ApproveButton"
                Classes="primary sm"
                Content="Approve"
                AutomationProperties.Name="Approve tool request" />

        <Button x:Name="DenyButton"
                Classes="sm"
                Content="Deny"
                AutomationProperties.Name="Deny tool request" />

      </StackPanel>

    </StackPanel>

  </Border>

</UserControl>
