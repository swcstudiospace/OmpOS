<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="OmpOS.Native.Views.RunControls.RunControlsView"
             Background="{DynamicResource OmpOS.Color.SurfaceRaised}"
             Padding="{DynamicResource OmpOS.Space.Md}">

  <StackPanel Spacing="{DynamicResource OmpOS.Gap.Sm}">

    <TextBlock Text="Tool requests waiting for a decision"
               FontWeight="{DynamicResource OmpOS.Font.Weight.Semibold}"
               FontSize="{DynamicResource OmpOS.Font.Size.Label}"
               TextWrapping="Wrap" />

    <ItemsControl x:Name="ApprovalItems"
                  AutomationProperties.Name="Pending tool requests" />

  </StackPanel>

</UserControl>
