<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:copy="clr-namespace:OmpOS.Presentation.AgentPanel;assembly=OmpOS.Presentation"
             x:Class="OmpOS.Native.Views.Sessions.TerminalSteerView"
             Background="{DynamicResource OmpOS.Color.SurfaceRaised}"
             Padding="{DynamicResource OmpOS.Space.Md}">

  <UserControl.Styles>
    <StyleInclude Source="avares://OmpOS.Native.Views/Views/AgentPanel/PanelStyles.axaml" />
  </UserControl.Styles>

  <!-- The composer of an omp terminal. The terminal itself takes the keys; this box only steers the running omp: Send now delivers the
       message into the running turn, Queue runs it after the turn. Keyboard order follows XAML order: the message, Send now, Queue. -->
  <Grid ColumnDefinitions="*,Auto,Auto"
        ColumnSpacing="{DynamicResource OmpOS.Gap.Sm}">

    <TextBox x:Name="MessageInput"
             Grid.Column="0"
             AutomationProperties.Name="{x:Static copy:AgentPanelCopy.TerminalMessageName}"
             PlaceholderText="{x:Static copy:AgentPanelCopy.ComposerPlaceholderTerminal}"
             AcceptsReturn="True"
             TextWrapping="Wrap"
             MinHeight="{DynamicResource OmpOS.Size.TargetMin}"
             Background="{DynamicResource OmpOS.Color.Surface}"
             Foreground="{DynamicResource OmpOS.Color.TextPrimary}" />

    <Button x:Name="SendNowButton"
            Grid.Column="1"
            Classes="primary"
            Content="{x:Static copy:AgentPanelCopy.SendNow}"
            Padding="{DynamicResource OmpOS.Space.Md}"
            MinHeight="{DynamicResource OmpOS.Size.TargetMin}"
            MinWidth="{DynamicResource OmpOS.Size.TargetMin}"
            VerticalAlignment="Bottom"
            AutomationProperties.Name="{x:Static copy:AgentPanelCopy.SendNowName}" />

    <Button x:Name="QueueButton"
            Grid.Column="2"
            Content="{x:Static copy:AgentPanelCopy.QueueFollowUpLabel}"
            Padding="{DynamicResource OmpOS.Space.Md}"
            MinHeight="{DynamicResource OmpOS.Size.TargetMin}"
            MinWidth="{DynamicResource OmpOS.Size.TargetMin}"
            VerticalAlignment="Bottom"
            AutomationProperties.Name="{x:Static copy:AgentPanelCopy.QueueFollowUpName}" />

  </Grid>

</UserControl>
