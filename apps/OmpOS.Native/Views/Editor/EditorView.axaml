<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ae="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
             xmlns:editor="clr-namespace:OmpOS.Native.Views.Editor"
             x:Class="OmpOS.Native.Views.Editor.EditorView">

  <UserControl.Styles>
    <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,Auto,*">

    <ScrollViewer Grid.Row="0"
                  x:Name="TabScroll"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Disabled">
      <ItemsControl x:Name="TabStrip"
                    AutomationProperties.Name="Open files">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="editor:EditorTabItem">
            <StackPanel Orientation="Horizontal">
              <ToggleButton Content="{CompiledBinding Name}"
                            IsChecked="{CompiledBinding IsSelected, Mode=OneWay}"
                            Command="{CompiledBinding SelectCommand}"
                            AutomationProperties.Name="{CompiledBinding Name}" />
              <Button Content="×"
                      Command="{CompiledBinding CloseCommand}"
                      AutomationProperties.Name="{CompiledBinding Name, StringFormat='Close {0}'}" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto,Auto,Auto">
      <TextBox x:Name="FindInput"
               Grid.Column="0"
               PlaceholderText="Find in file"
               AutomationProperties.Name="Find in file" />
      <Button x:Name="PreviousMatchButton"
              Grid.Column="1"
              Content="Previous"
              IsEnabled="False"
              AutomationProperties.Name="Previous match" />
      <Button x:Name="NextMatchButton"
              Grid.Column="2"
              Content="Next"
              IsEnabled="False"
              AutomationProperties.Name="Next match" />
      <CheckBox x:Name="MatchCaseCheck"
                Grid.Column="3"
                Content="Match case"
                AutomationProperties.Name="Match case" />
      <TextBlock x:Name="MatchStatusText"
                 Grid.Column="4"
                 AutomationProperties.Name="Find result"
                 AutomationProperties.LiveSetting="Polite" />
    </Grid>

    <ae:TextEditor x:Name="CodeEditor"
                   Grid.Row="2"
                   ShowLineNumbers="True"
                   FontFamily="Cascadia Code,Consolas,Menlo,monospace"
                   AutomationProperties.Name="Code editor" />

  </Grid>

</UserControl>
