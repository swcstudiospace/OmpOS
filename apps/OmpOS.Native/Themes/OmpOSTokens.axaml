<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Colour roles (20-UI-SPEC.md, Color). Each role has a Light and a Dark value; Avalonia selects the set for the
       active theme variant. ThemeContrastTests classifies each role by its use and checks every text and non-text
       pair the classification produces, in both variants.
       FocusRing is reserved for focus indicators to bind in a later phase. No style consumes it yet: the focus
       indicators in App.axaml draw AccentPurple. -->
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="OmpOS.Color.Surface">#ffffff</SolidColorBrush>
      <SolidColorBrush x:Key="OmpOS.Color.SurfaceRaised">#f4f4f5</SolidColorBrush>
      <SolidColorBrush x:Key="OmpOS.Color.SurfaceActive">#e4e4e7</SolidColorBrush>
      <SolidColorBrush x:Key="OmpOS.Color.TextPrimary">#1a1a1a</SolidColorBrush>
      <SolidColorBrush x:Key="OmpOS.Color.TextSecondary">#52525b</SolidColorBrush>
      <SolidColorBrush x:Key="OmpOS.Color.AccentPurple">#6d28d9</SolidColorBrush>
      <SolidColorBrush x:Key="OmpOS.Color.AccentPurpleOn">#ffffff</SolidColorBrush>
      <SolidColorBrush x:Key="OmpOS.Color.FocusRing">#5b21b6</SolidColorBrush>
      <SolidColorBrush x:Key="OmpOS.Color.StatusSuccess">#166534</SolidColorBrush>
      <SolidColorBrush x:Key="OmpOS.Color.StatusWarning">#92400e</SolidColorBrush>
      <SolidColorBrush x:Key="OmpOS.Color.StatusError">#b3261e</SolidColorBrush>
    </ResourceDictionary>

    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="OmpOS.Color.Surface">#18181b</SolidColorBrush>
      <SolidColorBrush x:Key="OmpOS.Color.SurfaceRaised">#27272a</SolidColorBrush>
      <SolidColorBrush x:Key="OmpOS.Color.SurfaceActive">#3f3f46</SolidColorBrush>
      <SolidColorBrush x:Key="OmpOS.Color.TextPrimary">#fafafa</SolidColorBrush>
      <SolidColorBrush x:Key="OmpOS.Color.TextSecondary">#b0b0b8</SolidColorBrush>
      <SolidColorBrush x:Key="OmpOS.Color.AccentPurple">#a78bfa</SolidColorBrush>
      <SolidColorBrush x:Key="OmpOS.Color.AccentPurpleOn">#18181b</SolidColorBrush>
      <SolidColorBrush x:Key="OmpOS.Color.FocusRing">#c4b5fd</SolidColorBrush>
      <SolidColorBrush x:Key="OmpOS.Color.StatusSuccess">#4ade80</SolidColorBrush>
      <SolidColorBrush x:Key="OmpOS.Color.StatusWarning">#fbbf24</SolidColorBrush>
      <SolidColorBrush x:Key="OmpOS.Color.StatusError">#fca5a5</SolidColorBrush>
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <!-- Type tokens (20-UI-SPEC.md, Typography). Three sizes, two weights. The bundled faces are named by their
       avares URI; the fallbacks follow the family name after the fragment. -->
  <FontFamily x:Key="OmpOS.Font.Family">avares://OmpOS.Native/Assets/Fonts/DMSans/DMSans.ttf#DM Sans, Helvetica Neue, Helvetica, Arial, sans-serif</FontFamily>
  <FontFamily x:Key="OmpOS.Font.Display">avares://OmpOS.Native/Assets/Fonts/Anybody/Anybody.ttf#Anybody, Helvetica Neue, Helvetica, Arial, sans-serif</FontFamily>
  <FontFamily x:Key="OmpOS.Font.Mono">avares://OmpOS.Native/Assets/Fonts/SpaceMono/SpaceMono-Regular.ttf#Space Mono, Menlo, Consolas, Liberation Mono, monospace</FontFamily>
  <x:Double x:Key="OmpOS.Font.Size.Label">13</x:Double>
  <x:Double x:Key="OmpOS.Font.Size.Body">15</x:Double>
  <x:Double x:Key="OmpOS.Font.Size.Heading">18</x:Double>
  <FontWeight x:Key="OmpOS.Font.Weight.Regular">Normal</FontWeight>
  <FontWeight x:Key="OmpOS.Font.Weight.Semibold">SemiBold</FontWeight>
  <x:Double x:Key="OmpOS.Font.LineHeight.Label">18.2</x:Double>
  <x:Double x:Key="OmpOS.Font.LineHeight.Body">22.5</x:Double>
  <x:Double x:Key="OmpOS.Font.LineHeight.Heading">21.6</x:Double>

  <!-- Spacing tokens (multiples of 4). Uniform Thickness values: they are applied to Padding, Margin and
       BorderThickness, which take Thickness. -->
  <Thickness x:Key="OmpOS.Space.Xs">4</Thickness>
  <Thickness x:Key="OmpOS.Space.Sm">8</Thickness>
  <Thickness x:Key="OmpOS.Space.Md">16</Thickness>
  <Thickness x:Key="OmpOS.Space.Lg">24</Thickness>
  <Thickness x:Key="OmpOS.Space.Xl">32</Thickness>
  <Thickness x:Key="OmpOS.Space.Xxl">48</Thickness>
  <Thickness x:Key="OmpOS.Space.Xxxl">64</Thickness>

  <!-- Corner radius scale (multiples of 4). -->
  <CornerRadius x:Key="OmpOS.Radius.Sm">4</CornerRadius>
  <CornerRadius x:Key="OmpOS.Radius.Md">8</CornerRadius>
  <CornerRadius x:Key="OmpOS.Radius.Lg">12</CornerRadius>

  <!-- Scalar gaps for StackPanel.Spacing and Grid.ColumnSpacing, which take double. Same values as the spacing tokens. -->
  <x:Double x:Key="OmpOS.Gap.Xs">4</x:Double>
  <x:Double x:Key="OmpOS.Gap.Sm">8</x:Double>

  <!-- Fixed sizes (multiples of 4, except the 2 px focus stroke, which is a border width). -->
  <x:Double x:Key="OmpOS.Size.SessionListWidth">240</x:Double>
  <x:Double x:Key="OmpOS.Size.TargetMin">44</x:Double>
  <Thickness x:Key="OmpOS.Size.FocusBorder">2</Thickness>

</ResourceDictionary>
