<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="OmpOS.Native.App"
             RequestedThemeVariant="Dark">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://OmpOS.Native.Views/Themes/OmpOSTokens.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme DensityStyle="Compact" />

    <Style Selector="Window">
      <Setter Property="Background" Value="{DynamicResource OmpOS.Color.Surface}" />
      <Setter Property="Foreground" Value="{DynamicResource OmpOS.Color.TextPrimary}" />
      <Setter Property="FontFamily" Value="{DynamicResource OmpOS.Font.Family}" />
    </Style>

    <Style Selector="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource OmpOS.Color.TextPrimary}" />
      <Setter Property="FontFamily" Value="{DynamicResource OmpOS.Font.Family}" />
      <Setter Property="FontSize" Value="{DynamicResource OmpOS.Font.Size.Label}" />
    </Style>

    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{DynamicResource OmpOS.Color.TextSecondary}" />
    </Style>

    <Style Selector="TextBlock.error">
      <Setter Property="Foreground" Value="{DynamicResource OmpOS.Color.StatusError}" />
    </Style>

    <!-- The shared control library: buttons, inputs, tabs, rows, menus, chips and the focus rule, in the OmpOS roles. -->
    <StyleInclude Source="avares://OmpOS.Native.Views/Themes/OmpOSControls.axaml" />
  </Application.Styles>

</Application>
