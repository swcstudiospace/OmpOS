@page "/"
@using Microsoft.Extensions.Logging
@using Autonogrammer.Presentation.AgentPanel
@using Autonogrammer.Presentation.Changes
@using Autonogrammer.UI.Components.Shell
@using Autonogrammer.Web.Services
@implements IDisposable
@inject WebWorkbench Workbench
@inject ILogger<Index> Logger

<PageTitle>Autonogrammer</PageTitle>

@if (_startFailure is not null)
{
    <p class="autonogrammer-error" role="alert">@_startFailure</p>
}

<WorkbenchView Panel="Workbench.Panel"
               Board="Workbench.Board"
               Settings="Workbench.Settings"
               IsDemo="Workbench.IsDemo"
               Source="Workbench.Source"
               Workspace="Workbench.Workspace"
               ChangesFactory="ChangesFor"
               RetryAsync="Workbench.RetryAsync" />

@code {
    private static readonly Action<ILogger, Exception?> StartFailed =
        LoggerMessage.Define(
            LogLevel.Error,
            new EventId(1, "WorkbenchStartFailed"),
            "Starting the workbench failed");

    private readonly CancellationTokenSource _lifetime = new();
    private string? _startFailure;
    private bool _disposed;

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        Workbench.Changed += OnWorkbenchChanged;
        try
        {
            await Workbench.StartAsync(_lifetime.Token).ConfigureAwait(true);
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested)
        {
            // The page went away while the workbench started; nothing is left to show.
        }
        catch (Exception ex) when (ex is not OutOfMemoryException)
        {
            StartFailed(Logger, ex);
            _startFailure = "Autonogrammer could not start. " + ex.Message;
        }
    }

    /// <inheritdoc />
    public void Dispose()
    {
        if (_disposed)
        {
            return;
        }

        _disposed = true;
        Workbench.Changed -= OnWorkbenchChanged;
        _lifetime.Cancel();
        _lifetime.Dispose();
    }

    // The workbench owns one change set per opened session, fed from the API; null until the session is opened.
    private ChangeSetModel? ChangesFor(AgentSessionViewModel session) => Workbench.ChangesOf(session.Id);

    private void OnWorkbenchChanged(object? sender, EventArgs e) => _ = InvokeAsync(StateHasChanged);
}
