<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="OmpOS.Android.OmpOSAndroidApp"
             RequestedThemeVariant="Dark">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://OmpOS.Native.Views/Themes/OmpOSTokens.axaml" />
      </ResourceDictionary.MergedDictionaries>

      <!-- A touch head keeps the larger target: the desktop token is 32 (OQ-87), a finger needs 44. The dictionary's own items win over the merged tokens. -->
      <x:Double x:Key="OmpOS.Size.TargetMin">44</x:Double>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme DensityStyle="Compact" />

    <Style Selector="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource OmpOS.Color.TextPrimary}" />
      <Setter Property="FontFamily" Value="{DynamicResource OmpOS.Font.Family}" />
      <Setter Property="FontSize" Value="{DynamicResource OmpOS.Font.Size.Label}" />
    </Style>

    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{DynamicResource OmpOS.Color.TextSecondary}" />
    </Style>

    <Style Selector="TextBlock.error">
      <Setter Property="Foreground" Value="{DynamicResource OmpOS.Color.StatusError}" />
    </Style>

    <!-- The shared control library: buttons, inputs, tabs, rows, menus, chips, the focus rule and the reduced-motion overrides. -->
    <StyleInclude Source="avares://OmpOS.Native.Views/Themes/OmpOSControls.axaml" />
  </Application.Styles>

</Application>
