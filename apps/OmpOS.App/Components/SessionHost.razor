@namespace OmpOS.App.Components
@using OmpOS.EngineHost
@using OmpOS.Harness.Abstractions
@using OmpOS.UI.Components
@using OmpOS.UI.State
@inject IEngineHost Host
@implements IAsyncDisposable

<div class="ompos-shell">
    @if (_error is not null)
    {
        <p class="ompos-error" role="alert">@_error</p>
    }
    <SessionView Tree="_viewModel.Tree"
                 ViewState="_viewModel.State"
                 AutoScrollPaused="_viewModel.AutoScrollPaused"
                 Announcement="_viewModel.Announcement"
                 OnStop="StopStreamingAsync"
                 OnRetry="RetryAsync"
                 OnJumpToLatest="JumpToLatest"
                 AutoScrollPausedChanged="OnAutoScrollPausedChanged" />
    <Composer IsStreaming="_streaming" OnSend="SendAsync" OnStop="StopStreamingAsync" />
</div>

@code {
    // Display correlation only: the engine session itself lives inside the host, which the
    // mobile head resumes by sequence and the desktop head streams in-process.
    private readonly string _conversationId = Guid.NewGuid().ToString("N");
    private readonly SessionViewModel _viewModel = new();
    private CancellationTokenSource? _streamCts;
    private string? _error;
    private string? _lastPrompt;
    private bool _streaming;
    private long _seq;
    private bool _disposed;

    /// <inheritdoc />
    protected override void OnInitialized()
    {
        _viewModel.MarkHistoryLoaded();
        if (Host is RemoteEngineHost remote)
        {
            remote.MissedEventsHeld += OnMissedEventsHeld;
        }
    }

    /// <summary>
    /// Starts a turn. Resolves true once the engine has accepted the prompt (its first non-error event arrives),
    /// false when the send is refused: already streaming, or the engine refused the turn before any output.
    /// The turn then streams in the background, so the composer clears its draft without waiting for the whole reply.
    /// </summary>
    private Task<bool> SendAsync(string prompt)
    {
        if (_streaming)
        {
            return Task.FromResult(false);
        }

        _error = null;
        _lastPrompt = prompt;
        _streamCts?.Cancel();
        _streamCts?.Dispose();
        _streamCts = new CancellationTokenSource();
        _streaming = true;
        var accepted = new TaskCompletionSource<bool>(TaskCreationOptions.RunContinuationsAsynchronously);
        // Observed through the accepted result and the view model; any unexpected fault is surfaced by StreamTurnAsync's finally block.
        _ = StreamTurnAsync(prompt, _streamCts.Token, accepted);
        StateHasChanged();
        return accepted.Task;
    }

    private async Task StreamTurnAsync(string prompt, CancellationToken token, TaskCompletionSource<bool> accepted)
    {
        try
        {
            await foreach (var evt in Host.SubmitPromptAsync(prompt, new PromptOptions(), token).ConfigureAwait(true))
            {
                // Diagnostics are non-terminal and have no UI: they neither render nor count as the engine's reply.
                if (evt is DiagnosticEvent)
                {
                    continue;
                }

                // An error as the first event means the engine refused the turn, so the draft stays in the composer.
                if (evt is not ErrorEvent)
                {
                    accepted.TrySetResult(true);
                }

                ApplyEvent(evt);

                // Completed and error both end the turn; the client never keeps streaming past either.
                if (evt is CompletedEvent or ErrorEvent)
                {
                    break;
                }
            }
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested)
        {
            // Stop is an intentional user action, not an error.
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException)
        {
            _error = $"The engine stream failed: {ex.Message}";
            _viewModel.MarkOffline();
        }
        finally
        {
            accepted.TrySetResult(false);
            _streaming = false;
            if (!_disposed)
            {
                StateHasChanged();
            }
        }
    }

    private void ApplyEvent(HarnessEvent evt)
    {
        _viewModel.ApplyEvent(EngineEventMapper.ToStreamEvent(evt, _conversationId, ++_seq));
        StateHasChanged();
    }

    private Task RetryAsync()
    {
        if (_lastPrompt is null || _streaming)
        {
            return Task.CompletedTask;
        }

        return SendAsync(_lastPrompt);
    }

    private async Task StopStreamingAsync()
    {
        _streamCts?.Cancel();
        try
        {
            await Host.CancelAsync(CancellationToken.None).ConfigureAwait(true);
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException or OperationCanceledException)
        {
            // Stopping is best-effort once the stream is already gone.
            _error = $"Stop did not reach the engine: {ex.Message}";
        }
    }

    private void JumpToLatest()
    {
        _viewModel.ResumeAutoScroll();
    }

    private void OnAutoScrollPausedChanged(bool paused)
    {
        if (paused)
        {
            _viewModel.PauseAutoScroll();
        }
        else
        {
            _viewModel.ResumeAutoScroll();
        }
    }

    private void OnMissedEventsHeld(object? sender, EventArgs e)
    {
        // The fetch raises this on the thread that completed it, so render on the component's context.
        _ = InvokeAsync(ApplyHeldEvents);
    }

    /// <summary>Renders the events a resume fetched, in seq order, now rather than on the next prompt.</summary>
    private void ApplyHeldEvents()
    {
        if (_disposed || Host is not RemoteEngineHost remote)
        {
            return;
        }

        foreach (var evt in remote.TakeHeldEvents())
        {
            if (evt is DiagnosticEvent)
            {
                continue;
            }

            ApplyEvent(evt);
        }
    }

    /// <inheritdoc />
    public ValueTask DisposeAsync()
    {
        if (!_disposed)
        {
            _disposed = true;
            if (Host is RemoteEngineHost remote)
            {
                remote.MissedEventsHeld -= OnMissedEventsHeld;
            }

            _streamCts?.Cancel();
            _streamCts?.Dispose();
            _streamCts = null;
        }

        return ValueTask.CompletedTask;
    }
}
