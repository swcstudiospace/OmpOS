<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:maui="clr-namespace:Microsoft.AspNetCore.Components.WebView.Maui;assembly=Microsoft.AspNetCore.Components.WebView.Maui"
             xmlns:components="clr-namespace:OmpOS.App.Components;assembly=OmpOS.App"
             x:Class="OmpOS.App.MainPage"
             Title="OmpOS">
    <maui:BlazorWebView x:Name="SessionWebView" HostPage="wwwroot/index.html">
        <maui:BlazorWebView.RootComponents>
            <maui:RootComponent Selector="#app" ComponentType="{x:Type components:SessionHost}" />
        </maui:BlazorWebView.RootComponents>
    </maui:BlazorWebView>
</ContentPage>
