# Autonogrammer environment variables.
# This file documents every variable. Copy it to .env for local use; never commit .env.
# Runtime variables are documented below, one section per area.
AUTONOGRAMMER_ENV=Development

# Phase 2 (API-01..03, OPS-01..04): Autonogrammer.Api configuration.
# Config keys use ':' in code and '__' in the environment. Every key has a safe
# appsettings.json default. In Production, Harness__Adapter must be Acp: InMemory is refused at startup and the message names the key.
Harness__Adapter=InMemory
# Api__Cors__Origins__0=https://localhost:5173
Api__MaxPromptLength=64000
Api__MaxRequestBodyBytes=1048576
Api__RateLimit__PromptsPerMinute=60
Otel__Exporter=none
# Autonogrammer__Debug__LogPrompts=false

# Sign-in (OD-03): every protected endpoint requires a bearer token from this authority. Outside Development, Authority (https) and Audience are required and startup stops without them.
# Api__Auth__Authority=https://<identity-provider>/
# Api__Auth__Audience=
# Api__Auth__ValidIssuer=
# Signature algorithms a bearer token may use: ES256 and/or RS256. Unset means ES256 only (the shared Supabase project signs with ES256). Refused in OwnerToken mode.
# Api__Auth__Algorithms__0=ES256
# Public sign-in settings of the identity project, served to anonymous callers. Oidc mode only; refused in OwnerToken mode. The key must be the publishable key: a secret key, a service-role token and a non-https project URL stop startup.
# Api__Auth__Client__ProjectUrl=https://<project>.supabase.co
# Api__Auth__Client__PublishableKey=
# Open sign-up (any account the identity provider admits may use the deployment) needs Api__Auth__AllowAnyAuthenticatedUser=true set on purpose. ValidIssuer is required outside Development.
# Development only; refused outside Development. Runs unauthenticated local requests as the local developer.
# Api__Auth__AllowDevelopmentPrincipal=false
# Account endpoints are disabled by default. Existing installations that need /account and /account/board must set this to true before deploying the changed default.
# Accounts__Enabled=false


# Session store (Autonogrammer.Api). Defaults to InMemory in appsettings.json for Development only. Production refuses to start unless it is Postgres (TimescaleDB, schema autonogrammer).
Sessions__Store=InMemory
# Required when Sessions__Store=Postgres. Npgsql connection string, key shape:
# Host=<host>;Port=5432;Database=<database>;Username=<user>;Password=<password>;SSL Mode=Require
# Secret: set in the hosting environment, never commit a value.
Sessions__Postgres__ConnectionString=

# Coordination (run leases, idempotency, SSE wake-up). Defaults to InMemory in appsettings.json; production must set Dragonfly explicitly. A warning is logged in Production when it is InMemory (event 32).
Coordination__Store=InMemory
# Required when Coordination__Store=Dragonfly. StackExchange.Redis configuration string, key shape:
# <host>:<port>,password=<password>,abortConnect=false
# Secret: set in the hosting environment, never commit a value.
Coordination__Dragonfly__ConnectionString=

# Dispatch relay. Off by default. Enabled=true requires Api__Auth__Mode=Oidc. The PEM values are secrets: set them in the host, never commit them.
# Dispatch__Enabled=false
# Dispatch__Credentials__SigningKeyPem=
# Dispatch__CommandSigning__KeyPem=

# Schema runner (ADR-0031 D5). Hosting-only secret, set only on the one-shot Railway service autonogrammer-migrate (the API image, command `migrate`); never on the API service, never committed.
# Npgsql connection string of a role that may create schema objects; the API itself uses Sessions__Postgres__ConnectionString.
# Sessions__Postgres__MigratorConnectionString=
# Development and tests only: runs the same runner with the runtime connection string at startup. Default false; refused in Production.
# Sessions__Postgres__AutoMigrate=false

# Data plane (DataPlane__*; ADR-0031). Non-secret options keep their defaults unless noted.
# Seconds the API waits for the compiled schema head before it fails fast naming this key (default 120).
# DataPlane__Postgres__SchemaWaitSeconds=120
# Retention of telemetry-class rows (DataPlane__Retention__*): dispatch_events 30 days, dispatch_audit 400 days (floor 90 days, validated).
# Command bodies are nulled 7 days after a terminal state and ledger_outbox rows are removed 7 days after sent_at. User content has no automatic limit.
# Opt-in write path to the Substrate event ledger; off by default. Endpoint and Token are validated only when Enabled=true.
# DataPlane__Ledger__Enabled=false
# DataPlane__Ledger__Endpoint=
# Secret: set in the hosting environment, never commit a value.
# DataPlane__Ledger__Token=
# Secret: pepper of the HMAC that derives the Dragonfly tenant segment from an account id. Set in the hosting environment, never commit a value.
# DataPlane__TenantHashPepper=

# Hosting (HOST-01): Railway service for Autonogrammer.Api. Nothing is deployed yet;
# see docs/runbooks/hosting.md. Set these as Railway service variables, never in a committed .env.
# Blank or commented values are owner decisions; no value here is a secret.
# Railway injects PORT. The API listens on PORT and falls back to 8080 when it is unset.
# PORT=8080
# Public web origin(s) allowed to call the API (owner decision; empty denies cross-origin traffic).
# Api__Cors__Origins__0=

# Local backend stack (deploy/compose.yaml, profile backend). Secrets: set in the environment, never commit a value.
# Role and database names are optional; they default to autonogrammer.
# AUTONOGRAMMER_POSTGRES_USER=autonogrammer
# AUTONOGRAMMER_POSTGRES_DB=autonogrammer
# AUTONOGRAMMER_POSTGRES_PASSWORD=
# AUTONOGRAMMER_DRAGONFLY_PASSWORD=
# Development API on the VPS (runbook docs/runbooks/vps-development-host.md). Secrets: set them in the operator's env files (mode 600,
# outside this repository), never here.
# AUTONOGRAMMER_APP_DB_PASSWORD=
# AUTONOGRAMMER_MIGRATOR_DB_PASSWORD=
# AUTONOGRAMMER_OWNER_TOKEN_SHA256=
# AUTONOGRAMMER_TENANT_HASH_PEPPER=
# Optional build argument: the git revision stamped into the image and reported by GET /source.
# AUTONOGRAMMER_REVISION=

# Test services (scripts/test-services.sh). `up` exports the connection variables into a mode 600 file and prints its path; never set them by hand.
# `up --with-greptime` also starts a throwaway GreptimeDB (no authentication, loopback) and exports its base URL, which the Live telemetry tests read:
# AUTONOGRAMMER_TEST_GREPTIME_URL=http://127.0.0.1:<port>

# Optional sandbox and harness settings. Set only when the owner decides to use them.
# Sandbox__Provider=podman
# Harness__Acp__OmpPath=omp

# Telemetry target when Otel__Exporter=otlp. Standard OpenTelemetry SDK variables; GreptimeDB accepts only http/protobuf.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://greptimedb.railway.internal:4000/v1/otlp
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# OTEL_EXPORTER_OTLP_HEADERS=X-Greptime-DB-Name=autonogrammer,X-Greptime-Pipeline-Name=greptime_trace_v1
# The Authorization Basic header is set only in the hosting environment and is never committed.

# ---- Cloud agent worker (deploy/compose.yaml, profile agents; Autonogrammer.AgentWorker) ----
# The worker verifies short-lived control-plane JWTs and serves the ACP WebSocket. No value below is a secret.
# Provider API keys for omp are injected by the control plane as service variables on the worker (never committed here).
# Public verification key (PEM) of the control plane, ES256 or RS256. Multi-line value: quote it, keep the newlines.
# AUTONOGRAMMER_WORKER_JWT_PUBLIC_KEY_PEM=
# Expected token issuer (default ompos-api).
# AUTONOGRAMMER_WORKER_JWT_ISSUER=ompos-api
# Host loopback port published for the worker (default 8088; container port is 8080).
# AUTONOGRAMMER_WORKER_PORT=8088
# Container-level keys the hosted Railway service sets (config keys use '__' in the environment):
# Worker__Auth__PublicKeysPem__0=
# Worker__Auth__Issuer=ompos-api
# Maximum accepted token lifetime; default 00:15:00, maximum 00:15:00.
# Worker__Auth__MaxTokenLifetime=00:15:00
# Optional pin: serve only this session (token subject).
# Worker__SessionId=
# Worker__WorkspaceRoot=/data/work
# Worker__PingInterval=00:00:20
# Worker__Omp__Path=omp
# Worker__Omp__ExtraArguments__0=
# PORT=8080
# Volume mount point and the uid/gid the entrypoint drops to after repairing volume ownership.
# AUTONOGRAMMER_VOLUME_PATH=/data
# AUTONOGRAMMER_RUN_UID=10001
# AUTONOGRAMMER_RUN_GID=10001
# Railway-side control of the container user (https://docs.railway.com/volumes.md). 0 starts the image as root, which the entrypoint needs to repair the root-owned volume before dropping to AUTONOGRAMMER_RUN_UID.
# RAILWAY_RUN_UID=
