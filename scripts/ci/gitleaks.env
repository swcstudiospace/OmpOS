# Single source of truth for the pinned gitleaks CLI (linux x64 release tarball).
# Read by scripts/ci/secret-scan.sh, which both bootstrap.sh and .github/workflows/ci.yml run.
# To bump: change both lines together; the SHA-256 is the digest of
# gitleaks_<version>_linux_x64.tar.gz from the release's gitleaks_<version>_checksums.txt.
GITLEAKS_VERSION=8.30.1
GITLEAKS_SHA256=551f6fc83ea457d62a0d98237cbad105af8d557003051f41f3e7ca7b3f2470eb
