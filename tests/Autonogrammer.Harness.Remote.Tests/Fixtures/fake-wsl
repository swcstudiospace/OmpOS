#!/bin/sh
# A stand-in for wsl.exe, used only by Autonogrammer.Harness.Remote.Tests.
#
# It logs its argument list and understands `--list --quiet` (the distribution names, one per line, written as UTF-16LE-like text with NUL after every
# character, the way wsl.exe writes them) and `-d <distro> [-u <user>] --exec <command...>`. Distributions are directories under $FAKE_WSL_DIR/distros/<name>/
# that hold an optional `users` file and a `home` directory. Environment variables steer it:
#   FAKE_WSL_LOG     file that receives one `CALL` line and one `ARG:<value>` line per argument
#   FAKE_WSL_DIR     the root of the fake distributions
#   FAKE_WSL_BANNER  when non-empty, a banner is printed on stdout before the command runs
#   FAKE_WSL_PATH    the PATH of the "distribution" non-interactive shell
log() {
  if [ -n "$FAKE_WSL_LOG" ]; then
    printf '%s\n' "$1" >> "$FAKE_WSL_LOG"
  fi
}

log "CALL"
for arg in "$@"; do
  log "ARG:$arg"
done

distros="$FAKE_WSL_DIR/distros"

wide() {
  printf '%s\n' "$1" | fold -w1 | while IFS= read -r c; do printf '%s\0' "$c"; done
  printf '\r\0\n\0'
}

if [ "$1" = "--list" ]; then
  for dir in "$distros"/*; do
    if [ -d "$dir" ]; then
      wide "$(basename "$dir")"
    fi
  done
  exit 0
fi

distro=""
user=""
while [ $# -gt 0 ]; do
  case "$1" in
    -d) distro="$2"; shift 2 ;;
    -u) user="$2"; shift 2 ;;
    --exec) shift; break ;;
    *) shift ;;
  esac
done

if [ ! -d "$distros/$distro" ]; then
  printf 'There is no distribution with the supplied name.\n' >&2
  exit 1
fi
if [ -n "$user" ] && [ -f "$distros/$distro/users" ] && ! grep -qx "$user" "$distros/$distro/users"; then
  printf 'There is no user with the supplied name.\n' >&2
  exit 1
fi
if [ -n "$FAKE_WSL_BANNER" ]; then
  printf 'Welcome to the fake distribution\n'
fi
HOME="$distros/$distro/home"
export HOME
if [ -n "$FAKE_WSL_PATH" ]; then
  PATH="$FAKE_WSL_PATH"
  export PATH
fi
# The "guest" has no /usr/local/bin: the developer machine that runs the tests may have a real omp there, which the PATH line of the
# script appends and which must never be found instead of the fixture (or instead of "no omp installed").
if [ $# -ge 3 ] && [ "$1" = "sh" ] && [ "$2" = "-c" ]; then
  script=$(printf '%s' "$3" | sed 's#/usr/local/bin#/nonexistent-autonogrammer-bin#g')
  shift 3
  exec sh -c "$script" "$@"
fi
exec "$@"
