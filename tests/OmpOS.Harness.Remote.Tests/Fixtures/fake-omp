#!/bin/sh
# A stand-in for `omp`, used only by OmpOS.Harness.Remote.Tests. It speaks just enough of ACP over stdio for the transport tests:
# initialize, session/new, session/load, session/prompt (echo), session/close. A prompt that contains DROP makes it exit at once, which
# is what a lost connection looks like to the client. Environment variables steer it:
#   FAKE_OMP_LOG      file that receives what it saw (argument list, working directory, secret length, loaded session ids, ...)
#   FAKE_OMP_SESSION  the session id it hands out (default fake-session-1)
#   FAKE_OMP_VERSION  what `omp --version` prints after `omp/` (default 18.12.6)
#   FAKE_OMP_NOISE    when non-empty, a non-JSON line is printed after the first frame
if [ "$1" = "--version" ]; then
  printf 'omp/%s\n' "${FAKE_OMP_VERSION:-18.12.6}"
  exit 0
fi

log() {
  if [ -n "$FAKE_OMP_LOG" ]; then
    printf '%s\n' "$1" >> "$FAKE_OMP_LOG"
  fi
}

log "ARGV:$*"
log "CWD:$(pwd)"
log "SECRETLEN:${#OMPOS_TEST_SECRET}"
log "STATEDIR:${ULTRATHINK_STATE_DIR:-}"
log "SUBSTRATE_URL:${SUBSTRATE_URL:-}"

previous=""
for argument in "$@"; do
  if [ "$previous" = "--config" ]; then
    log "CONFIG:$argument"
    if [ -f "$argument" ]; then
      log "CONFIGBODY:$(tr '\n' '~' < "$argument")"
      log "CONFIGMODE:$(stat -c '%a' "$argument" 2>/dev/null)"
    fi
  fi
  previous="$argument"
done

sid="${FAKE_OMP_SESSION:-fake-session-1}"
while IFS= read -r line; do
  id=$(printf '%s' "$line" | sed -n 's/.*"id":\([0-9][0-9]*\).*/\1/p')
  method=$(printf '%s' "$line" | sed -n 's/.*"method":"\([^"]*\)".*/\1/p')
  case "$method" in
    initialize)
      printf '{"jsonrpc":"2.0","id":%s,"result":{"protocolVersion":1,"agentInfo":{"name":"omp","title":"omp","version":"18.12.6"},"authMethods":[],"agentCapabilities":{"loadSession":true,"mcpCapabilities":{"http":true,"sse":true},"promptCapabilities":{"embeddedContext":true,"image":true},"sessionCapabilities":{"list":{},"fork":{},"resume":{},"close":{}}}}}\n' "$id"
      if [ -n "$FAKE_OMP_NOISE" ]; then
        printf 'this line is not json\n'
      fi
      ;;
    session/new)
      log "NEW"
      printf '{"jsonrpc":"2.0","id":%s,"result":{"sessionId":"%s"}}\n' "$id" "$sid"
      ;;
    session/load)
      loaded=$(printf '%s' "$line" | sed -n 's/.*"sessionId":"\([^"]*\)".*/\1/p')
      log "LOAD:$loaded"
      sid="$loaded"
      printf '{"jsonrpc":"2.0","id":%s,"result":{}}\n' "$id"
      ;;
    session/prompt)
      text=$(printf '%s' "$line" | sed -n 's/.*"text":"\([^"]*\)".*/\1/p')
      case "$text" in
        *DROP*) log "DROP"; exit 3 ;;
      esac
      printf '{"jsonrpc":"2.0","method":"session/update","params":{"sessionId":"%s","update":{"sessionUpdate":"agent_message_chunk","content":{"type":"text","text":"echo:%s|secretlen=%s"}}}}\n' "$sid" "$text" "${#OMPOS_TEST_SECRET}"
      printf '{"jsonrpc":"2.0","id":%s,"result":{"stopReason":"end_turn"}}\n' "$id"
      ;;
    *)
      if [ -n "$id" ]; then
        printf '{"jsonrpc":"2.0","id":%s,"result":{}}\n' "$id"
      fi
      ;;
  esac
done
