#!/bin/sh
# A stand-in for podman, used only by OmpOS.Harness.Remote.Tests.
#
# It logs its argument list and understands the few commands OmpOS runs: --version, ps (with an optional label filter), container inspect, start and exec.
# "Containers" are directories under $FAKE_PODMAN_DIR/containers/<name>/ that hold `state` (running, exited, ...), an optional `users` file (one user per line),
# and a `home` directory. exec runs the given command locally, with HOME of the container, like a real exec would run it inside. Environment variables (set by the
# per-test wrapper script) steer it:
#   FAKE_PODMAN_LOG      file that receives one `CALL` line and one `ARG:<value>` line per argument
#   FAKE_PODMAN_DIR      the root of the fake containers
#   FAKE_PODMAN_MODE     service-down | hang (anything else: normal)
#   FAKE_PODMAN_BANNER   when non-empty, a login banner is printed on stdout before the command runs
#   FAKE_PODMAN_PATH     the PATH of the "container" non-interactive shell
#   FAKE_PODMAN_START_FAIL  when non-empty, `start` fails
log() {
  if [ -n "$FAKE_PODMAN_LOG" ]; then
    printf '%s\n' "$1" >> "$FAKE_PODMAN_LOG"
  fi
}

log "CALL"
for arg in "$@"; do
  log "ARG:$arg"
done

case "$FAKE_PODMAN_MODE" in
  service-down) printf 'Cannot connect to Podman. Please verify your connection to the Linux system using `podman system connection list`\n' >&2; exit 125 ;;
  hang) sleep 60; exit 0 ;;
esac

containers="$FAKE_PODMAN_DIR/containers"

missing() {
  printf 'Error: no container with name or ID "%s" found: no such container\n' "$1" >&2
  exit 125
}

command="$1"
if [ $# -gt 0 ]; then
  shift
fi

case "$command" in
  --version)
    printf 'podman version 5.0.0 (fake)\n'
    exit 0
    ;;
  ps)
    filtered=0
    while [ $# -gt 0 ]; do
      case "$1" in
        --filter) filtered=1; shift 2 ;;
        --format) shift 2 ;;
        *) shift ;;
      esac
    done
    if [ "$filtered" = 1 ]; then
      if [ -f "$FAKE_PODMAN_DIR/ps-filter.json" ]; then cat "$FAKE_PODMAN_DIR/ps-filter.json"; else printf '[]\n'; fi
    else
      if [ -f "$FAKE_PODMAN_DIR/ps.json" ]; then cat "$FAKE_PODMAN_DIR/ps.json"; else printf '[]\n'; fi
    fi
    exit 0
    ;;
  container)
    shift
    # container inspect --format <template> -- <name>
    name=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --format) shift 2 ;;
        --) shift; name="$1"; break ;;
        *) shift ;;
      esac
    done
    if [ ! -f "$containers/$name/state" ]; then
      printf 'Error: no such container %s\n' "$name" >&2
      exit 125
    fi
    cat "$containers/$name/state"
    exit 0
    ;;
  start)
    name=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --) shift; name="$1"; break ;;
        *) shift ;;
      esac
    done
    if [ -n "$FAKE_PODMAN_START_FAIL" ]; then
      printf 'Error: unable to start container "%s": crun: something went wrong\n' "$name" >&2
      exit 125
    fi
    if [ ! -f "$containers/$name/state" ]; then
      missing "$name"
    fi
    printf 'running\n' > "$containers/$name/state"
    printf '%s\n' "$name"
    exit 0
    ;;
  exec)
    user=""
    while [ $# -gt 0 ]; do
      case "$1" in
        -i|-t|-it) shift ;;
        -u) user="$2"; shift 2 ;;
        -w) shift 2 ;;
        --) shift; break ;;
        *) break ;;
      esac
    done
    name="$1"
    if [ $# -gt 0 ]; then
      shift
    fi
    if [ ! -f "$containers/$name/state" ]; then
      missing "$name"
    fi
    if [ "$(cat "$containers/$name/state")" != "running" ]; then
      printf 'Error: can only create exec sessions on running containers: container state improper\n' >&2
      exit 255
    fi
    if [ -n "$user" ] && [ -f "$containers/$name/users" ] && ! grep -qx "$user" "$containers/$name/users"; then
      printf 'Error: unable to find user %s: no matching entries in passwd file\n' "$user" >&2
      exit 255
    fi
    if [ -n "$FAKE_PODMAN_BANNER" ]; then
      printf 'Welcome to the fake container\n'
      printf 'Last login: Mon Oct 26 10:00:00 2026\n'
    fi
    HOME="$containers/$name/home"
    export HOME
    if [ -n "$FAKE_PODMAN_PATH" ]; then
      PATH="$FAKE_PODMAN_PATH"
      export PATH
    fi
    exec "$@"
    ;;
  *)
    printf 'Error: unknown command %s\n' "$command" >&2
    exit 125
    ;;
esac
