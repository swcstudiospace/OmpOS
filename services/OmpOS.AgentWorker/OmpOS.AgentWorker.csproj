<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- The worker host binds configuration reflectively and ships as a non-trimmed deployment artifact
       (the cloud agent image). Libraries keep IsTrimmable=true. -->
  <PropertyGroup>
    <IsTrimmable>false</IsTrimmable>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>OmpOS.AgentWorker.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/OmpOS.Harness.Abstractions/OmpOS.Harness.Abstractions.csproj" />
    <ProjectReference Include="../../src/OmpOS.Harness.Acp/OmpOS.Harness.Acp.csproj" />
    <ProjectReference Include="../../src/OmpOS.Harness.AgentLoop/OmpOS.Harness.AgentLoop.csproj" />
    <ProjectReference Include="../../src/OmpOS.Harness.Plugins/OmpOS.Harness.Plugins.csproj" />
  </ItemGroup>
</Project>
