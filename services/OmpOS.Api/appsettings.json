{
  "Api": {
    "Cors": {
      "Origins": []
    },
    "MaxPromptLength": 64000,
    "MaxRequestBodyBytes": 1048576,
    "RateLimit": {
      "PromptsPerMinute": 60
    }
  },
  "Cloud": {
    "Enabled": false
  },
  "Coordination": {
    "Store": "InMemory"
  },
  "Harness": {
    "Adapter": "InMemory"
  },
  "Otel": {
    "Exporter": "none"
  },
  "OmpOS": {
    "Debug": {
      "LogPrompts": false
    }
  },
  "Sessions": {
    "Store": "InMemory"
  }
}
