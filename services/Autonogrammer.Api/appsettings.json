{
  "Api": {
    "Cors": {
      "Origins": []
    },
    "MaxPromptLength": 64000,
    "MaxRequestBodyBytes": 1048576,
    "RateLimit": {
      "PromptsPerMinute": 60
    }
  },
  "Automations": {
    "Enabled": false
  },
  "Cloud": {
    "Enabled": false
  },
  "Coordination": {
    "Store": "InMemory"
  },
  "Dispatch": {
    "Enabled": false,
    "Pairing": { "MaxSignInAge": "00:10:00" },
    "Credentials": { "Issuer": "autonogrammer-dispatch", "Lifetime": "30.00:00:00" },
    "MaxPayloadBytes": 65536,
    "QueueTtl": "00:05:00",
    "ClockSkew": "00:00:30",
    "Limits": { "MaxQueuedPerDevice": 100, "DevicesPerAccount": 20, "FeedRetention": "30.00:00:00", "BodyRetention": "7.00:00:00" },
    "RunLimits": { "Task": "04:00:00", "Session": "00:01:00" },
    "CommandApprovalTimeout": "00:05:00",
    "ReplicaMode": "Single"
  },
  "Harness": {
    "Adapter": "InMemory"
  },
  "Otel": {
    "Exporter": "none"
  },
  "Autonogrammer": {
    "Debug": {
      "LogPrompts": false
    }
  },
  "Sessions": {
    "Store": "InMemory"
  }
}
