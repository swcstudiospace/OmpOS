<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- The host wires reflection-based framework services (config binding, validation,
       minimal APIs, health checks) that trim analysis cannot prove safe, and it ships
       as a non-trimmed deployment artifact. Libraries keep IsTrimmable=true. -->
  <PropertyGroup>
    <IsTrimmable>false</IsTrimmable>
    <OpenApiGenerateDocumentsOnBuild>true</OpenApiGenerateDocumentsOnBuild>
    <OpenApiDocumentsDirectory>$(MSBuildThisFileDirectory)../../docs/api</OpenApiDocumentsDirectory>
    <OpenApiGenerateDocumentsOptions>--file-name openapi --openapi-version OpenApi3_1</OpenApiGenerateDocumentsOptions>
  </PropertyGroup>

  <!-- The build-time OpenAPI generator shells out to bare `dotnet`, which may resolve
       to an older system SDK. Prepend the running SDK's directory to the process PATH
       so `dotnet build` succeeds with no environment variables set. -->
  <UsingTask TaskName="PrependHostDirToPath" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <Task>
      <Code Type="Fragment" Language="cs"><![CDATA[
        var hostPath = System.Environment.GetEnvironmentVariable("DOTNET_HOST_PATH");
        if (!string.IsNullOrEmpty(hostPath))
        {
          var dir = System.IO.Path.GetDirectoryName(hostPath);
          var current = System.Environment.GetEnvironmentVariable("PATH") ?? string.Empty;
          if (!string.IsNullOrEmpty(dir) && !current.StartsWith(dir + System.IO.Path.PathSeparator, System.StringComparison.Ordinal))
          {
            System.Environment.SetEnvironmentVariable("PATH", dir + System.IO.Path.PathSeparator + current);
          }
        }
      ]]></Code>
    </Task>
  </UsingTask>
  <Target Name="EnsureDotnetOnPathForOpenApi" BeforeTargets="GenerateOpenApiDocuments">
    <PrependHostDirToPath />
  </Target>
  <UsingTask TaskName="SetDesignTimeEnvironmentForOpenApi" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <Task>
      <Code Type="Fragment" Language="cs"><![CDATA[
        // The generator runs the API host to read its OpenAPI document. Production refuses startup without
        // the sign-in authority and the ACP harness (OD-03, Q-HARN-PERMISSION), which a build must not need.
        // The generator runs in Development unless the caller already chose an environment; the running API
        // is unaffected, because this only sets the environment of the build-time process.
        if (string.IsNullOrEmpty(System.Environment.GetEnvironmentVariable("ASPNETCORE_ENVIRONMENT"))
            && string.IsNullOrEmpty(System.Environment.GetEnvironmentVariable("DOTNET_ENVIRONMENT")))
        {
          System.Environment.SetEnvironmentVariable("ASPNETCORE_ENVIRONMENT", "Development");
        }
      ]]></Code>
    </Task>
  </UsingTask>
  <Target Name="EnsureDevelopmentEnvironmentForOpenApi" BeforeTargets="GenerateOpenApiDocuments">
    <SetDesignTimeEnvironmentForOpenApi />
  </Target>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Autonogrammer.Api.IntegrationTests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
